def classificar_tipo_mudanca(campo):

    mapa = {

        'ENG_OBJ_MACRO':
            'PROJETO_ALTERADO',

        'MASTEROBRA_OBJ_ENG':
            'PROJETO_ALTERADO',

        'PMO_PROJETO':
            'PROJETO_ALTERADO',

        'PMO_REFERENCIA_REPORT':
            'PROJETO_ALTERADO',

        'REGIONAL_BASELINE_ATIVACAO':
            'BASELINE_REGIONAL_ALTERADA',

        'PMO_CARIMBO_BASELINE':
            'CARIMBO_BASELINE_ALTERADO',

        'PMO_CARIMBO_CENTRALIZADO':
            'CARIMBO_CENTRALIZADO_ALTERADO',

        'PMO_ESCOPO_META':
            'ESCOPO_META_ALTERADO',

        'PMO_ROLLOUT_OVBK':
            'ROLLOUT_OVBK_ALTERADO',
    }

    return mapa.get(
        campo,
        'CAMPO_ALTERADO'
    )


# ============================================================
# 6. IDENTIFICAR NOVAS E REMOVIDAS
# ============================================================

def identificar_novas_e_removidas(
    anterior,
    atual
):

    ids_anteriores = set(
        anterior['UID_IDPMTS']
        .dropna()
        .unique()
    )

    ids_atuais = set(
        atual['UID_IDPMTS']
        .dropna()
        .unique()
    )

    ids_novos = (
        ids_atuais
        -
        ids_anteriores
    )

    ids_removidos = (
        ids_anteriores
        -
        ids_atuais
    )

    obras_novas = atual[
        atual['UID_IDPMTS']
        .isin(ids_novos)
    ].copy()

    obras_removidas = anterior[
        anterior['UID_IDPMTS']
        .isin(ids_removidos)
    ].copy()

    obras_novas[
        'TIPO_REGISTRO'
    ] = 'NOVA_OBRA'

    obras_removidas[
        'TIPO_REGISTRO'
    ] = 'OBRA_REMOVIDA'

    return (
        obras_novas,
        obras_removidas,
        ids_novos,
        ids_removidos
    )


# ============================================================
# 7. JUNTAR REGISTROS EXISTENTES NOS DOIS DIAS
# ============================================================

def juntar_snapshots(
    anterior,
    atual
):

    colunas_necessarias = list(
        dict.fromkeys(
            COLUNAS_CONTEXTO
        )
    )

    colunas_anteriores = [
        coluna
        for coluna in colunas_necessarias
        if coluna in anterior.columns
    ]

    colunas_atuais = [
        coluna
        for coluna in colunas_necessarias
        if coluna in atual.columns
    ]

    base_anterior = anterior[
        colunas_anteriores
    ].copy()

    base_atual = atual[
        colunas_atuais
    ].copy()

    comparacao = base_anterior.merge(
        base_atual,
        on='UID_IDPMTS',
        how='inner',
        suffixes=(
            '_ANTERIOR',
            '_ATUAL'
        ),
        validate='one_to_one'
    )

    return comparacao


# ============================================================
# 8. CRIAR CHANGELOG POR CAMPO ALTERADO
# ============================================================

def criar_changelog_alteracoes(
    comparacao,
    data_anterior,
    data_atual
):

    alteracoes = []

    for campo in COLUNAS_MONITORADAS:

        coluna_anterior = (
            f'{campo}_ANTERIOR'
        )

        coluna_atual = (
            f'{campo}_ATUAL'
        )

        if (
            coluna_anterior
            not in comparacao.columns
            or
            coluna_atual
            not in comparacao.columns
        ):

            print(
                f'ATENÇÃO: campo {campo} '
                f'não encontrado nos dois snapshots.'
            )

            continue

        mascara = valores_diferentes(
            comparacao[coluna_anterior],
            comparacao[coluna_atual]
        )

        linhas_alteradas = comparacao[
            mascara
        ].copy()

        for _, linha in linhas_alteradas.iterrows():

            alteracoes.append({

                'DATA_SNAPSHOT_ANTERIOR':
                    data_anterior,

                'DATA_SNAPSHOT_ATUAL':
                    data_atual,

                'DATA_DETECCAO':
                    pd.Timestamp.now(),

                'TIPO_REGISTRO':
                    'ALTERADO',

                'TIPO_MUDANCA':
                    classificar_tipo_mudanca(
                        campo
                    ),

                'CAMPO_ALTERADO':
                    campo,

                'VALOR_ANTERIOR':
                    formatar_valor_saida(
                        linha[coluna_anterior]
                    ),

                'VALOR_ATUAL':
                    formatar_valor_saida(
                        linha[coluna_atual]
                    ),

                'UID_IDPMTS':
                    linha['UID_IDPMTS'],

                'UID_IDENG':
                    linha.get(
                        'UID_IDENG_ATUAL'
                    ),

                'UID_UFSIGLA':
                    linha.get(
                        'UID_UFSIGLA_ATUAL'
                    ),

                'PMO_REGIONAL':
                    linha.get(
                        'PMO_REGIONAL_ATUAL'
                    ),

                'PMO_UF':
                    linha.get(
                        'PMO_UF_ATUAL'
                    ),

                'COMPETENCIA_ANTERIOR':
                    linha.get(
                        'COMPETENCIA_ANTERIOR'
                    ),

                'COMPETENCIA_ATUAL':
                    linha.get(
                        'COMPETENCIA_ATUAL'
                    ),

                'FLAG_SN_ANTERIOR':
                    linha.get(
                        'FLAG_SN_ANTERIOR'
                    ),

                'FLAG_SN_ATUAL':
                    linha.get(
                        'FLAG_SN_ATUAL'
                    ),

                'FLAG_AMPLIACAO_FISICA_ANTERIOR':
                    linha.get(
                        'FLAG_AMPLIACAO_FISICA_ANTERIOR'
                    ),

                'FLAG_AMPLIACAO_FISICA_ATUAL':
                    linha.get(
                        'FLAG_AMPLIACAO_FISICA_ATUAL'
                    ),

                'FLAG_AMPLIACAO_LOGICA_ANTERIOR':
                    linha.get(
                        'FLAG_AMPLIACAO_LOGICA_ANTERIOR'
                    ),

                'FLAG_AMPLIACAO_LOGICA_ATUAL':
                    linha.get(
                        'FLAG_AMPLIACAO_LOGICA_ATUAL'
                    ),
            })

    return pd.DataFrame(
        alteracoes
