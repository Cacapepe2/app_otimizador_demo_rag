# ============================================================
# 12. RESUMO DA COMPARAÇÃO
# ============================================================

def criar_resumo_comparacao(
    anterior,
    atual,
    obras_novas,
    obras_removidas,
    changelog,
    impacto
):

    alterados = changelog[
        changelog['TIPO_REGISTRO']
        .eq('ALTERADO')
    ]

    dados = [
        {
            'METRICA':
                'Snapshot anterior',

            'VALOR':
                anterior[
                    'DATA_SNAPSHOT'
                ].iloc[0]
        },

        {
            'METRICA':
                'Snapshot atual',

            'VALOR':
                atual[
                    'DATA_SNAPSHOT'
                ].iloc[0]
        },

        {
            'METRICA':
                'Obras no snapshot anterior',

            'VALOR':
                anterior[
                    'UID_IDPMTS'
                ].nunique()
        },

        {
            'METRICA':
                'Obras no snapshot atual',

            'VALOR':
                atual[
                    'UID_IDPMTS'
                ].nunique()
        },

        {
            'METRICA':
                'Novas obras',

            'VALOR':
                obras_novas[
                    'UID_IDPMTS'
                ].nunique()
        },

        {
            'METRICA':
                'Obras removidas',

            'VALOR':
                obras_removidas[
                    'UID_IDPMTS'
                ].nunique()
        },

        {
            'METRICA':
                'Obras com campo alterado',

            'VALOR':
                alterados[
                    'UID_IDPMTS'
                ].nunique()
        },

        {
            'METRICA':
                'Total de campos alterados',

            'VALOR':
                len(alterados)
        },

        {
            'METRICA':
                'Obras com mudança de competência',

            'VALOR':
                impacto.loc[
                    impacto[
                        'MUDOU_COMPETENCIA'
                    ].eq(True),
                    'UID_IDPMTS'
                ].nunique()
                if not impacto.empty
                else 0
        },

        {
            'METRICA':
                'Obras que mudaram projeto',

            'VALOR':
                impacto.loc[
                    impacto[
                        'MUDOU_PROJETO'
                    ].eq(True),
                    'UID_IDPMTS'
                ].nunique()
                if not impacto.empty
                else 0
        },

        {
            'METRICA':
                'Obras que saíram de SN',

            'VALOR':
                impacto.loc[
                    impacto[
                        'IMPACTO_SN'
                    ].eq('SAIU_SN'),
                    'UID_IDPMTS'
                ].nunique()
                if not impacto.empty
                else 0
        },

        {
            'METRICA':
                'Obras que entraram em SN',

            'VALOR':
                impacto.loc[
                    impacto[
                        'IMPACTO_SN'
                    ].eq('ENTROU_SN'),
                    'UID_IDPMTS'
                ].nunique()
                if not impacto.empty
                else 0
        },
    ]

    return pd.DataFrame(
        dados
    )


# ============================================================
# 13. VERIFICAR SE A COMPARAÇÃO JÁ FOI SALVA
# ============================================================

def comparacao_ja_processada(
    data_atual
):

    try:

        historico_changelog = c.read_sql(
            DATABASE_HISTORICO,
            TABELA_CHANGELOG,
            BANCO_HISTORICO,
            colunas='DATA_SNAPSHOT_ATUAL'
        )

        if historico_changelog.empty:
            return False

        historico_changelog[
            'DATA_SNAPSHOT_ATUAL'
        ] = pd.to_datetime(
            historico_changelog[
                'DATA_SNAPSHOT_ATUAL'
            ],
            errors='coerce'
        )

        return (
            historico_changelog[
                'DATA_SNAPSHOT_ATUAL'
            ]
            .dt.normalize()
            .eq(
                pd.Timestamp(
                    data_atual
                ).normalize()
            )
            .any()
        )

    except Exception:

        # Tabela ainda não existe.
        return False


# ============================================================
# 14. SALVAR RESULTADOS NO BANCO
# ============================================================

def salvar_resultados_banco(
    changelog,
    impacto,
    data_atual,
    force=False
):

    if (
        comparacao_ja_processada(
            data_atual
        )
        and
        not force
    ):

        print(
            '\nATENÇÃO: essa comparação '
            'já foi processada.'
        )

        print(
            'Nada foi adicionado novamente.'
        )

        return False

    if not changelog.empty:

        c.to_sql(
            changelog,
            DATABASE_HISTORICO,
            TABELA_CHANGELOG,
            BANCO_HISTORICO,
            normalize=True,
            existente='append'
        )

        print(
            'Changelog salvo no banco.'
        )

    if not impacto.empty:

        c.to_sql(
            impacto,
            DATABASE_HISTORICO,
            TABELA_IMPACTO,
            BANCO_HISTORICO,
            normalize=True,
            existente='append'
        )

        print(
            'Tabela de impacto salva no banco.'
        )

    return True


