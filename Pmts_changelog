# ============================================================
# 2. TRATAMENTO DO HISTÓRICO
# ============================================================

def tratar_historico(historico):

    df = historico.copy()

    # --------------------------------------------------------
    # Datas
    # --------------------------------------------------------

    colunas_data = [
        'DATA_SNAPSHOT',
        'DATA_HORA_CARGA',
        *COLUNAS_DATA_MONITORADAS
    ]

    for coluna in colunas_data:

        if coluna in df.columns:

            df[coluna] = pd.to_datetime(
                df[coluna],
                errors='coerce'
            )

    # A comparação diária usa somente a data.
    df['DATA_SNAPSHOT'] = (
        df['DATA_SNAPSHOT']
        .dt.normalize()
    )

    # --------------------------------------------------------
    # Chaves
    # --------------------------------------------------------

    for coluna in [
        'UID_IDPMTS',
        'UID_IDENG',
        'UID_UFSIGLA'
    ]:

        if coluna in df.columns:

            df[coluna] = (
                df[coluna]
                .astype('string')
                .str.strip()
                .str.upper()
            )

    # --------------------------------------------------------
    # Booleanos
    # --------------------------------------------------------

    for coluna in COLUNAS_FLAG_MONITORADAS:

        if coluna in df.columns:

            df[coluna] = normalizar_booleano(
                df[coluna]
            )

    return df


def normalizar_booleano(serie):

    """
    Trata booleanos que podem ter sido gravados no MySQL
    como True/False, 1/0 ou texto.
    """

    mapa = {
        True: True,
        False: False,

        1: True,
        0: False,

        '1': True,
        '0': False,

        'TRUE': True,
        'FALSE': False,

        'T': True,
        'F': False,

        'SIM': True,
        'NÃO': False,
        'NAO': False,

        'S': True,
        'N': False,
    }

    resultado = (
        serie
        .astype('string')
        .str.strip()
        .str.upper()
        .map(mapa)
    )

    return resultado.fillna(False)


# ============================================================
# 3. SELECIONAR OS DOIS SNAPSHOTS MAIS RECENTES
# ============================================================

def selecionar_dois_ultimos_snapshots(historico):

    datas_disponiveis = (
        historico['DATA_SNAPSHOT']
        .dropna()
        .drop_duplicates()
        .sort_values()
        .tolist()
    )

    if len(datas_disponiveis) < 2:

        raise ValueError(
            'São necessários pelo menos dois snapshots '
            'diferentes para realizar a comparação.'
        )

    data_anterior = datas_disponiveis[-2]
    data_atual = datas_disponiveis[-1]

    anterior = historico[
        historico['DATA_SNAPSHOT'].eq(
            data_anterior
        )
    ].copy()

    atual = historico[
        historico['DATA_SNAPSHOT'].eq(
            data_atual
        )
    ].copy()

    print(
        '\nSnapshot anterior:',
        data_anterior.strftime('%d/%m/%Y')
    )

    print(
        'Snapshot atual:',
        data_atual.strftime('%d/%m/%Y')
    )

    print(
        'Linhas no anterior:',
        f'{len(anterior):,}'
    )

    print(
        'Linhas no atual:',
        f'{len(atual):,}'
    )

    validar_chave_snapshot(
        anterior,
        'ANTERIOR'
    )

    validar_chave_snapshot(
        atual,
        'ATUAL'
    )

    return (
        anterior,
        atual,
        data_anterior,
        data_atual
    )


def validar_chave_snapshot(df, nome_snapshot):

    duplicados = df[
        df['UID_IDPMTS']
        .duplicated(keep=False)
    ]

    if not duplicados.empty:

        exemplos = (
            duplicados['UID_IDPMTS']
            .dropna()
            .drop_duplicates()
            .head(10)
            .tolist()
        )

        raise ValueError(
            f'Existem UID_IDPMTS duplicados no snapshot '
            f'{nome_snapshot}. Exemplos: {exemplos}'
        )


# ============================================================
# 4. COMPARAÇÃO SEGURA DE VALORES
# ============================================================

def valores_diferentes(
    serie_anterior,
    serie_atual
):

    """
    Regras:
    vazio x vazio = não mudou
    vazio x valor = mudou
    valor x vazio = mudou
    valor A x valor B = mudou se A != B
    """

    anterior_vazio = serie_anterior.isna()
    atual_vazio = serie_atual.isna()

    ambos_vazios = (
        anterior_vazio
        &
        atual_vazio
    )

    comparacao = (
        serie_anterior.ne(
            serie_atual
        )
        &
        ~ambos_vazios
    )

    return comparacao


def formatar_valor_saida(valor):

    if pd.isna(valor):
        return None

    if isinstance(
        valor,
        (pd.Timestamp, datetime)
    ):
        return valor.strftime(
            '%Y-%m-%d'
        )

    return str(valor)


