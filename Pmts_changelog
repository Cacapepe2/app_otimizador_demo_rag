def exportar_excel_comparacao(
    resumo,
    changelog,
    impacto,
    obras_novas,
    obras_removidas,
    data_atual
):

    data_texto = pd.Timestamp(
        data_atual
    ).strftime('%Y%m%d')

    arquivo = (
        PASTA_SAIDA_COMPARACAO
        /
        f'comparacao_pmts_{data_texto}.xlsx'
    )

    mudancas_competencia = (
        impacto[
            impacto[
                'MUDOU_COMPETENCIA'
            ].eq(True)
        ].copy()
        if not impacto.empty
        else pd.DataFrame()
    )

    mudancas_projeto = (
        impacto[
            impacto[
                'MUDOU_PROJETO'
            ].eq(True)
        ].copy()
        if not impacto.empty
        else pd.DataFrame()
    )

    mudancas_escopo = changelog[
        changelog[
            'CAMPO_ALTERADO'
        ].isin([
            'PMO_ESCOPO_META',
            'PMO_ROLLOUT_OVBK'
        ])
    ].copy()

    with pd.ExcelWriter(
        arquivo,
        engine='openpyxl',
        datetime_format='dd/mm/yyyy'
    ) as writer:

        resumo.to_excel(
            writer,
            sheet_name='Resumo',
            index=False
        )

        changelog.to_excel(
            writer,
            sheet_name='Changelog',
            index=False
        )

        impacto.to_excel(
            writer,
            sheet_name='Impacto',
            index=False
        )

        obras_novas.to_excel(
            writer,
            sheet_name='Novas Obras',
            index=False
        )

        obras_removidas.to_excel(
            writer,
            sheet_name='Obras Removidas',
            index=False
        )

        mudancas_competencia.to_excel(
            writer,
            sheet_name='Mudança Competência',
            index=False
        )

        mudancas_projeto.to_excel(
            writer,
            sheet_name='Mudança Projeto',
            index=False
        )

        mudancas_escopo.to_excel(
            writer,
            sheet_name='Escopo e Rollout',
            index=False
        )

    print(
        f'\nExcel criado: {arquivo}'
    )


