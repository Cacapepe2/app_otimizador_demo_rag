# 10. AUXILIARES DE IMPACTO
# ============================================================

def interpretar_transicao_flag(
    valor_anterior,
    valor_atual,
    indicador
):

    anterior = bool(
        valor_anterior
    )

    atual = bool(
        valor_atual
    )

    if not anterior and atual:
        return f'ENTROU_{indicador}'

    if anterior and not atual:
        return f'SAIU_{indicador}'

    if anterior and atual:
        return f'PERMANECEU_{indicador}'

    return f'FORA_{indicador}'


def interpretar_rollout(
    valor_anterior,
    valor_atual
):

    anterior = (
        str(valor_anterior)
        .strip()
        .upper()
        if pd.notna(valor_anterior)
        else None
    )

    atual = (
        str(valor_atual)
        .strip()
        .upper()
        if pd.notna(valor_atual)
        else None
    )

    if (
        anterior == 'ORCAMENTO'
        and
        atual != 'ORCAMENTO'
    ):
        return 'SAIU_DO_ESCOPO_ORCAMENTO'

    if (
        anterior != 'ORCAMENTO'
        and
        atual == 'ORCAMENTO'
    ):
        return 'ENTROU_NO_ESCOPO_ORCAMENTO'

    return None


def interpretar_escopo_meta(
    valor_anterior,
    valor_atual
):

    anterior = (
        str(valor_anterior)
        .strip()
        .upper()
        if pd.notna(valor_anterior)
        else None
    )

    atual = (
        str(valor_atual)
        .strip()
        .upper()
        if pd.notna(valor_atual)
        else None
    )

    if (
        anterior == 'FÍSICA'
        and
        atual != 'FÍSICA'
    ):
        return 'SAIU_DO_ESCOPO_FISICA'

    if (
        anterior != 'FÍSICA'
        and
        atual == 'FÍSICA'
    ):
        return 'ENTROU_NO_ESCOPO_FISICA'

    if (
        anterior == 'LÓGICA'
        and
        atual != 'LÓGICA'
    ):
        return 'SAIU_DO_ESCOPO_LOGICA'

    if (
        anterior != 'LÓGICA'
        and
        atual == 'LÓGICA'
    ):
        return 'ENTROU_NO_ESCOPO_LOGICA'

    return None


