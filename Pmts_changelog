def criar_tabela_impacto(
    comparacao,
    changelog_alteracoes,
    data_anterior,
    data_atual
):

    if changelog_alteracoes.empty:

        return pd.DataFrame()

    ids_alterados = (
        changelog_alteracoes[
            'UID_IDPMTS'
        ]
        .dropna()
        .unique()
    )

    base = comparacao[
        comparacao['UID_IDPMTS']
        .isin(ids_alterados)
    ].copy()

    resultados = []

    for _, linha in base.iterrows():

        idpmts = linha[
            'UID_IDPMTS'
        ]

        alteracoes_obra = changelog_alteracoes[
            changelog_alteracoes[
                'UID_IDPMTS'
            ].eq(idpmts)
        ]

        campos_alterados = (
            alteracoes_obra[
                'CAMPO_ALTERADO'
            ]
            .dropna()
            .tolist()
        )

        projetos_alterados = [
            campo
            for campo in campos_alterados
            if campo
            in COLUNAS_PROJETO_MONITORADAS
        ]

