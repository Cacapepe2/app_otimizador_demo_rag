def classificar_intervencao(valor):

    if pd.isna(valor):
        return "SEM INFORMACAO"

    texto = str(valor).upper().strip()

    if "AMPL" in texto:
        return "AMPLIACAO"

    if texto == "SN" or "SITE NOVO" in texto:
        return "SN"

    return texto


