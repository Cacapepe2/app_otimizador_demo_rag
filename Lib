# ============================================================
# 16. FUNÇÃO PARA IDENTIFICAR PADRÕES
# ============================================================

def analisar_padrao(
    df_grupo,
    df_total,
    coluna,
    nome_grupo
):

    if coluna not in df_grupo.columns:
        return pd.DataFrame()


    grupo = df_grupo.copy()
    total = df_total.copy()


    grupo[coluna] = (
        grupo[coluna]
        .fillna("SEM INFORMACAO")
        .astype(str)
        .str.strip()
    )


    total[coluna] = (
        total[coluna]
        .fillna("SEM INFORMACAO")
        .astype(str)
        .str.strip()
    )


    n_grupo = grupo[COL_ID].nunique()
    n_total = total[COL_ID].nunique()


    if n_grupo == 0:
        return pd.DataFrame()


    cont_grupo = (
        grupo
        .groupby(coluna)[COL_ID]
        .nunique()
        .reset_index(
            name="OBRAS_GRUPO"
        )
    )


    cont_total = (
        total
        .groupby(coluna)[COL_ID]
        .nunique()
        .reset_index(
            name="OBRAS_BASE"
        )
    )


    resultado = cont_grupo.merge(
        cont_total,
        on=coluna,
        how="left"
    )


    resultado["PCT_GRUPO"] = (
        resultado["OBRAS_GRUPO"]
        /
        n_grupo
        *
        100
    ).round(2)


    resultado["PCT_BASE"] = (
        resultado["OBRAS_BASE"]
        /
        n_total
        *
        100
    ).round(2)


    resultado["DIFERENCA_PP"] = (
        resultado["PCT_GRUPO"]
        -
        resultado["PCT_BASE"]
    ).round(2)


    resultado["LIFT"] = np.where(
        resultado["PCT_BASE"] > 0,

        resultado["PCT_GRUPO"]
        /
        resultado["PCT_BASE"],

        np.nan
    )


    resultado["LIFT"] = (
        resultado["LIFT"]
        .round(2)
    )


    resultado["PADRAO_90"] = np.where(

        (
            resultado["PCT_GRUPO"]
            >= LIMITE_PADRAO_FORTE
        )
        &
        (
            resultado["OBRAS_GRUPO"]
            >= MIN_OBRAS_PADRAO
        ),

        "SIM",

        "NAO"
    )


    resultado.insert(
        0,
        "GRUPO",
        nome_grupo
    )


    resultado.insert(
        1,
        "VARIAVEL",
        coluna
    )


    resultado = resultado.rename(
        columns={
            coluna: "CATEGORIA"
        }
    )


    return (
        resultado
        .sort_values(
            [
                "PCT_GRUPO",
                "OBRAS_GRUPO"
            ],
            ascending=[
                False,
                False
            ]
        )
        .reset_index(drop=True)
    )


