# ============================================================
# 28. FORMATAR EXCEL
# ============================================================

from openpyxl import load_workbook


wb = load_workbook(
    ARQUIVO_EXCEL
)


for ws in wb.worksheets:

    ws.freeze_panes = "A2"

    ws.auto_filter.ref = (
        ws.dimensions
    )


    for coluna in ws.columns:

        letra = coluna[0].column_letter

        maior = 0


        # Só analisa primeiras 300 linhas
        # para não ficar muito lento
        for celula in coluna[:300]:

            if celula.value is not None:

                tamanho = len(
                    str(celula.value)
                )

                maior = max(
                    maior,
                    tamanho
                )


        ws.column_dimensions[
            letra
        ].width = min(
            maior + 2,
            45
        )


wb.save(
    ARQUIVO_EXCEL
)


