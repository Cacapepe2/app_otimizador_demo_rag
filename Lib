# ============================================================
# 19. MAIORES DIFERENÇAS CONTRA A POPULAÇÃO
# ============================================================
#
# Isso é importante porque nem todo padrão interessante
# necessariamente chega a 90%.
#
# Exemplo:
#
# 5G:
# população total = 30%
# >105 dias       = 70%
#
# diferença = +40 pontos percentuais
# ============================================================

def top_diferencas(resultado):

    if resultado.empty:
        return pd.DataFrame()


    temp = resultado[
        resultado["OBRAS_GRUPO"]
        >= MIN_OBRAS_PADRAO
    ].copy()


    temp["DIF_ABS"] = (
        temp["DIFERENCA_PP"]
        .abs()
    )


    temp = (
        temp
        .sort_values(
            "DIF_ABS",
            ascending=False
        )
        .drop(
            columns=["DIF_ABS"]
        )
        .reset_index(drop=True)
    )


    return temp


top_rapidas = top_diferencas(
