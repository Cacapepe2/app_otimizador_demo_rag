def consolidar_escopo(valor):

    if pd.isna(valor):
        return "OUTROS"

    texto = str(valor).strip().upper()

    # retirar diferenças de acento
    if texto in ["FÍSICA", "FISICA"]:
        return "FÍSICA"

    if texto in ["LÓGICA", "LOGICA"]:
        return "LÓGICA"

    if "REMANEJ" in texto:
        return "REMANEJAMENTO"

    # OUTROS_AEV
    # OUTROS_GAB-CONS
    # OUTROS_GERAL
    # etc.
    if "OUTRO" in texto:
        return "OUTROS"

    # qualquer categoria residual
    return "OUTROS"


