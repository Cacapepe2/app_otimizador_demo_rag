        ">105 DIAS"
    )


    if not resultado_rapida.empty:
        resultados_rapidas.append(
            resultado_rapida
        )


    if not resultado_longa.empty:
        resultados_longas.append(
            resultado_longa
        )


analise_rapidas = (
    pd.concat(
        resultados_rapidas,
        ignore_index=True
    )
    if resultados_rapidas
    else pd.DataFrame()
)


analise_longas = (
    pd.concat(
        resultados_longas,
        ignore_index=True
    )
    if resultados_longas
    else pd.DataFrame()
)


# ============================================================
# 23. ORDENAR SINAIS POR DIFERENÇA
# ============================================================

def ordenar_resultados(resultado):

    if resultado.empty:
        return resultado


    temp = resultado[
        resultado["OBRAS_GRUPO"]
        >= MIN_OBRAS_PADRAO
    ].copy()


    temp["ABS_DIF"] = (
        temp["DIFERENCA_PP"]
        .abs()
    )


    temp = (
        temp
        .sort_values(
            "ABS_DIF",
            ascending=False
        )
        .drop(
            columns="ABS_DIF"
        )
        .reset_index(drop=True)
    )


    return temp


top_rapidas = ordenar_resultados(
    analise_rapidas
)


top_longas = ordenar_resultados(
    analise_longas
)


