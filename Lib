# ============================================================

def analisar_combinacao(
    df_grupo,
    df_total,
    colunas,
    nome_grupo
):

    if not all(
        col in df_total.columns
        for col in colunas
    ):
        return pd.DataFrame()


    grupo = df_grupo.copy()
    total = df_total.copy()


    for col in colunas:

        grupo[col] = (
            grupo[col]
            .fillna("SEM INFORMACAO")
            .astype(str)
            .str.strip()
        )


        total[col] = (
            total[col]
            .fillna("SEM INFORMACAO")
            .astype(str)
            .str.strip()
        )


    grupo["COMBINACAO"] = (
        grupo[colunas]
        .agg(" | ".join, axis=1)
    )


    total["COMBINACAO"] = (
        total[colunas]
        .agg(" | ".join, axis=1)
    )


    resultado = analisar_padrao(
        grupo,
        total,
        "COMBINACAO",
        nome_grupo
    )


    if not resultado.empty:

        resultado["VARIAVEL"] = (
            " + ".join(colunas)
        )


    return resultado


