# ============================================================
# 14. CLASSIFICAÇÃO DESCRITIVA DO SINAL
# ============================================================
#
# IMPORTANTE:
#
# Isso NÃO significa causalidade.
#
# Serve para destacar:
# - concentração absoluta
# - sobre-representação
# - sub-representação
#
# ============================================================

def classificar_sinal(row):

    pct = row["PCT_GRUPO"]
    dif = row["DIFERENCA_PP"]
    lift = row["LIFT"]
    n = row["OBRAS_GRUPO"]


    if n < MIN_OBRAS_PADRAO:
        return "AMOSTRA PEQUENA"


    # 90% ou mais do grupo
    if pct >= 90:
        return "CONCENTRACAO >=90%"


    # Muito acima da incidência normal
    if (
        dif >= 15
        or
        (
            lift >= 2
            and pct >= 10
        )
    ):
        return "SOBRE-REPRESENTADO FORTE"


    if (
        dif >= 7
        or
        (
            lift >= 1.5
            and pct >= 5
        )
    ):
        return "SOBRE-REPRESENTADO"


    if dif <= -10:
        return "SUB-REPRESENTADO FORTE"


    if dif <= -7:
        return "SUB-REPRESENTADO"


    return "SEM DESVIO FORTE"


# ============================================================
# 15. FUNÇÃO DE ANÁLISE
