def classificar_5g(valor):

    if pd.isna(valor):
        return "SEM INFORMACAO"

    texto = str(valor).upper()

    if "5G" in texto:
        return "TEM 5G"

    return "NAO TEM 5G"


def classificar_intervencao(valor):

    if pd.isna(valor):
        return "SEM INFORMACAO"

    texto = str(valor).upper().strip()

    if "AMPL" in texto:
        return "AMPLIACAO"

    if "SN" in texto:
        return "SN"

    return texto


