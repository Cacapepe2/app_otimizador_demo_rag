        return "TEM 5G"

    return "NAO TEM 5G"


def tipo_intervencao(valor):

    if pd.isna(valor):
        return "SEM INFORMACAO"

    texto = str(valor).upper().strip()

    if "AMPL" in texto:
        return "AMPLIACAO"

    if "SN" in texto:
