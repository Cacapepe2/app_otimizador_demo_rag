def criar_faixa(dias):

    if pd.isna(dias):
        return np.nan

    dias = int(dias)

    if dias > 105:
        return ">105"

    if dias <= 5:
        return "0-5"

    inicio = ((dias - 1) // 5) * 5 + 1
    fim = inicio + 4

    return f"{inicio}-{fim}"


