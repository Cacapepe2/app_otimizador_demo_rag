# ============================================================
# 1. NORMALIZAR BOOLEANOS
# ============================================================

def normalizar_booleano(serie):

    """
    Trata booleanos que podem ter sido gravados no banco como:
    True/False, 1/0, T/F, S/N, SIM/NÃO ou texto.
    """

    texto = (
        serie
        .astype('string')
        .str.strip()
        .str.upper()
    )

    mapa = {
        'TRUE': True,
        'FALSE': False,

        '1': True,
        '0': False,

        'T': True,
        'F': False,

        'SIM': True,
        'NÃO': False,
        'NAO': False,

        'S': True,
        'N': False,
    }

    return (
        texto
        .map(mapa)
        .fillna(False)
        .astype(bool)
    )


