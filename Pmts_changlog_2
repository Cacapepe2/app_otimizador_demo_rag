# ============================================================
# 15. INTERPRETAR TRANSIÇÃO DE FLAG
# ============================================================

def interpretar_transicao_flag(
    valor_anterior,
    valor_atual,
    indicador
):

    anterior = bool(
        valor_anterior
    )

    atual = bool(
        valor_atual
    )

    if (
        not anterior
        and
        atual
    ):

        return (
            f'ENTROU_{indicador}'
        )

    if (
        anterior
        and
        not atual
    ):

        return (
            f'SAIU_{indicador}'
        )

    if (
        anterior
        and
        atual
    ):

        return (
            f'PERMANECEU_{indicador}'
        )

    return (
        f'FORA_{indicador}'
    )


# ============================================================
# 16. INTERPRETAR ROLLOUT
# ============================================================

def interpretar_rollout(
    valor_anterior,
    valor_atual
):

    anterior = (
        str(valor_anterior)
        .strip()
        .upper()
        if pd.notna(valor_anterior)
        else None
    )

    atual = (
        str(valor_atual)
        .strip()
        .upper()
        if pd.notna(valor_atual)
        else None
    )

    if (
        anterior == 'ORCAMENTO'
        and
        atual != 'ORCAMENTO'
    ):

        return (
            'SAIU_DO_ESCOPO_ORCAMENTO'
        )

    if (
        anterior != 'ORCAMENTO'
        and
        atual == 'ORCAMENTO'
    ):

        return (
            'ENTROU_NO_ESCOPO_ORCAMENTO'
        )

    return None


# ============================================================
# 17. INTERPRETAR ESCOPO META
# ============================================================

def interpretar_escopo_meta(
    valor_anterior,
    valor_atual
):

    anterior = (
        str(valor_anterior)
        .strip()
        .upper()
        if pd.notna(valor_anterior)
        else None
    )

    atual = (
        str(valor_atual)
        .strip()
        .upper()
        if pd.notna(valor_atual)
        else None
    )

    if (
        anterior == 'FÍSICA'
        and
        atual != 'FÍSICA'
    ):

        return (
            'SAIU_DO_ESCOPO_FISICA'
        )

    if (
        anterior != 'FÍSICA'
        and
        atual == 'FÍSICA'
    ):

        return (
            'ENTROU_NO_ESCOPO_FISICA'
        )

    if (
        anterior == 'LÓGICA'
        and
        atual != 'LÓGICA'
    ):

        return (
            'SAIU_DO_ESCOPO_LOGICA'
        )

    if (
        anterior != 'LÓGICA'
        and
        atual == 'LÓGICA'
    ):

        return (
            'ENTROU_NO_ESCOPO_LOGICA'
        )

    return None


# ============================================================
# 18. CRIAR TABELA CONSOLIDADA DE IMPACTO
# ============================================================

def criar_tabela_impacto(
    comparacao,
    changelog_alteracoes,
    data_anterior,
    data_atual
):

    if changelog_alteracoes.empty:

        return pd.DataFrame()

    ids_alterados = (
        changelog_alteracoes[
            'UID_IDPMTS'
        ]
        .dropna()
        .unique()
    )

    base = comparacao[
        comparacao['UID_IDPMTS']
        .isin(ids_alterados)
    ].copy()

    resultados = []

    for _, linha in base.iterrows():

        idpmts = linha[
            'UID_IDPMTS'
        ]

        alteracoes_obra = changelog_alteracoes[
            changelog_alteracoes[
                'UID_IDPMTS'
            ].eq(idpmts)
        ]

        campos_alterados = (
            alteracoes_obra[
                'CAMPO_ALTERADO'
            ]
            .dropna()
            .tolist()
        )

        projetos_alterados = [
            campo
            for campo in campos_alterados
            if campo in COLUNAS_PROJETO_MONITORADAS
        ]

        datas_alteradas = [
            campo
            for campo in campos_alterados
            if campo in COLUNAS_DATA_MONITORADAS
        ]

        competencia_anterior = linha.get(
            'COMPETENCIA_ANTERIOR'
        )

        competencia_atual = linha.get(
            'COMPETENCIA_ATUAL'
        )

        mudou_competencia = (
            (
                pd.notna(
                    competencia_anterior
                )
                or
                pd.notna(
                    competencia_atual
                )
            )
            and
            (
                competencia_anterior
                !=
                competencia_atual
            )
        )

        if mudou_competencia:

            impacto_temporal = (
                f'SAIU DE {competencia_anterior} / '
                f'ENTROU EM {competencia_atual}'
            )

        else:

            impacto_temporal = None

        rollout_anterior = linha.get(
            'PMO_ROLLOUT_OVBK_ANTERIOR'
        )

        rollout_atual = linha.get(
            'PMO_ROLLOUT_OVBK_ATUAL'
        )

        escopo_anterior = linha.get(
            'PMO_ESCOPO_META_ANTERIOR'
        )

        escopo_atual = linha.get(
            'PMO_ESCOPO_META_ATUAL'
        )

        resultados.append({

            'DATA_SNAPSHOT_ANTERIOR':
                data_anterior,

            'DATA_SNAPSHOT_ATUAL':
                data_atual,

            'DATA_DETECCAO':
                pd.Timestamp.now(),

            'UID_IDPMTS':
                idpmts,

            'UID_IDENG':
                linha.get(
                    'UID_IDENG_ATUAL'
                ),

            'UID_UFSIGLA':
                linha.get(
                    'UID_UFSIGLA_ATUAL'
                ),

            'PMO_REGIONAL':
                linha.get(
                    'PMO_REGIONAL_ATUAL'
                ),

            'PMO_UF':
                linha.get(
                    'PMO_UF_ATUAL'
                ),

            'QUANTIDADE_CAMPOS_ALTERADOS':
                len(
                    campos_alterados
                ),

            'CAMPOS_ALTERADOS':
                ' | '.join(
                    campos_alterados
                ),

            'PROJETOS_ALTERADOS':
                ' | '.join(
                    projetos_alterados
                ),

            'DATAS_ALTERADAS':
                ' | '.join(
                    datas_alteradas
                ),

            'MUDOU_PROJETO':
                len(
                    projetos_alterados
                ) > 0,

            'MUDOU_DATA':
                len(
                    datas_alteradas
                ) > 0,

            'COMPETENCIA_ANTERIOR':
                competencia_anterior,

            'COMPETENCIA_ATUAL':
                competencia_atual,

            'MUDOU_COMPETENCIA':
                mudou_competencia,

            'IMPACTO_TEMPORAL':
                impacto_temporal,

            'ESCOPO_META_ANTERIOR':
                escopo_anterior,

            'ESCOPO_META_ATUAL':
                escopo_atual,

            'IMPACTO_ESCOPO_META':
                interpretar_escopo_meta(
                    escopo_anterior,
                    escopo_atual
                ),

            'ROLLOUT_OVBK_ANTERIOR':
                rollout_anterior,

            'ROLLOUT_OVBK_ATUAL':
                rollout_atual,

            'IMPACTO_ROLLOUT_OVBK':
                interpretar_rollout(
                    rollout_anterior,
                    rollout_atual
                ),

            'FLAG_SN_ANTERIOR':
                linha.get(
                    'FLAG_SN_ANTERIOR'
                ),

            'FLAG_SN_ATUAL':
                linha.get(
                    'FLAG_SN_ATUAL'
                ),

            'IMPACTO_SN':
                interpretar_transicao_flag(
                    linha.get(
                        'FLAG_SN_ANTERIOR'
                    ),
                    linha.get(
                        'FLAG_SN_ATUAL'
                    ),
                    'SN'
                ),

            'FLAG_AF_ANTERIOR':
                linha.get(
                    'FLAG_AMPLIACAO_FISICA_ANTERIOR'
                ),

            'FLAG_AF_ATUAL':
                linha.get(
                    'FLAG_AMPLIACAO_FISICA_ATUAL'
                ),

            'IMPACTO_AMPLIACAO_FISICA':
                interpretar_transicao_flag(
                    linha.get(
                        'FLAG_AMPLIACAO_FISICA_ANTERIOR'
                    ),
                    linha.get(
                        'FLAG_AMPLIACAO_FISICA_ATUAL'
                    ),
                    'AMPLIACAO_FISICA'
                ),

            'FLAG_AL_ANTERIOR':
                linha.get(
                    'FLAG_AMPLIACAO_LOGICA_ANTERIOR'
                ),

            'FLAG_AL_ATUAL':
                linha.get(
                    'FLAG_AMPLIACAO_LOGICA_ATUAL'
                ),

            'IMPACTO_AMPLIACAO_LOGICA':
                interpretar_transicao_flag(
                    linha.get(
                        'FLAG_AMPLIACAO_LOGICA_ANTERIOR'
                    ),
                    linha.get(
                        'FLAG_AMPLIACAO_LOGICA_ATUAL'
                    ),
                    'AMPLIACAO_LOGICA'
                ),
        })

    return pd.DataFrame(
        resultados
    )


