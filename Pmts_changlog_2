# ============================================================
# 20. VERIFICAR SE A COMPARAÇÃO JÁ FOI SALVA
# ============================================================

def comparacao_ja_processada(
    data_atual
):

    try:

        historico_changelog = c.read_sql(
            DATABASE_HISTORICO,
            TABELA_CHANGELOG,
            BANCO_HISTORICO,
            colunas='DATA_SNAPSHOT_ATUAL'
        )

        if historico_changelog.empty:
            return False

        historico_changelog[
            'DATA_SNAPSHOT_ATUAL'
        ] = pd.to_datetime(
            historico_changelog[
                'DATA_SNAPSHOT_ATUAL'
            ],
            errors='coerce'
        )

        return (
            historico_changelog[
                'DATA_SNAPSHOT_ATUAL'
            ]
            .dt.normalize()
            .eq(
                pd.Timestamp(
                    data_atual
                ).normalize()
            )
            .any()
        )

    except Exception:

        # A tabela ainda não existe
        return False


# ============================================================
# 21. SALVAR RESULTADOS NO BANCO
# ============================================================

def salvar_resultados_banco(
    changelog,
    impacto,
    data_atual,
    force=False
):

    if (
        comparacao_ja_processada(
            data_atual
        )
        and
        not force
    ):

        print(
            '\nATENÇÃO: essa comparação '
            'já foi processada.'
        )

        print(
            'Nada foi adicionado novamente.'
        )

        return False

    if not changelog.empty:

        c.to_sql(
            changelog,
            DATABASE_HISTORICO,
            TABELA_CHANGELOG,
            BANCO_HISTORICO,
            normalize=True,
            existente='append'
        )

        print(
            'Changelog salvo no banco.'
        )

    else:

        print(
            'Changelog vazio: '
            'nenhuma alteração para salvar.'
        )

    if not impacto.empty:

        c.to_sql(
            impacto,
            DATABASE_HISTORICO,
            TABELA_IMPACTO,
            BANCO_HISTORICO,
            normalize=True,
            existente='append'
        )

        print(
            'Tabela de impacto salva no banco.'
        )

    else:

        print(
            'Tabela de impacto vazia: '
            'nenhum impacto para salvar.'
        )

    return True


