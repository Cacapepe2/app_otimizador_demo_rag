# ============================================================
# 3. TRATAMENTO DO HISTÓRICO
# ============================================================

def tratar_historico(historico):

    df = historico.copy()

    # --------------------------------------------------------
    # Datas
    # --------------------------------------------------------

    colunas_data = [
        'DATA_SNAPSHOT',
        'DATA_HORA_CARGA',
        *COLUNAS_DATA_MONITORADAS
    ]

    for coluna in colunas_data:

        if coluna in df.columns:

            df[coluna] = pd.to_datetime(
                df[coluna],
                errors='coerce'
            )

    df['DATA_SNAPSHOT'] = (
        df['DATA_SNAPSHOT']
        .dt.normalize()
    )

    # --------------------------------------------------------
    # Chaves
    # --------------------------------------------------------

    for coluna in [
        'UID_IDPMTS',
        'UID_IDENG',
        'UID_UFSIGLA'
    ]:

        if coluna in df.columns:

            df[coluna] = (
                df[coluna]
                .astype('string')
                .str.strip()
                .str.upper()
            )

    # --------------------------------------------------------
    # Flags
    # --------------------------------------------------------

    for coluna in COLUNAS_FLAG_MONITORADAS:

        if coluna in df.columns:

            df[coluna] = normalizar_booleano(
                df[coluna]
            )

    return df


# ============================================================
# 4. SELECIONAR OS DOIS SNAPSHOTS MAIS RECENTES
# ============================================================

def selecionar_dois_ultimos_snapshots(historico):

    datas_disponiveis = (
        historico['DATA_SNAPSHOT']
        .dropna()
        .drop_duplicates()
        .sort_values()
        .tolist()
    )

    if len(datas_disponiveis) < 2:

        raise ValueError(
            'São necessários pelo menos dois snapshots '
            'diferentes para realizar a comparação.'
        )

    data_anterior = datas_disponiveis[-2]
    data_atual = datas_disponiveis[-1]

    anterior = historico[
        historico['DATA_SNAPSHOT']
        .eq(data_anterior)
    ].copy()

    atual = historico[
        historico['DATA_SNAPSHOT']
        .eq(data_atual)
    ].copy()

    print(
        '\nSnapshot anterior:',
        pd.Timestamp(data_anterior).strftime('%d/%m/%Y')
    )

    print(
        'Snapshot atual:',
        pd.Timestamp(data_atual).strftime('%d/%m/%Y')
    )

    print(
        'Linhas no snapshot anterior:',
        f'{len(anterior):,}'
    )

    print(
        'Linhas no snapshot atual:',
        f'{len(atual):,}'
    )

    validar_chave_snapshot(
        anterior,
        'ANTERIOR'
    )

    validar_chave_snapshot(
        atual,
        'ATUAL'
    )

    return (
        anterior,
        atual,
        data_anterior,
        data_atual
    )


# ============================================================
# 5. VALIDAR CHAVE
# ============================================================

def validar_chave_snapshot(
    df,
    nome_snapshot
):

    duplicados = df[
        df['UID_IDPMTS']
        .duplicated(keep=False)
    ]

    if not duplicados.empty:

        exemplos = (
            duplicados['UID_IDPMTS']
            .dropna()
            .drop_duplicates()
            .head(10)
            .tolist()
        )

        raise ValueError(
            f'Existem UID_IDPMTS duplicados no snapshot '
            f'{nome_snapshot}. Exemplos: {exemplos}'
        )


# ============================================================
# 6. COMPARAÇÃO SEGURA DE VALORES
# ============================================================

def valores_diferentes(
    serie_anterior,
    serie_atual
):

    """
    Regras:

    vazio x vazio = não mudou
    vazio x valor = mudou
    valor x vazio = mudou
    valor A x valor B = mudou se A != B
    """

    anterior_vazio = (
        serie_anterior.isna()
    )

    atual_vazio = (
        serie_atual.isna()
    )

    ambos_vazios = (
        anterior_vazio
        &
        atual_vazio
    )

    return (
        serie_anterior.ne(
            serie_atual
        )
        &
        ~ambos_vazios
    )


# ============================================================
# 7. NORMALIZAÇÃO DOS CAMPOS DE PROJETO
# ============================================================

def normalizar_valor_projeto(valor):

    """
    Normaliza campos de projeto compostos por itens
    separados por "/".

    Exemplos equivalentes:

    MARKETING/PROJETO 5G
    PROJETO 5G/MARKETING

    COBERTURA-QUALIDADE/REGULATÓRIO
    REGULATÓRIO/COBERTURA-QUALIDADE

    Também remove:
    - espaços extras;
    - diferença entre maiúsculas e minúsculas;
    - itens repetidos.
    """

    if pd.isna(valor):
        return None

    texto = str(valor).strip()

    if texto == '':
        return None

    partes = [
        parte.strip().upper()
        for parte in texto.split('/')
        if parte.strip()
    ]

    # Remove repetições e ignora a ordem
    partes_normalizadas = sorted(
        set(partes)
    )

    if not partes_normalizadas:
        return None

    return '/'.join(
        partes_normalizadas
    )


# ============================================================
# 8. COMPARAÇÃO POR TIPO DE CAMPO
# ============================================================

def comparar_campo_monitorado(
    serie_anterior,
    serie_atual,
    campo
):

    """
    Para campos de projeto:
    ignora a ordem dos itens separados por "/".

    Para datas, escopo e rollout:
    mantém a comparação normal.
    """

    if campo in COLUNAS_PROJETO_MONITORADAS:

        anterior_normalizado = (
            serie_anterior.apply(
                normalizar_valor_projeto
            )
        )

        atual_normalizado = (
            serie_atual.apply(
                normalizar_valor_projeto
            )
        )

        return valores_diferentes(
            anterior_normalizado,
            atual_normalizado
        )

    return valores_diferentes(
        serie_anterior,
        serie_atual
    )


# ============================================================
# 9. FORMATAR VALORES PARA SAÍDA
# ============================================================

def formatar_valor_saida(valor):

    if pd.isna(valor):
        return None

    if isinstance(
        valor,
        (pd.Timestamp, datetime)
    ):

        return valor.strftime(
            '%Y-%m-%d'
        )

    return str(valor)


