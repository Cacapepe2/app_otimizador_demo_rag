# ============================================================
# 15. GRÁFICO 1 - VERSÃO PARA POWERPOINT
# ============================================================

if "ESCOPO_META_AJUSTADO" in df_grafico.columns:

    # --------------------------------------------------------
    # RESUMO DOS GRUPOS
    # --------------------------------------------------------

    total_validas = df_valido[COL_ID].nunique()

    qtd_0_10 = df_valido.loc[
        df_valido["LEAD_TIME_DIAS"].between(0, 10),
        COL_ID
    ].nunique()

    qtd_11_105 = df_valido.loc[
        (df_valido["LEAD_TIME_DIAS"] > 10)
        &
        (df_valido["LEAD_TIME_DIAS"] <= 105),
        COL_ID
    ].nunique()

    qtd_maior_105 = df_valido.loc[
        df_valido["LEAD_TIME_DIAS"] > 105,
        COL_ID
    ].nunique()


    pct_0_10 = qtd_0_10 / total_validas * 100
    pct_11_105 = qtd_11_105 / total_validas * 100
    pct_maior_105 = qtd_maior_105 / total_validas * 100


    # --------------------------------------------------------
    # CORES
    # --------------------------------------------------------

    cores_escopo = {
        "FÍSICA": "#1f77b4",
        "LÓGICA": "#F2C94C",
        "OUTROS": "#F28E2B",
        "REMANEJAMENTO": "#7f7f7f"
    }

    cores = [
        cores_escopo[col]
        for col in pivot_escopo.columns
    ]


    # ========================================================
    # FIGURA 16:9
    # ========================================================

    fig, ax = plt.subplots(
        figsize=(16, 9)
    )


    pivot_escopo.plot(
        kind="bar",
        stacked=True,
        ax=ax,
        color=cores,
        width=0.82
    )


    # --------------------------------------------------------
    # TÍTULO
    # --------------------------------------------------------

    ax.set_title(
        "Distribuição do Lead Time entre LIB Site e Ativação por Escopo Meta",
        fontsize=20,
        fontweight="bold",
        pad=55
    )


    ax.set_xlabel(
        "Lead Time — Ativação menos LIB Site (dias)",
        fontsize=15,
        fontweight="bold"
    )


    ax.set_ylabel(
        "Quantidade de obras",
        fontsize=15,
        fontweight="bold"
    )


    # ========================================================
    # EIXO X
    #
    # Mantém barras de 5 em 5,
    # mas mostra texto apenas de 10 em 10.
    # ========================================================

    labels = [
        str(x)
        for x in pivot_escopo.index
    ]


    posicoes = np.arange(
        len(labels)
    )


    labels_exibidos = []


    for i, label in enumerate(labels):

        # mostra uma faixa sim e uma não
        # 0-5, 11-15, 21-25...
        if i % 2 == 0:
            labels_exibidos.append(label)

        else:
            labels_exibidos.append("")


    ax.set_xticks(posicoes)

    ax.set_xticklabels(
        labels_exibidos,
        rotation=45,
        ha="right",
        fontsize=11
    )


    ax.tick_params(
        axis="y",
        labelsize=12
    )


    # ========================================================
    # LEGENDA
    # ========================================================

    ax.legend(
        title="Escopo Meta",
        title_fontsize=13,
        fontsize=12,
        loc="upper right",
        frameon=True
    )


    # ========================================================
    # GRID
    # ========================================================

    ax.grid(
        axis="y",
        alpha=0.25
    )

    ax.set_axisbelow(True)


    # ========================================================
    # SEPARAÇÕES 10 / 105
    # ========================================================

    if "6-10" in labels:

        idx_10 = labels.index(
            "6-10"
        )

        ax.axvline(
            idx_10 + 0.5,
            linestyle="--",
            linewidth=1.5,
            alpha=0.6
        )

    else:

        idx_10 = 1


    if "101-105" in labels:

        idx_105 = labels.index(
            "101-105"
        )

        ax.axvline(
            idx_105 + 0.5,
            linestyle="--",
            linewidth=1.5,
            alpha=0.6
        )

    else:

        idx_105 = None


    # ========================================================
    # CABEÇALHOS DOS 3 GRUPOS
    # ========================================================

    # centro 0-10
    centro_0_10 = idx_10 / 2


    ax.text(
        centro_0_10,
        1.025,
        (
            f"0–10 dias\n"
            f"{qtd_0_10:,} obras | {pct_0_10:.1f}%"
        ),
        transform=ax.get_xaxis_transform(),
        ha="center",
        va="bottom",
        fontsize=12,
        fontweight="bold"
    )


    if idx_105 is not None:

        centro_11_105 = (
            idx_10
            + 1
            + idx_105
        ) / 2


        ax.text(
            centro_11_105,
            1.025,
            (
                f"11–105 dias\n"
                f"{qtd_11_105:,} obras | {pct_11_105:.1f}%"
            ),
            transform=ax.get_xaxis_transform(),
            ha="center",
            va="bottom",
            fontsize=12,
            fontweight="bold"
        )


        # centro de >105 até o final do gráfico
        if idx_105 < len(labels) - 1:

            centro_maior_105 = (
                idx_105
                + 1
                + len(labels)
                - 1
            ) / 2


            ax.text(
                centro_maior_105,
                1.025,
                (
                    f">105 dias\n"
                    f"{qtd_maior_105:,} obras | "
                    f"{pct_maior_105:.1f}%"
                ),
                transform=ax.get_xaxis_transform(),
                ha="center",
                va="bottom",
                fontsize=12,
                fontweight="bold"
            )


    # ========================================================
    # TOTAL DAS BARRAS
    #
    # Só mostramos nas barras mais relevantes,
    # senão polui muito o slide.
    # ========================================================

    totais = pivot_escopo.sum(axis=1)


    for i, total in enumerate(totais):

        # mostrar um total a cada 2 barras
        if total > 0 and i % 2 == 0:

            ax.text(
                i,
                total + 8,
                f"{int(total)}",
                ha="center",
                va="bottom",
                fontsize=9,
                fontweight="bold"
            )


    # ========================================================
    # MARGENS
    # ========================================================

    plt.subplots_adjust(
        left=0.07,
        right=0.98,
        bottom=0.18,
        top=0.84
    )


    plt.savefig(
        "01_lead_time_slide.png",
        dpi=300,
        bbox_inches="tight"
    )


    plt.show()
