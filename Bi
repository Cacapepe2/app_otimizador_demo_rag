def agora_local():
    return datetime.now(ZoneInfo(timezone_local))


def texto_limpo(valor):
    if valor is None:
        return None
    valor = str(valor).strip()
    return valor if valor else None


def normalizar_chave(valor):
    """Normalização leve para facilitar joins posteriores com o log."""
    valor = texto_limpo(valor)
    if valor is None:
        return None
    valor = unicodedata.normalize("NFKD", valor)
    valor = "".join(c for c in valor if not unicodedata.combining(c))
    return valor.lower().strip()


def modelo_permitido(nome):
    nome = texto_limpo(nome) or ""

    if nome in modelos_excluir_exato:
        return False

    nome_lower = nome.lower()
    if any(x.lower() in nome_lower for x in modelos_excluir_contem):
        return False

    if modelos_incluir_apenas:
        permitidos = {x.lower() for x in modelos_incluir_apenas}
        return nome_lower in permitidos

    return True


def get_workspace_id_e_nome():
    """Resolve ID e nome do workspace atual ou do workspace configurado."""
    if workspace is None:
        ws_id = str(fabric.get_workspace_id())
        try:
            ws_nome = fabric.resolve_workspace_name(ws_id)
        except Exception:
            ws_nome = workspace_nome_log
        return ws_id, ws_nome

    ws_id = str(fabric.resolve_workspace_id(workspace))
    try:
        ws_nome = fabric.resolve_workspace_name(ws_id)
    except Exception:
        ws_nome = str(workspace)
    return ws_id, ws_nome


def get_pbi_token():
    return notebookutils.credentials.getToken("pbi")


def headers_api(token):
    return {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
    }


def request_json(method, url, token, **kwargs):
    """Chamada REST com erro legível."""
    resp = requests.request(
        method,
        url,
        headers=headers_api(token),
        timeout=request_timeout_segundos,
        **kwargs,
    )

    if resp.status_code >= 400:
        try:
            detalhe = resp.json()
        except Exception:
            detalhe = resp.text[:1000]
        raise RuntimeError(f"HTTP {resp.status_code} - {url} - {detalhe}")

    if not resp.content:
        return None, resp

    try:
        return resp.json(), resp
    except Exception:
        return resp.text, resp


def listar_reports_powerbi(workspace_id, token):
    """Lista relatórios e traz datasetId/modelo semântico associado."""
    url = f"https://api.powerbi.com/v1.0/myorg/groups/{workspace_id}/reports"
    payload, _ = request_json("GET", url, token)
    return payload.get("value", []) if payload else []


def listar_modelos_powerbi(workspace_id, token):
    """Lista modelos semânticos/datasets do workspace."""
    url = f"https://api.powerbi.com/v1.0/myorg/groups/{workspace_id}/datasets"
    payload, _ = request_json("GET", url, token)
    return payload.get("value", []) if payload else []


def obter_datasources_modelo(workspace_id, model_id, token):
    """
    Retorna conexões conhecidas do modelo.
    Atenção: a API Power BI atualmente exige Write no dataset/modelo.
    """
    url = (
        "https://api.powerbi.com/v1.0/myorg/groups/"
        f"{workspace_id}/datasets/{model_id}/datasources"
    )

    try:
        payload, _ = request_json("GET", url, token)
        return payload.get("value", []) if payload else [], "OK", None
    except Exception as exc:
        return [], "SEM_PERMISSAO_OU_NAO_SUPORTADO", str(exc)


def obter_definition_tmdl(workspace_id, model_id, token):
    """
    Obtém a definição TMDL via Fabric REST API.
    Suporta resposta imediata (200) ou Long Running Operation (202).
    """
    url = (
        "https://api.fabric.microsoft.com/v1/workspaces/"
        f"{workspace_id}/semanticModels/{model_id}/getDefinition?format=TMDL"
    )

    resp = requests.post(
        url,
        headers=headers_api(token),
        timeout=request_timeout_segundos,
    )

    if resp.status_code == 200:
        return resp.json(), "OK", None

    if resp.status_code == 202:
        operation_id = resp.headers.get("x-ms-operation-id")
        location = resp.headers.get("Location")
        retry_after = int(resp.headers.get("Retry-After", lro_intervalo_segundos))

        if not operation_id and not location:
            return None, "ERRO_LRO", "API respondeu 202 sem operation id/location."

        state_url = location or f"https://api.fabric.microsoft.com/v1/operations/{operation_id}"
        inicio = time.time()

        while time.time() - inicio < lro_timeout_segundos:
            time.sleep(max(1, retry_after))
            state_resp = requests.get(
                state_url,
                headers=headers_api(token),
                timeout=request_timeout_segundos,
            )

            if state_resp.status_code >= 400:
                return None, "ERRO_LRO", state_resp.text[:1000]

            state = state_resp.json() if state_resp.content else {}
            status = str(state.get("status", "")).lower()

            if status == "failed":
                return None, "ERRO_LRO", json.dumps(state, ensure_ascii=False)

            if status == "succeeded":
                result_url = f"https://api.fabric.microsoft.com/v1/operations/{operation_id}/result"
                result_resp = requests.get(
                    result_url,
                    headers=headers_api(token),
                    timeout=request_timeout_segundos,
                )

                if result_resp.status_code >= 400:
                    return None, "ERRO_LRO_RESULT", result_resp.text[:1000]

                return result_resp.json(), "OK", None

            # Em algumas respostas o Location passa a apontar para /result.
            novo_location = state_resp.headers.get("Location")
            if novo_location:
                state_url = novo_location
            retry_after = int(state_resp.headers.get("Retry-After", lro_intervalo_segundos))

        return None, "TIMEOUT_TMDL", f"Timeout após {lro_timeout_segundos}s."

    # 403/404/etc: registra e continua.
    try:
        detalhe = resp.json()
    except Exception:
        detalhe = resp.text[:1000]
    return None, f"HTTP_{resp.status_code}", str(detalhe)


def decodificar_partes_tmdl(definition_payload):
    """Converte os parts InlineBase64 em {path: texto}."""
    arquivos = {}
    if not definition_payload:
        return arquivos

    definition = definition_payload.get("definition", {})
    parts = definition.get("parts", [])

    for part in parts:
        path = part.get("path")
        payload = part.get("payload")
        payload_type = part.get("payloadType")

        if not path or not payload:
            continue

        try:
            if payload_type == "InlineBase64":
                texto = base64.b64decode(payload).decode("utf-8", errors="replace")
            else:
                texto = str(payload)
            arquivos[path] = texto
        except Exception:
            continue

    return arquivos


def remover_aspas_tmdl(valor):
    valor = texto_limpo(valor)
    if valor is None:
        return None
    if valor.startswith("#\"") and valor.endswith("\""):
        return valor[2:-1]
    if (valor.startswith("\"") and valor.endswith("\"")) or (
        valor.startswith("'") and valor.endswith("'")
    ):
        return valor[1:-1]
    return valor


def extrair_parametros_tmdl(arquivos):
    """Tenta resolver expressions simples como expression Server = \"...\"."""
    parametros = {}
    padrao = re.compile(
        r"(?m)^\s*expression\s+(?:'([^']+)'|([^\s=]+))\s*=\s*\"([^\"]*)\""
    )

    for texto in arquivos.values():
        for m in padrao.finditer(texto):
            nome = m.group(1) or m.group(2)
            parametros[nome] = m.group(3)

    return parametros


def resolver_token_m(token_m, parametros):
    token_m = texto_limpo(token_m)
    if token_m is None:
        return None

    # literal "valor"
    if token_m.startswith('"') and token_m.endswith('"'):
        return token_m[1:-1]

    # identificador Power Query #"Nome Parametro"
    if token_m.startswith('#"') and token_m.endswith('"'):
        nome = token_m[2:-1]
        return parametros.get(nome, nome)

    return parametros.get(token_m, token_m)


def detectar_tipo_fonte(texto):
    testes = [
        ("Sql.Database", "SQL"),
        ("PostgreSQL.Database", "POSTGRESQL"),
        ("Oracle.Database", "ORACLE"),
        ("Snowflake.Databases", "SNOWFLAKE"),
        ("Odbc.DataSource", "ODBC"),
        ("OData.Feed", "ODATA"),
        ("SharePoint.Files", "SHAREPOINT"),
        ("SharePoint.Contents", "SHAREPOINT"),
        ("Web.Contents", "WEB"),
        ("Excel.Workbook", "EXCEL"),
        ("AzureStorage.DataLake", "ONELAKE_OR_ADLS"),
        ("Lakehouse.Contents", "LAKEHOUSE"),
        ("PowerPlatform.Dataflows", "DATAFLOW"),
    ]
    for trecho, nome in testes:
        if trecho.lower() in texto.lower():
            return nome
    if re.search(r"(?im)^\s*entityName\s*:", texto):
        return "DIRECT_LAKE"
    return "UNKNOWN"


def parsear_tabela_tmdl(path, texto, parametros):
    """
    Best effort parser.
    Retorna a origem física quando o TMDL explicita essa informação.
    Não inventa origem quando não consegue provar.
    """
    nome_arquivo = PurePosixPath(path).stem

    m_table = re.search(r"(?m)^\s*table\s+(?:'([^']+)'|([^\r\n]+))\s*$", texto)
    model_table = (m_table.group(1) or m_table.group(2)).strip() if m_table else nome_arquivo

    m_partition = re.search(
        r"(?m)^\s*partition\s+(?:'([^']+)'|([^=\r\n]+))\s*=\s*([^\r\n]+)",
        texto,
    )
    partition_name = None
    partition_kind = None
    if m_partition:
        partition_name = texto_limpo(m_partition.group(1) or m_partition.group(2))
        partition_kind = texto_limpo(m_partition.group(3))

    m_mode = re.search(r"(?im)^\s*mode\s*:\s*([^\r\n]+)", texto)
    partition_mode = texto_limpo(m_mode.group(1)) if m_mode else None

    source_type = detectar_tipo_fonte(texto)
    source_server = None
    source_database = None
    source_schema = None
    source_table = None
    source_url = None
    resolution = "UNKNOWN"

    # Sql.Database(server, database)
    m_sql = re.search(
        r"Sql\.Database\(\s*([^,\)]+)\s*,\s*([^\)]+?)\s*(?:,\s*\[|\))",
        texto,
        flags=re.I | re.S,
    )
    if m_sql:
        source_server = resolver_token_m(m_sql.group(1).strip(), parametros)
        source_database = resolver_token_m(m_sql.group(2).strip(), parametros)
        resolution = "CONNECTION_ONLY"

    # Navegação Power Query: Source{[Schema="dbo", Item="Tabela"]}[Data]
    m_nav = re.search(
        r"\[\s*Schema\s*=\s*\"([^\"]+)\"\s*,\s*(?:Item|Name)\s*=\s*\"([^\"]+)\"\s*\]",
        texto,
        flags=re.I,
    )
    if not m_nav:
        # Ordem invertida Item/Schema.
        m_nav2 = re.search(
            r"\[\s*(?:Item|Name)\s*=\s*\"([^\"]+)\"\s*,\s*Schema\s*=\s*\"([^\"]+)\"\s*\]",
            texto,
            flags=re.I,
        )
        if m_nav2:
            source_table = m_nav2.group(1)
            source_schema = m_nav2.group(2)
            resolution = "EXACT_TABLE"
    else:
        source_schema = m_nav.group(1)
        source_table = m_nav.group(2)
        resolution = "EXACT_TABLE"

    # Direct Lake entity partition.
    m_entity = re.search(r"(?im)^\s*entityName\s*:\s*(.+?)\s*$", texto)
    m_schema = re.search(r"(?im)^\s*schemaName\s*:\s*(.+?)\s*$", texto)
    if m_entity:
        source_table = remover_aspas_tmdl(m_entity.group(1))
        source_schema = remover_aspas_tmdl(m_schema.group(1)) if m_schema else source_schema
        source_type = "DIRECT_LAKE"
        resolution = "EXACT_TABLE"

    # URLs / OneLake / SharePoint / Web.
    m_url = re.search(r"https?://[^\"\s\)]+", texto)
    if m_url:
        source_url = m_url.group(0)
        if resolution == "UNKNOWN":
            resolution = "CONNECTION_ONLY"

    # Native SQL: tenta achar FROM schema.table. Mantém como best effort.
    if source_table is None:
        m_from = re.search(
            r"(?is)\bFROM\s+(?:\[([^\]]+)\]|([A-Za-z0-9_]+))\."
            r"(?:\[([^\]]+)\]|([A-Za-z0-9_]+))",
            texto,
        )
        if m_from:
            source_schema = m_from.group(1) or m_from.group(2)
            source_table = m_from.group(3) or m_from.group(4)
            resolution = "EXACT_TABLE_NATIVE_SQL"

    return {
        "model_table": model_table,
        "partition_name": partition_name,
        "partition_kind": partition_kind,
        "partition_mode": partition_mode,
        "source_type": source_type,
        "source_server": source_server,
        "source_database": source_database,
        "source_schema": source_schema,
        "source_table": source_table,
        "source_url": source_url,
        "source_resolution": resolution,
        # Trecho limitado para diagnóstico; evita criar uma tabela gigante.
        "source_expression_excerpt": re.sub(r"\s+", " ", texto)[:1500],
    }


def parsear_tmdl_modelo(definition_payload):
    arquivos = decodificar_partes_tmdl(definition_payload)
    parametros = extrair_parametros_tmdl(arquivos)

    linhas = []
    for path, texto in arquivos.items():
        if path.startswith("definition/tables/") and path.endswith(".tmdl"):
            linha = parsear_tabela_tmdl(path, texto, parametros)
            linha["tmdl_path"] = path
            linhas.append(linha)

    return linhas


def connection_details_para_colunas(datasource):
    details = datasource.get("connectionDetails") or {}

    # A API varia por conector. Guardamos o JSON completo e extraímos os campos comuns.
    server = details.get("server") or details.get("host")
    database = details.get("database")
    url = details.get("url") or details.get("siteUrl")
    path = details.get("path")

    return {
        "datasource_type": datasource.get("datasourceType"),
        "datasource_id": datasource.get("datasourceId"),
        "gateway_id": datasource.get("gatewayId"),
        "connection_server": server,
        "connection_database": database,
        "connection_url": url,
        "connection_path": path,
        "connection_details_json": json.dumps(details, ensure_ascii=False, default=str),
    }


def salvar_delta(df, nome_tabela):
    if not salvar_no_lakehouse:
        return

    if df is None or df.empty:
        print(f"[INFO] {nome_tabela}: DataFrame vazio; não será salvo.")
        return

    # Tudo que chega aqui deve ser simples/serializável.
    df_out = df.copy()
    for col in df_out.columns:
        if df_out[col].dtype == "object":
            df_out[col] = df_out[col].apply(
                lambda x: json.dumps(x, ensure_ascii=False, default=str)
                if isinstance(x, (dict, list))
                else x
            )

    spark_df = spark.createDataFrame(df_out)
    (
        spark_df.write
        .format("delta")
        .mode(modo_escrita_lakehouse)
        .option("overwriteSchema", "true")
        .saveAsTable(nome_tabela)
    )
    print(f"[OK] Salvo: {nome_tabela} ({len(df_out)} linhas)")


