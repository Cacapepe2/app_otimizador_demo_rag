                "source_resolution": "TMDL_NOT_AVAILABLE",
                "source_expression_excerpt": None,
                "tmdl_path": None,
                "tmdl_status": tmdl_status,
                "tmdl_error": tmdl_error,
                "scan_at": scan_at,
            })


df_datasources = pd.DataFrame(datasource_rows)
df_model_tables = pd.DataFrame(model_table_rows)

print(f"Conexões de datasource: {len(df_datasources)}")
print(f"Tabelas/modelos TMDL: {len(df_model_tables)}")


# ------------------------------------------------------------
# 4) CONSOLIDADO BI -> MODELO -> TABELA -> FONTE
# ------------------------------------------------------------

# Filtra reports que usam modelos considerados.
if not df_reports.empty and not df_modelos.empty:
    df_reports_validos = df_reports.merge(
        df_modelos[["semantic_model_id", "semantic_model_name"]],
        on="semantic_model_id",
        how="inner",
    )
else:
    df_reports_validos = pd.DataFrame()

# Mantém também modelos sem report, para não perder dependências reutilizadas.
if not df_model_tables.empty:
    base_fontes = df_model_tables.copy()
else:
    base_fontes = df_modelos.copy()
    for col in [
        "model_table", "partition_name", "partition_kind", "partition_mode",
        "source_type", "source_server", "source_database", "source_schema",
        "source_table", "source_url", "source_resolution", "tmdl_status",
        "tmdl_error", "tmdl_path", "source_expression_excerpt"
    ]:
        base_fontes[col] = None

# Completa conexão-level quando o TMDL só conseguiu parte da origem.
if not df_datasources.empty:
    ds_reduzido = (
        df_datasources.sort_values(["semantic_model_id"])
        .drop_duplicates(subset=["semantic_model_id"], keep="first")
        [[
            "semantic_model_id", "datasource_type", "connection_server",
            "connection_database", "connection_url", "connection_path",
            "datasource_status", "datasource_error"
        ]]
    )
    base_fontes = base_fontes.merge(ds_reduzido, on="semantic_model_id", how="left")
else:
    for col in [
        "datasource_type", "connection_server", "connection_database",
        "connection_url", "connection_path", "datasource_status", "datasource_error"
    ]:
        base_fontes[col] = None

# Fallback: se TMDL não trouxe server/database, usa detalhes da conexão.
base_fontes["source_type_final"] = base_fontes["source_type"].fillna(base_fontes["datasource_type"])
base_fontes["source_server_final"] = base_fontes["source_server"].fillna(base_fontes["connection_server"])
base_fontes["source_database_final"] = base_fontes["source_database"].fillna(base_fontes["connection_database"])
base_fontes["source_url_final"] = base_fontes["source_url"].fillna(base_fontes["connection_url"])

# Normalizados para o futuro join com log_atividade_scripts.
base_fontes["source_database_norm"] = base_fontes["source_database_final"].apply(normalizar_chave)
base_fontes["source_schema_norm"] = base_fontes["source_schema"].apply(normalizar_chave)
base_fontes["source_table_norm"] = base_fontes["source_table"].apply(normalizar_chave)

base_fontes["source_full_name"] = base_fontes.apply(
    lambda r: ".".join([
        x for x in [
            texto_limpo(r.get("source_database_final")),
            texto_limpo(r.get("source_schema")),
            texto_limpo(r.get("source_table")),
        ] if x
    ]) or None,
    axis=1,
)

# Liga cada modelo aos BIs que o consomem.
if not df_reports_validos.empty:
    report_cols = [
        "workspace_id", "workspace_name", "report_id", "report_name",
        "semantic_model_id", "report_type", "report_format", "web_url"
    ]
    df_final = df_reports_validos[report_cols].merge(
        base_fontes.drop(columns=["workspace_id", "workspace_name"], errors="ignore"),
        on="semantic_model_id",
        how="right",
    )
else:
    df_final = base_fontes.copy()
    df_final["report_id"] = None
    df_final["report_name"] = None
    df_final["report_type"] = None
    df_final["report_format"] = None
    df_final["web_url"] = None

# Ordem principal de leitura.
colunas_primeiro = [
    "workspace_name",
    "report_name",
    "semantic_model_name",
    "model_table",
    "source_type_final",
    "source_server_final",
    "source_database_final",
    "source_schema",
    "source_table",
    "source_full_name",
    "source_resolution",
    "partition_mode",
    "tmdl_status",
    "datasource_status",
    "scan_at",
]

colunas_existentes = [c for c in colunas_primeiro if c in df_final.columns]
restante = [c for c in df_final.columns if c not in colunas_existentes]
df_final = df_final[colunas_existentes + restante]


# ------------------------------------------------------------
# 5) SAÍDA / DIAGNÓSTICO
# ------------------------------------------------------------

print("\nResumo da resolução das fontes:")
if "source_resolution" in df_final.columns:
    print(df_final["source_resolution"].value_counts(dropna=False).to_string())

print("\nAmostra do catálogo final:")
display(df_final.head(100))


# ------------------------------------------------------------
# 6) SALVAR NO LAKEHOUSE
# ------------------------------------------------------------

salvar_delta(df_reports, tabela_reports)
salvar_delta(df_modelos, tabela_modelos)
salvar_delta(df_datasources, tabela_datasources)
salvar_delta(df_model_tables, tabela_model_tables)
salvar_delta(df_final, tabela_catalogo_final)

print("\n" + "=" * 80)
print("SCAN FINALIZADO")
print(f"Tabela principal para o BI: {tabela_catalogo_final}")
print("Próximo passo sugerido: cruzar source_database_norm/source_table_norm")
print("com DATABASE/TABELA normalizados de controle_gestao.log_atividade_scripts.")
print("=" * 80)
