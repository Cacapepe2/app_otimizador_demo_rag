import pandas as pd
import numpy as np


# ============================================================
# 1. FUNÇÃO PARA CONVERTER ANO_MES EM DATA
# ============================================================

def converter_ano_mes_para_data(serie):

    texto = serie.astype("string").str.strip()

    partes = texto.str.extract(
        r"(?P<ano>\d{4})\D?(?P<mes>\d{1,2})"
    )

    return pd.to_datetime(
        partes["ano"]
        + "-"
        + partes["mes"].str.zfill(2)
        + "-01",
        errors="coerce"
    )


# ============================================================
# 2. FUNÇÃO QUE CRIA A VISÃO DE CADA ETAPA
# ============================================================

def criar_visao_mensal(
    df,
    colunas_comuns,
    col_mes,
    col_score,
    nome_etapa,
    meses_total=12
):

    # Mês atual
    hoje = pd.Timestamp.today().normalize()
    mes_atual = hoje.to_period("M").to_timestamp()

    # 11 meses individuais + 1 coluna final acumulada
    meses_explicitos = meses_total - 1

    mes_limite = (
        mes_atual
        + pd.DateOffset(months=meses_explicitos - 1)
    )

    # Pega:
    # - as colunas comuns
    # - o mês específico da etapa
    # - o score específico da etapa
    df_temp = df[
        colunas_comuns
        + [col_mes, col_score]
    ].copy()

    # Padroniza os nomes
    df_temp = df_temp.rename(columns={
        col_mes: "mes_original",
        col_score: "score"
    })

    # Identifica de qual etapa veio a linha
    df_temp["etapa"] = nome_etapa

    # Converte, por exemplo:
    # 2026_07 -> 01/07/2026
    df_temp["data_mes"] = converter_ano_mes_para_data(
        df_temp["mes_original"]
    )

    # --------------------------------------------------------
    # REGRAS
    # --------------------------------------------------------

    sem_planejamento = df_temp["data_mes"].isna()

    vencido = (
        df_temp["data_mes"].notna()
        & (df_temp["data_mes"] < mes_atual)
    )

    dentro_periodo = (
        df_temp["data_mes"].notna()
        & (df_temp["data_mes"] >= mes_atual)
        & (df_temp["data_mes"] <= mes_limite)
    )

    futuro_acumulado = (
        df_temp["data_mes"].notna()
        & (df_temp["data_mes"] > mes_limite)
    )

    # Calcula a posição do mês
    ordem_mes = (
        (df_temp["data_mes"].dt.year - mes_atual.year) * 12
        + (
            df_temp["data_mes"].dt.month
            - mes_atual.month
        )
    )

    # --------------------------------------------------------
    # STATUS
    # --------------------------------------------------------

    df_temp["status"] = np.select(
        [
            sem_planejamento,
            vencido,
            dentro_periodo,
            futuro_acumulado
        ],
        [
            "Sem planejamento",
            "Vencido",
            "Planejado",
            "Planejado"
        ],
        default="Verificar"
    )

    # --------------------------------------------------------
    # BUCKET
    # --------------------------------------------------------

    df_temp["bucket"] = np.select(
        [
            sem_planejamento,
            vencido,
            dentro_periodo,
            futuro_acumulado
        ],
        [
            "Sem planejamento",
            "Vencido",
            df_temp["data_mes"].dt.strftime("%Y_%m"),
            ">" + mes_limite.strftime("%Y_%m")
        ],
        default="Verificar"
    )

    # --------------------------------------------------------
    # ORDEM DO BUCKET
    # --------------------------------------------------------

    df_temp["ordem_bucket"] = np.select(
        [
            sem_planejamento,
            vencido,
            dentro_periodo,
            futuro_acumulado
        ],
        [
            -2,
            -1,
            ordem_mes,
            meses_total - 1
        ],
        default=999
    ).astype(int)

    return df_temp


# ============================================================
# 3. COLUNAS QUE AS DUAS VISÕES TÊM EM COMUM
# ============================================================

colunas_comuns = [
    "ufsigla",
    "EAP MACRO"
]


# ============================================================
# 4. CRIA A VISÃO DE CONTRATAÇÃO LOCAÇÃO
# ============================================================

df_contratacao = criar_visao_mensal(
    df=df,
    colunas_comuns=colunas_comuns,
    col_mes="contratação locação mês",
    col_score="contratação locação score",
    nome_etapa="Contratação Locação"
)


# ============================================================
# 5. CRIA A VISÃO DE RFI
# ============================================================

df_rfi = criar_visao_mensal(
    df=df,
    colunas_comuns=colunas_comuns,
    col_mes="RFI mês",
    col_score="RFI score",
    nome_etapa="RFI"
)


# ============================================================
# 6. JUNTA CONTRATAÇÃO E RFI
# ============================================================

df_visao = pd.concat(
    [
        df_contratacao,
        df_rfi
    ],
    ignore_index=True
)


# ============================================================
# 7. RESULTADO
# ============================================================

print(df_visao.head())
