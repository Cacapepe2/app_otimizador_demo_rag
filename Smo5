def _normalize(value):
    """Normaliza texto para comparacao/saida: sem acento, maiusculo e '_' entre palavras."""
    if pd.isna(value):
        return ''
    value = str(value).strip()
    if not value:
        return ''
    value = unicodedata.normalize('NFKD', value)
    value = ''.join(ch for ch in value if not unicodedata.combining(ch))
    value = value.upper()
    value = re.sub(r'[^A-Z0-9]+', '_', value)
    return value.strip('_')


def _normalize_key_piece(value):
    if pd.isna(value):
        return ''
    return str(value).strip().upper()


def _make_merge_key(cell, uf):
    cell = _normalize_key_piece(cell)
    uf = _normalize_key_piece(uf)
    if not cell or not uf:
        return ''
    return f'{cell}|{uf}'


def _make_city(row):
    # Regra solicitada: SIG_ESTADO + NOM_MUNICIPIO.
    uf = _normalize(row.get('SIG_ESTADO'))
    cidade = _normalize(row.get('NOM_MUNICIPIO'))
    if uf and cidade:
        return f'{uf}_{cidade}'
    return uf or cidade


def _build_region(state, area):
    # Regra solicitada usando SIG_ESTADO + DES_AREA_TARIFACAO (DDD).
    uf = _normalize(state)

    try:
        area_code = str(int(float(area)))
    except (TypeError, ValueError):
        area_code = re.sub(r'\D+', '', str(area)) if not pd.isna(area) else ''

    if uf in {'BA', 'SE'}:
        return 'BASE'
    if uf in {'RJ', 'ES'}:
        return 'RJES'
    if uf == 'MG':
        return 'MG'
    if uf == 'SP':
        return 'SPI' if area_code in {'12', '14', '19'} else 'SPC'
    if uf == 'RS':
        return 'RS'
    if uf in {'PR', 'SC'}:
        return 'PRSC'

    region_map = {
        'AM': 'N', 'RR': 'N', 'PA': 'N', 'MA': 'N', 'AP': 'N',
        'CE': 'NE', 'PI': 'NE', 'RN': 'NE', 'PE': 'NE', 'AL': 'NE', 'PB': 'NE',
        'MT': 'CO', 'DF': 'CO', 'RO': 'CO', 'MS': 'CO', 'AC': 'CO', 'TO': 'CO', 'GO': 'CO',
    }
    return region_map.get(uf, '')


def _series(df, column, default=np.nan):
    """Retorna a coluna ou uma Series vazia com o mesmo indice."""
    if column in df.columns:
        return df[column]
    return pd.Series(default, index=df.index)


def _first_existing_series(df, columns, default=np.nan):
    """Coalesce de colunas: usa o primeiro valor nao nulo encontrado por linha."""
    result = pd.Series(default, index=df.index)
    for column in columns:
        if column in df.columns:
            current = df[column]
            mask = result.isna() | result.astype('string').str.strip().eq('')
            result = result.where(~mask, current)
    return result


def _to_numeric(series):
    return pd.to_numeric(series, errors='coerce')


def _blank_mask(series):
    text = series.astype('string').str.strip()
    return series.isna() | text.eq('') | text.eq('<NA>') | text.str.lower().eq('nan')


def _clean_bandwidth(series):
    """Converte 100 MHz / 100 / 100M para o formato 100M."""
    s = series.astype('string').str.strip()
    s = s.str.replace(' ', '', regex=False)
    s = s.str.replace(r'(?i)MHZ$', 'M', regex=True)
    s = s.str.replace(r'(?i)HZ$', '', regex=True)
    s = s.str.replace(r'\.0(?=M?$)', '', regex=True)
    valid = ~(series.isna() | s.eq('') | s.eq('<NA>'))
    needs_m = valid & ~s.str.upper().str.endswith('M', na=False)
    s = s.where(~needs_m, s + 'M')
    return s.where(valid, np.nan)


def _clean_frequency_band_ericsson(series):
    """Converte [78] / 78 / N78 para N78."""
    s = series.astype('string').str.strip()
    s = s.str.replace('[', '', regex=False).str.replace(']', '', regex=False)
    s = s.str.replace(r'(?i)^N', '', regex=True)
    valid = ~(series.isna() | s.eq('') | s.eq('<NA>'))
    s = ('N' + s).where(valid, np.nan)
    return s


def _slot_assignment_huawei(series):
    """
    Huawei:
      Dual-period 8:2 Slot Assignment -> 8_2_DDDSUUDDDD
      4:1                         -> 4_1_DDDSU
    """
    def convert(value):
        if pd.isna(value):
            return np.nan
        match = re.search(r'(\d+)\s*:\s*(\d+)', str(value))
        if not match:
            return np.nan
        dl_slots = int(match.group(1))
        ul_slots = int(match.group(2))
        ratio = f'{dl_slots}_{ul_slots}'
        if (dl_slots, ul_slots) == (8, 2):
            return f'{ratio}_DDDSUUDDDD'
        if (dl_slots, ul_slots) == (4, 1):
            return f'{ratio}_DDDSU'
        # Para uma configuracao diferente das duas regras fornecidas,
        # mantem somente a razao para nao inventar uma estrutura de slots.
        return ratio

    return series.apply(convert)


def _gscn_to_narfcn_value(gscn):
    """
    Converte SSB Frequency Position (GSCN) para SsbNARFCN.

    Exemplos validados:
      5287 -> 422930
      7811 -> 629952
    """
    if pd.isna(gscn):
        return pd.NA

    try:
        g = int(float(gscn))
    except (TypeError, ValueError):
        return pd.NA

    if g < 0:
        return pd.NA

    # GSCN 0..7498: SSREF = N*1.2 MHz + M*0.05 MHz
    if g < 7499:
        remainder = g % 3
        if remainder == 0:
            m = 3
            n = g // 3
        elif remainder == 1:
            m = 5
            n = (g - 1) // 3
        else:
            m = 1
            n = (g + 1) // 3

        freq_mhz = n * 1.2 + m * 0.05
        narfcn = freq_mhz / 0.005

    # GSCN 7499..22256: SSREF = 3000 + (GSCN-7499)*1.44 MHz
    elif g <= 22256:
        freq_mhz = 3000 + (g - 7499) * 1.44
        narfcn = 600000 + (freq_mhz - 3000) / 0.015

    # Acima de 24.25008 GHz
    else:
        freq_mhz = 24250.08 + (g - 22256) * 17.28
        narfcn = 2016667 + (freq_mhz - 24250.08) / 0.06

    return int(round(narfcn))


def _gscn_to_narfcn(series):
    return pd.Series(
        [_gscn_to_narfcn_value(v) for v in series],
        index=series.index,
        dtype='Int64'
    )


def _dedupe_best_row(df, key_column, label):
    """
    Se houver duplicidade da chave de merge, mantem uma unica linha por chave.
    Como as duplicidades sao erros de cadastro com a mesma informacao, nenhum
    arquivo de diagnostico e enviado/salvo no SharePoint. A linha mais preenchida
    continua sendo priorizada apenas como protecao contra algum campo vazio.
    """
    if df.empty or key_column not in df.columns:
        return df

    duplicate_mask = df[key_column].ne('') & df[key_column].duplicated(keep=False)
    if duplicate_mask.any():
        duplicated = df.loc[duplicate_mask].copy()
        qtd_linhas = len(duplicated)
        qtd_chaves = duplicated[key_column].nunique(dropna=True)

        print(
            f'[AVISO] {label}: {qtd_chaves:,} chave(s) duplicada(s), '
            f'afetando {qtd_linhas:,} linha(s). '
            'Sera mantida somente uma linha por chave; nenhum diagnostico sera salvo.'
        )

    temp = df.copy()

    # Conta campos realmente preenchidos. String vazia tambem e considerada vazia.
    filled_count = pd.Series(0, index=temp.index, dtype='int64')
    for col in temp.columns:
        if col == key_column:
            continue
        filled_count += (~_blank_mask(temp[col])).astype('int64')

    temp['_nonnull_count'] = filled_count
    temp = temp.sort_values('_nonnull_count', ascending=False, kind='stable')
    temp = temp.drop_duplicates(subset=[key_column], keep='first')
    return temp.drop(columns=['_nonnull_count'])


def _prefix_vendor_columns(df, prefix):
    rename_map = {
        col: f'{prefix}__{col}'
        for col in df.columns
        if col != '_merge_key'
    }
    return df.rename(columns=rename_map)


def _prepare_science(science):
    science = science.copy()
    science['_merge_key'] = [
        _make_merge_key(cell, uf)
        for cell, uf in zip(science['SIG_LOGICA'], science['SIG_ESTADO'])
    ]
    science = science[science['_merge_key'].ne('')].copy()
    science = _dedupe_best_row(science, '_merge_key', 'SCIENCE_5G')
    return science


def _prepare_ericsson(ericsson):
    ericsson = ericsson.copy()

    if 'NRCellDUId' not in ericsson.columns or 'NodeId' not in ericsson.columns:
        raise KeyError("A base Ericsson precisa conter 'NRCellDUId' e 'NodeId'.")

    ericsson['_uf_key'] = ericsson['NodeId'].astype('string').str.strip().str[-2:]
    ericsson['_merge_key'] = [
        _make_merge_key(cell, uf)
        for cell, uf in zip(ericsson['NRCellDUId'], ericsson['_uf_key'])
    ]
    ericsson = ericsson[ericsson['_merge_key'].ne('')].copy()
    ericsson = _dedupe_best_row(ericsson, '_merge_key', 'ERICSSON_5G')
    ericsson = ericsson.drop(columns=['_uf_key'], errors='ignore')
    return _prefix_vendor_columns(ericsson, 'ER')


def _prepare_huawei(huawei):
    huawei = huawei.copy()

    if 'NR DU Cell Name' not in huawei.columns or 'Site Name' not in huawei.columns:
        raise KeyError("A base Huawei precisa conter 'NR DU Cell Name' e 'Site Name'.")

    huawei['_uf_key'] = huawei['Site Name'].astype('string').str.strip().str[-2:]
    huawei['_merge_key'] = [
        _make_merge_key(cell, uf)
        for cell, uf in zip(huawei['NR DU Cell Name'], huawei['_uf_key'])
    ]
    huawei = huawei[huawei['_merge_key'].ne('')].copy()
    huawei = _dedupe_best_row(huawei, '_merge_key', 'HUAWEI_5G')
    huawei = huawei.drop(columns=['_uf_key'], errors='ignore')
    return _prefix_vendor_columns(huawei, 'HW')


def _build_unified_base(science, ericsson, huawei):
    """
    Faz os merges pelas chaves definidas nos comentarios:
      Science: SIG_LOGICA + SIG_ESTADO
      Ericsson: NRCellDUId + UF (2 ultimos caracteres de NodeId)
      Huawei: NR DU Cell Name + UF (2 ultimos caracteres de Site Name)

    Mantem somente as celulas NR ativas do Science que possuem casamento com
    Ericsson ou Huawei. Uma celula antiga que nao esta mais no Science ativo, ou
    que nao possui vendor casado, nao entra na saida atualizada.
    """
    science = _prepare_science(science)
    ericsson = _prepare_ericsson(ericsson)
    huawei = _prepare_huawei(huawei)

    er = science.merge(ericsson, on='_merge_key', how='inner')
    er['_VENDOR_SOURCE'] = 'ERICSSON'

    hw = science.merge(huawei, on='_merge_key', how='inner')
    hw['_VENDOR_SOURCE'] = 'HUAWEI'

    er_keys = set(er['_merge_key'])
    hw_keys = set(hw['_merge_key'])
    overlap = er_keys & hw_keys
    if overlap:
        print(f'[AVISO] {len(overlap)} chave(s) apareceram nas duas bases de vendor. '
              'Sera escolhida a linha com maior quantidade de campos preenchidos.')

    matched = pd.concat([er, hw], ignore_index=True, sort=False)
    if not matched.empty:
        matched['_vendor_nonnull'] = matched.notna().sum(axis=1)
        matched = matched.sort_values('_vendor_nonnull', ascending=False)
        matched = matched.drop_duplicates(subset=['_merge_key'], keep='first')
        matched = matched.drop(columns=['_vendor_nonnull'])

    matched_keys = set(matched['_merge_key']) if not matched.empty else set()
    unmatched = science[~science['_merge_key'].isin(matched_keys)].copy()

    # Regra solicitada: celulas do Science sem casamento com Ericsson/Huawei
    # nao devem fazer parte nem do Excel atualizado nem da tabela do banco.
    unified = matched.reset_index(drop=True)

    print(f'[INFO] Science ativo NR: {len(science):,}')
    print(f'[INFO] Casados com Ericsson: {len(er):,}')
    print(f'[INFO] Casados com Huawei: {len(hw):,}')
    print(f'[INFO] Sem casamento de vendor (EXCLUIDOS): {len(unmatched):,}')
    print(f'[INFO] Total apos filtro de vendor: {len(unified):,}')

    return unified


