def _populate_template(base):
    out = pd.DataFrame(index=base.index, columns=TEMPLATE_COLUMNS)

    # --------------------------------------------------------
    # CAMPOS COMUNS / SCIENCE
    # --------------------------------------------------------
    sig_erb = _series(base, 'SIG_ERB').astype('string').str.strip()
    sig_estado = _series(base, 'SIG_ESTADO').astype('string').str.strip().str.upper()
    valid_gnb_name = ~(sig_erb.isna() | sig_estado.isna() | sig_erb.eq('') | sig_estado.eq(''))
    out['gNodeB Name'] = (sig_erb + '_' + sig_estado).where(valid_gnb_name, np.nan)

    out['Cell Name'] = _series(base, 'SIG_LOGICA').astype('string').str.strip()

    # TAC vem diretamente do Science (NUM_TAC) e vale para Ericsson e Huawei.
    out['TAC'] = _to_numeric(_series(base, 'NUM_TAC'))

    # Latitude/Longitude ficam numericos. Em Excel PT-BR, o separador decimal e exibido como virgula.
    out['Latitude'] = _to_numeric(_series(base, 'NUM_LATITUDE_DECIMAL'))
    out['Longitude'] = _to_numeric(_series(base, 'NUM_LONGITUDE_DECIMAL'))
    out['Height'] = _to_numeric(_series(base, 'NUM_ALTURA'))
    out['Azimuth'] = _to_numeric(_series(base, 'NUM_AZIMUTE_ANTENA'))
    out['Mechanical Downtilt'] = _to_numeric(_series(base, 'NUM_TILT_MECAN_ANTENA'))
    out['Antenna Model'] = _series(base, 'DES_MODELO_ANTENA')

    # isOutdoor: O/OUTDOOR = YES; qualquer outro valor = NO.
    coverage = _series(base, 'STS_COBERTURA').astype('string').str.upper().str.strip()
    out['isOutdoor'] = np.where(coverage.isin(['O', 'OUTDOOR']), 'YES', 'NO')

    antenna_model = out['Antenna Model'].astype('string')
    out['Sectorization'] = np.where(
        antenna_model.str.contains('OMNI', case=False, na=False),
        'OMNI',
        'SECTORIZE'
    )

    cgi = _series(base, '[C]CGI').astype('string')
    cgi_parts = cgi.str.split('-', expand=True)
    if cgi_parts.shape[1] >= 1:
        out['MCC'] = cgi_parts[0]
    if cgi_parts.shape[1] >= 2:
        out['MNC'] = cgi_parts[1]

    out['Active'] = 'YES'
    out['City'] = base.apply(_make_city, axis=1)
    out['Region'] = base.apply(
        lambda row: _build_region(row.get('SIG_ESTADO'), row.get('DES_AREA_TARIFACAO')),
        axis=1
    )

    sector = out['Cell Name'].astype('string').str[-1]
    out['SectorID'] = sector.apply(
        lambda x: int(x) if pd.notna(x) and str(x).isdigit() else (np.nan if pd.isna(x) else x)
    )

    out['Vendor'] = _series(base, '_VENDOR_SOURCE')

    # --------------------------------------------------------
    # ERICSSON
    # --------------------------------------------------------
    er_mask = _series(base, '_VENDOR_SOURCE').eq('ERICSSON')

    er_gnb_id = _series(base, 'ER__gNBId')
    er_cell_id = _series(base, 'ER__cellLocalId')
    er_pci = _series(base, 'ER__nRPCI')
    er_dl_narfcn = _series(base, 'ER__arfcnDL')

    out.loc[er_mask, 'gNodeB ID'] = er_gnb_id[er_mask]
    out.loc[er_mask, 'Cell ID'] = er_cell_id[er_mask]
    out.loc[er_mask, 'PCI'] = er_pci[er_mask]
    out.loc[er_mask, 'DLNARFCN'] = er_dl_narfcn[er_mask]

    er_duplex = _series(base, 'ER__tddSpecialSlotPattern').astype('string').str.strip().str[:3].str.upper()
    er_duplex_valid = er_mask & ~_blank_mask(er_duplex)
    out.loc[er_duplex_valid, 'Duplex Model'] = 'CELL_' + er_duplex[er_duplex_valid]

    er_band = _clean_frequency_band_ericsson(_series(base, 'ER__bandListManual'))
    out.loc[er_mask, 'Frequency Band'] = er_band[er_mask]

    er_ul_bw = _clean_bandwidth(_series(base, 'ER__bSChannelBwUL'))
    er_dl_bw = _clean_bandwidth(_series(base, 'ER__bSChannelBwDL'))
    out.loc[er_mask, 'UlBandWidth'] = er_ul_bw[er_mask]
    out.loc[er_mask, 'DlBandWidth'] = er_dl_bw[er_mask]

    # Ericsson: SlotAssignment permanece vazio conforme comentario do TXT.
    er_ssb = _to_numeric(_series(base, 'ER__ssbFrequency'))
    out.loc[er_mask, 'SsbNARFCN'] = er_ssb[er_mask]

    # --------------------------------------------------------
    # HUAWEI
    # --------------------------------------------------------
    hw_mask = _series(base, '_VENDOR_SOURCE').eq('HUAWEI')

    # Huawei: o campo gNodeB ID possui exatamente este nome na tabela.
    # A coluna NR DU Cell Name e usada apenas na chave/celula, nao como gNodeB ID.
    hw_gnb_id = _series(base, 'HW__gNodeB ID')
    hw_cell_id = _series(base, 'HW__Cell ID')
    hw_pci = _series(base, 'HW__Physical Cell ID')
    hw_dl_narfcn = _series(base, 'HW__Downlink NARFCN')

    out.loc[hw_mask, 'gNodeB ID'] = hw_gnb_id[hw_mask]
    out.loc[hw_mask, 'Cell ID'] = hw_cell_id[hw_mask]
    out.loc[hw_mask, 'PCI'] = hw_pci[hw_mask]
    out.loc[hw_mask, 'DLNARFCN'] = hw_dl_narfcn[hw_mask]

    hw_duplex = _series(base, 'HW__Duplex Mode').astype('string').str.strip().str.upper()
    hw_duplex_valid = hw_mask & ~_blank_mask(hw_duplex)
    out.loc[hw_duplex_valid, 'Duplex Model'] = 'CELL_' + hw_duplex[hw_duplex_valid]

    out.loc[hw_mask, 'Frequency Band'] = _series(base, 'HW__Frequency Band')[hw_mask]

    hw_ul_bw = _clean_bandwidth(_series(base, 'HW__Uplink Bandwidth'))
    hw_dl_bw = _clean_bandwidth(_series(base, 'HW__Downlink Bandwidth'))
    out.loc[hw_mask, 'UlBandWidth'] = hw_ul_bw[hw_mask]
    out.loc[hw_mask, 'DlBandWidth'] = hw_dl_bw[hw_mask]

    hw_slot = _slot_assignment_huawei(_series(base, 'HW__Slot Assignment'))
    out.loc[hw_mask, 'SlotAssignment'] = hw_slot[hw_mask]

    # Huawei: SSB Frequency Position = GSCN; dele calculamos o SsbNARFCN.
    hw_gscn = _to_numeric(_series(base, 'HW__SSB Frequency Position'))
    out.loc[hw_mask, 'GSCN'] = hw_gscn[hw_mask]
    hw_ssb_narfcn = _gscn_to_narfcn(hw_gscn)
    out.loc[hw_mask, 'SsbNARFCN'] = hw_ssb_narfcn[hw_mask]

    # Garante exatamente as 106 colunas e exatamente a ordem do template.
    out = out.reindex(columns=TEMPLATE_COLUMNS)
    return out


# ============================================================
# ATUALIZACAO DO EXCEL EXISTENTE SEM ALTERAR O ORIGINAL
# ============================================================
def _excel_key(df):
    gnb = df['gNodeB Name'].astype('string').str.strip().str.upper()
    cell = df['Cell Name'].astype('string').str.strip().str.upper()
    valid = ~(gnb.isna() | cell.isna() | gnb.eq('') | cell.eq(''))
    key = gnb.fillna('') + '|' + cell.fillna('')
    return key.where(valid, '')


def _align_old_excel_columns(old_df):
    old_df = old_df.copy()
    for col in TEMPLATE_COLUMNS:
        if col not in old_df.columns:
            old_df[col] = np.nan
    return old_df.reindex(columns=TEMPLATE_COLUMNS)


def _merge_with_existing_excel(current_df):
    """
    Usa gNodeB Name + Cell Name como chave.

    - O conjunto de linhas da saida e o Science NR ativo atual.
    - Linhas que existiam no Excel antigo mas nao existem mais no Science ativo sao removidas.
    - Valores recalculados/preenchidos pela base nova atualizam o Excel.
    - Se uma coluna nova vier vazia, preserva o valor antigo daquela celula.
    - O arquivo original nunca e sobrescrito.
    """
    if not os.path.exists(arquivo_original):
        raise FileNotFoundError(f'Arquivo original nao encontrado: {arquivo_original}')

    old_df = pd.read_excel(arquivo_original, sheet_name=0)
    old_df = _align_old_excel_columns(old_df)

    current = current_df.copy()
    current['_excel_key'] = _excel_key(current)
    old_df['_excel_key'] = _excel_key(old_df)

    current = current[current['_excel_key'].ne('')].copy()
    old_df = old_df[old_df['_excel_key'].ne('')].copy()

    current = _dedupe_best_row(current, '_excel_key', 'BASE_ATUAL_GERADA')
    old_df = _dedupe_best_row(old_df, '_excel_key', 'EXCEL_ANTIGO')

    merged = current.merge(
        old_df,
        on='_excel_key',
        how='left',
        suffixes=('', '__old')
    )

    # gNodeB Name e Cell Name sempre ficam com os valores atuais.
    key_columns = {'gNodeB Name', 'Cell Name'}

    for col in TEMPLATE_COLUMNS:
        old_col = f'{col}__old'
        if col in key_columns or old_col not in merged.columns:
            continue

        # Pandas recente pode criar colunas com dtype string estrito. O Excel antigo
        # pode ter numero/float nessa mesma coluna. Converter ambos para object evita
        # o erro: TypeError: Invalid value for dtype 'str'.
        atual = merged[col].astype(object)
        antigo = merged[old_col].astype(object)
        blank = _blank_mask(atual)

        # Valor atual preenchido tem prioridade. Se estiver vazio, preserva o antigo.
        merged[col] = atual.where(~blank, antigo)

    result = merged.reindex(columns=TEMPLATE_COLUMNS)
    return result


def _save_updated_excel(df):
    os.makedirs(pasta_destino_analises, exist_ok=True)

    # Mantem o nome da primeira aba do arquivo original.
    excel_file = pd.ExcelFile(arquivo_original)
    sheet_name = excel_file.sheet_names[0] if excel_file.sheet_names else 'Engineering Parameters'

    # IMPORTANTE: grava em _atualizado; o EngineeringParameters_0.xlsx original nao e alterado.
    df.to_excel(arquivo_atualizado, index=False, sheet_name=sheet_name)
    print(f'[OK] Excel atualizado criado em: {arquivo_atualizado}')


# ============================================================
# BASE DO BANCO / BI
# ============================================================
def _build_bank_output(atualizado, unified):
    """
    Mantem o Excel exatamente com as colunas do TEMPLATE_COLUMNS, mas acrescenta
    no BANCO campos auxiliares do Science para filtros e analises do BI.

    Chave: gNodeB Name + Cell Name.
    """
    banco_df = atualizado.copy()
    banco_df['_excel_key'] = _excel_key(banco_df)

    aux = pd.DataFrame(index=unified.index)

    sig_erb = _series(unified, 'SIG_ERB').astype('string').str.strip()
    sig_estado = _series(unified, 'SIG_ESTADO').astype('string').str.strip().str.upper()
    valid_gnb = ~(sig_erb.isna() | sig_estado.isna() | sig_erb.eq('') | sig_estado.eq(''))

    aux['gNodeB Name'] = (sig_erb + '_' + sig_estado).where(valid_gnb, np.nan)
    aux['Cell Name'] = _series(unified, 'SIG_LOGICA').astype('string').str.strip()

    for col in BANCO_EXTRA_COLUMNS:
        aux[col] = _series(unified, col)

    aux['_excel_key'] = _excel_key(aux)
    aux = aux[aux['_excel_key'].ne('')].copy()

    # O Science ja foi deduplicado antes dos merges. Este drop_duplicates e apenas
    # uma ultima protecao para garantir relacao 1:1 na inclusao dos campos do BI.
    aux = aux.drop_duplicates(subset=['_excel_key'], keep='first')

    banco_df = banco_df.merge(
        aux[['_excel_key'] + BANCO_EXTRA_COLUMNS],
        on='_excel_key',
        how='left',
        validate='one_to_one'
    )

    banco_df = banco_df.drop(columns=['_excel_key'])

    # Ordem no banco: primeiro as 106 colunas oficiais do template e, depois,
    # os campos extras usados pelo BI.
    return banco_df.reindex(columns=TEMPLATE_COLUMNS + BANCO_EXTRA_COLUMNS)


