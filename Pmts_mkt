# ============================================================
# 1. CARREGAR MKT
# ============================================================

def carregar_mkt_excel(
    caminho,
    aba='Sheet1'
):

    print('Lendo base MKT...')

    df = pd.read_excel(
        caminho,
        sheet_name=aba
    )

    print(
        f'{len(df):,} linhas carregadas.'
    )

    return df


# ============================================================
# 2. NORMALIZAR NOMES DAS COLUNAS
# ============================================================

def normalizar_colunas_mkt(df):

    mkt = df.copy()

    novas_colunas = []

    for coluna in mkt.columns:

        coluna = str(coluna).strip()

        # Exemplo:
        # PMTS_RF.VALID_ATIVACAO
        # vira:
        # VALID_ATIVACAO

        if '.' in coluna:
            coluna = coluna.split('.')[-1]

        novas_colunas.append(
            coluna.strip()
        )

    mkt.columns = novas_colunas

    return mkt


# ============================================================
# 3. NORMALIZAR CHAVES
# ============================================================

def normalizar_chaves(df):

    resultado = df.copy()

    for coluna in [
        'UID_IDPMTS',
        'UID_UFSIGLA'
    ]:

        if coluna in resultado.columns:

            resultado[coluna] = (
                resultado[coluna]
                .astype('string')
                .str.strip()
                .str.upper()
            )

    return resultado


# ============================================================
# 4. PREPARAR MKT
# ============================================================

def preparar_mkt(df):

    mkt = normalizar_colunas_mkt(df)

    mkt = normalizar_chaves(mkt)

    # ----------------------------------------------
    # Ativação segundo MKT
    # ----------------------------------------------

    if 'VALID_ATIVACAO' in mkt.columns:

        mkt['FLAG_ATIVO_MKT'] = (

            mkt['VALID_ATIVACAO']
            .astype('string')
            .str.strip()
            .str.upper()
            .eq('[S]')
        )

    else:

        mkt['FLAG_ATIVO_MKT'] = False

        print(
            'ATENÇÃO: VALID_ATIVACAO '
            'não encontrada na base MKT.'
        )

    return mkt


# ============================================================
# 5. NOSSA BASE SN
# ============================================================

def preparar_nosso_sn(snapshot):

    nosso = snapshot[
        snapshot['FLAG_SN']
    ].copy()

    nosso = normalizar_chaves(nosso)

    return nosso


# ============================================================
# 6. COMPARAÇÃO POR SITE
# ============================================================

def comparar_sites(nosso, mkt):

    sites_nosso = set(
        nosso['UID_UFSIGLA']
        .dropna()
        .unique()
    )

    sites_mkt = set(
        mkt['UID_UFSIGLA']
        .dropna()
        .unique()
    )

    comuns = (
        sites_nosso
        &
        sites_mkt
    )

    somente_pmts = (
        sites_nosso
        -
        sites_mkt
    )

    somente_mkt = (
        sites_mkt
        -
        sites_nosso
    )

    return (
        sites_nosso,
        sites_mkt,
        comuns,
        somente_pmts,
        somente_mkt
    )


# ============================================================
# 7. COMPARAÇÃO POR OBRA / IDPMTS
# ============================================================

def comparar_obras(nosso, mkt):

    obras_nosso = set(
        nosso['UID_IDPMTS']
        .dropna()
        .unique()
    )

    obras_mkt = set(
        mkt['UID_IDPMTS']
        .dropna()
        .unique()
    )

    comuns = (
        obras_nosso
        &
        obras_mkt
    )

    somente_pmts = (
        obras_nosso
        -
        obras_mkt
    )

    somente_mkt = (
        obras_mkt
        -
        obras_nosso
    )

    return (
        obras_nosso,
        obras_mkt,
        comuns,
        somente_pmts,
        somente_mkt
    )


# ============================================================
# 8. TABELA DE RECONCILIAÇÃO POR SITE
# ============================================================

def montar_reconciliacao_sites(
    nosso,
    mkt
):

    nosso_sites = (
        nosso[
            [
                'UID_UFSIGLA',
                'UID_IDPMTS',
                'ENG_OBJ_MACRO',
                'MASTEROBRA_OBJ_ENG',
                'PMO_REGIONAL',
                'PMO_UF',
                'REGIONAL_BASELINE_ATIVACAO',
                'PMO_CARIMBO_BASELINE',
                'PMO_CARIMBO_CENTRALIZADO',
                'COMPETENCIA',
                'EAP_AUTOMATICA',
                'VALID_ATIVACAO',
                'FLAG_ATIVO_EAP',
                'FLAG_ATIVO_VALID'
            ]
        ]
        .copy()
    )

    # Pode haver mais de uma obra por site.
    # Primeiro criamos presença por site.

    lista_sites = sorted(
        set(
            nosso['UID_UFSIGLA']
            .dropna()
        )
        |
        set(
            mkt['UID_UFSIGLA']
            .dropna()
        )
    )

    reconciliacao = pd.DataFrame({
        'UID_UFSIGLA': lista_sites
    })

    sites_nosso = set(
        nosso['UID_UFSIGLA']
        .dropna()
    )

    sites_mkt = set(
        mkt['UID_UFSIGLA']
        .dropna()
    )

    reconciliacao['PMTS_SN'] = (
        reconciliacao[
            'UID_UFSIGLA'
        ]
        .isin(sites_nosso)
    )

    reconciliacao['MKT_SN'] = (
        reconciliacao[
            'UID_UFSIGLA'
        ]
        .isin(sites_mkt)
    )

    reconciliacao['STATUS_ESCOPO'] = 'COMUM'

    reconciliacao.loc[
        (
            reconciliacao['PMTS_SN']
            &
            ~reconciliacao['MKT_SN']
        ),
        'STATUS_ESCOPO'
    ] = 'SOMENTE PMTS'

    reconciliacao.loc[
        (
            ~reconciliacao['PMTS_SN']
            &
            reconciliacao['MKT_SN']
        ),
        'STATUS_ESCOPO'
    ] = 'SOMENTE MKT'

    return reconciliacao


# ============================================================
# 9. COMPARAR ATIVAÇÃO NO MESMO IDPMTS
# ============================================================

def comparar_ativacao_pmts_mkt(
    nosso,
    mkt
):

    colunas_mkt = [
        'UID_IDPMTS',
        'UID_UFSIGLA',
        'VALID_ATIVACAO',
        'FLAG_ATIVO_MKT'
    ]

    # Só usa colunas existentes.
    colunas_mkt = [
        c for c in colunas_mkt
        if c in mkt.columns
    ]

    base_mkt = (
        mkt[colunas_mkt]
        .drop_duplicates(
            subset=['UID_IDPMTS']
        )
        .copy()
    )

    base_pmts = (
        nosso[
            [
                'UID_IDPMTS',
                'UID_UFSIGLA',
                'EAP_AUTOMATICA',
                'VALID_ATIVACAO',
                'FLAG_ATIVO_EAP',
                'FLAG_ATIVO_VALID'
            ]
        ]
        .drop_duplicates(
            subset=['UID_IDPMTS']
        )
        .copy()
    )

    comparacao = base_pmts.merge(
        base_mkt,
        on='UID_IDPMTS',
        how='inner',
        suffixes=(
            '_PMTS',
            '_MKT'
        )
    )

    comparacao[
        'EAP_IGUAL_VALID_MKT'
    ] = (

        comparacao[
            'FLAG_ATIVO_EAP'
        ]
        ==
        comparacao[
            'FLAG_ATIVO_MKT'
        ]
    )

    comparacao[
        'STATUS_ATIVACAO'
    ] = comparacao[
        'EAP_IGUAL_VALID_MKT'
    ].map({
        True: 'OK',
        False: 'DIVERGÊNCIA'
    })

    return comparacao


# ============================================================
# 10. DETALHAMENTO DOS SITES DIVERGENTES
# ============================================================

def detalhar_divergencias(
    nosso,
    mkt,
    somente_pmts,
    somente_mkt
):

    detalhe_pmts = nosso[
        nosso[
            'UID_UFSIGLA'
        ].isin(somente_pmts)
    ].copy()

    detalhe_pmts[
        'ORIGEM_DIVERGENCIA'
    ] = 'SOMENTE PMTS'


    detalhe_mkt = mkt[
        mkt[
            'UID_UFSIGLA'
        ].isin(somente_mkt)
    ].copy()

    detalhe_mkt[
        'ORIGEM_DIVERGENCIA'
    ] = 'SOMENTE MKT'

    return (
        detalhe_pmts,
        detalhe_mkt
    )


