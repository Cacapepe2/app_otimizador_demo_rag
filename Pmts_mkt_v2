# ============================================================
# 8. EAP x VALID_ATIVACAO
# ============================================================

def validar_eap_vs_valid(snapshot):

    resultado = (

        snapshot

        .groupby(
            [
                'FLAG_ATIVO_EAP',
                'FLAG_ATIVO_VALID'
            ],
            dropna=False
        )

        .agg(

            OBRAS=(
                'UID_IDPMTS',
                'nunique'
            ),

            IDENG=(
                'UID_IDENG',
                'nunique'
            ),

            SITES=(
                'UID_UFSIGLA',
                'nunique'
            )
        )

        .reset_index()
    )

    resultado[
        'STATUS'
    ] = (

        resultado[
            'FLAG_ATIVO_EAP'
        ]

        ==

        resultado[
            'FLAG_ATIVO_VALID'
        ]
    )

    resultado[
        'STATUS'
    ] = (

        resultado[
            'STATUS'
        ]

        .map({
            True: 'OK',
            False: 'DIVERGÊNCIA'
        })
    )

    return resultado


# ============================================================
# 9. SNAPSHOT JÁ EXISTE?
# ============================================================

def snapshot_ja_existe():

    hoje = (
        pd.Timestamp.now()
        .normalize()
    )

    try:

        historico = c.read_sql(
            DATABASE_HISTORICO,
            TABELA_SNAPSHOT,
            BANCO_ORIGEM,
            colunas='DATA_SNAPSHOT'
        )

        if historico.empty:
            return False

        historico[
            'DATA_SNAPSHOT'
        ] = pd.to_datetime(
            historico[
                'DATA_SNAPSHOT'
            ],
            errors='coerce'
        )

        return (

            historico[
                'DATA_SNAPSHOT'
            ]

            .dt.normalize()

            .eq(hoje)

            .any()
        )

    except Exception:

        # Primeira execução
        return False


# ============================================================
# 10. SALVAR SNAPSHOT
# ============================================================

def salvar_snapshot(
    snapshot,
    force=False
):

    if (
        snapshot_ja_existe()
        and not force
    ):

        print(
            '\nATENÇÃO: '
            'já existe snapshot hoje.'
        )

        print(
            'Nada foi inserido novamente.'
        )

        return False

    print(
        '\nSalvando snapshot no banco...'
    )

    c.to_sql(
        snapshot,
        DATABASE_HISTORICO,
        TABELA_SNAPSHOT,
        'prod',
        normalize=True,
        existente='append'
    )

    print(
        'Snapshot salvo com sucesso.'
    )

    return True


# ============================================================
# 11. RESUMO
# ============================================================

def criar_resumo(snapshot):

    indicadores = {

        'SITE NOVO':
            'FLAG_SN',

        'AMPLIAÇÃO FÍSICA':
            'FLAG_AMPLIACAO_FISICA',

        'AMPLIAÇÃO LÓGICA':
            'FLAG_AMPLIACAO_LOGICA'
    }

    dados = []

    for nome, flag in indicadores.items():

        df = snapshot[
            snapshot[flag]
        ].copy()

        dados.append({

            'INDICADOR':
                nome,

            'TOTAL_OBRAS':
                df[
                    'UID_IDPMTS'
                ].nunique(),

            'TOTAL_IDENG':
                df[
                    'UID_IDENG'
                ].nunique(),

            'TOTAL_SITES':
                df[
                    'UID_UFSIGLA'
                ].nunique(),

            'ATIVOS_EAP_OBRAS':
                df.loc[
                    df[
                        'FLAG_ATIVO_EAP'
                    ],
                    'UID_IDPMTS'
                ].nunique(),

            'ATIVOS_EAP_SITES':
                df.loc[
                    df[
                        'FLAG_ATIVO_EAP'
                    ],
                    'UID_UFSIGLA'
                ].nunique(),

            'ATIVOS_VALID_OBRAS':
                df.loc[
                    df[
                        'FLAG_ATIVO_VALID'
                    ],
                    'UID_IDPMTS'
                ].nunique(),

            'ATIVOS_VALID_SITES':
                df.loc[
                    df[
                        'FLAG_ATIVO_VALID'
                    ],
                    'UID_UFSIGLA'
                ].nunique(),

            'DIVERGENCIA_ATIVACAO_OBRAS':
                df.loc[
                    df[
                        'DIVERGENCIA_ATIVACAO'
                    ],
                    'UID_IDPMTS'
                ].nunique(),

            'DIVERGENCIA_ATIVACAO_SITES':
                df.loc[
                    df[
                        'DIVERGENCIA_ATIVACAO'
                    ],
                    'UID_UFSIGLA'
                ].nunique(),

            'DATA_SNAPSHOT':
                snapshot[
                    'DATA_SNAPSHOT'
                ].iloc[0]
        })

    return pd.DataFrame(
        dados
    )


# ============================================================
# 12. RESUMO POR COMPETÊNCIA
# ============================================================

def resumo_por_competencia(snapshot):

    resultados = []

    configuracoes = {

        'SITE NOVO':
            'FLAG_SN',

        'AMPLIAÇÃO FÍSICA':
            'FLAG_AMPLIACAO_FISICA',

        'AMPLIAÇÃO LÓGICA':
            'FLAG_AMPLIACAO_LOGICA'
    }

    for indicador, flag in configuracoes.items():

        df = snapshot[
            snapshot[flag]
        ].copy()

        total = (

            df.groupby(
                'COMPETENCIA',
                dropna=False
            )

            .agg(

                OBRAS=(
                    'UID_IDPMTS',
                    'nunique'
                ),

                IDENG=(
                    'UID_IDENG',
                    'nunique'
                ),

                SITES=(
                    'UID_UFSIGLA',
                    'nunique'
                )
            )

            .reset_index()
        )

        ativos_eap = (

            df[
                df[
                    'FLAG_ATIVO_EAP'
                ]
            ]

            .groupby(
                'COMPETENCIA',
                dropna=False
            )

            .agg(

                ATIVOS_EAP_OBRAS=(
                    'UID_IDPMTS',
                    'nunique'
                ),

                ATIVOS_EAP_SITES=(
                    'UID_UFSIGLA',
                    'nunique'
                )
            )

            .reset_index()
        )

        ativos_valid = (

            df[
                df[
                    'FLAG_ATIVO_VALID'
                ]
            ]

            .groupby(
                'COMPETENCIA',
                dropna=False
            )

            .agg(

                ATIVOS_VALID_OBRAS=(
                    'UID_IDPMTS',
                    'nunique'
                ),

                ATIVOS_VALID_SITES=(
                    'UID_UFSIGLA',
                    'nunique'
                )
            )

            .reset_index()
        )

        agrupado = (

            total

            .merge(
                ativos_eap,
                on='COMPETENCIA',
                how='left'
            )

            .merge(
                ativos_valid,
                on='COMPETENCIA',
                how='left'
            )
        )

        agrupado.insert(
            0,
            'INDICADOR',
            indicador
        )

        resultados.append(
            agrupado
        )

    return (

        pd.concat(
            resultados,
            ignore_index=True
        )

        .fillna(0)
    )


