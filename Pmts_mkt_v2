# ============================================================
# 1. LEITURA DA PMTS
# ============================================================

def I_PMTS():

    colunas = ', '.join(
        COLUNAS_PMTS
    )

    print('Lendo PMTS...')

    pmts = c.read_sql(
        DATABASE_ORIGEM,
        TABELA_ORIGEM,
        BANCO_ORIGEM,
        colunas=colunas
    )

    print(
        f'{len(pmts):,} linhas carregadas.'
    )

    return pmts


# ============================================================
# 2. TRATAMENTO
# ============================================================

def tratar_pmts(pmts):

    df = pmts.copy()

    # --------------------------------------------------------
    # DATAS
    # --------------------------------------------------------

    colunas_data = [
        'REGIONAL_BASELINE_ATIVACAO',
        'PMO_CARIMBO_BASELINE',
        'PMO_CARIMBO_CENTRALIZADO'
    ]

    for coluna in colunas_data:

        df[coluna] = pd.to_datetime(
            df[coluna],
            errors='coerce'
        )

    # --------------------------------------------------------
    # NORMALIZAÇÃO DAS CHAVES
    # --------------------------------------------------------

    for coluna in [
        'UID_IDPMTS',
        'UID_IDENG',
        'UID_UFSIGLA'
    ]:

        df[coluna] = (
            df[coluna]
            .astype('string')
            .str.strip()
            .str.upper()
        )

    # --------------------------------------------------------
    # COMPETÊNCIA
    # --------------------------------------------------------

    df['COMPETENCIA'] = (
        df[
            'PMO_CARIMBO_CENTRALIZADO'
        ]
        .dt.to_period('M')
        .astype('string')
    )

    # --------------------------------------------------------
    # ANO
    # --------------------------------------------------------

    df[
        'ANO_CARIMBO_CENTRALIZADO'
    ] = (

        df[
            'PMO_CARIMBO_CENTRALIZADO'
        ]

        .dt.year

        .astype('Int64')
    )

    # --------------------------------------------------------
    # FLAG ORIGINAL DE FINALIZAÇÃO
    # --------------------------------------------------------

    df['FLAG_FINALIZADA'] = (
        df['EAP_AUTOMATICA']
        .isin(EAP_FINALIZADA)
    )

    return df


# ============================================================
# 3. REGRA SITES NOVOS
# ============================================================

def regra_sn(df):

    return (

        df[
            'MASTERSITE_COBERTURA'
        ]
        .isin(COBERTURAS_SN)

        &

        df[
            'MASTEROBRA_STATUS_ROLLOUT'
        ]
        .isin(STATUS_ROLLOUT_SN)

        &

        df[
            'PMO_ROLLOUT_OVBK'
        ]
        .eq('ORCAMENTO')

        &

        df[
            'PMO_TIPO_INTERV'
        ]
        .isin(TIPOS_INTERVENCAO_SN)

        &

        ~df[
            'MASTEROBRA_OBJ_ENG'
        ]
        .isin(
            OBJETIVOS_ENG_EXCLUIDOS_SN
        )

        &

        df[
            'PMO_CARIMBO_CENTRALIZADO'
        ]
        .dt.year
        .isin(ANOS_SN)
    )


# ============================================================
# 4. REGRA AMPLIAÇÃO FÍSICA
# ============================================================

def regra_ampliacao_fisica(df):

    return (

        df[
            'PMO_ROLLOUT_OVBK'
        ]
        .eq('ORCAMENTO')

        &

        df[
            'PMO_TIPO_INTERV'
        ]
        .isin(
            TIPOS_INTERVENCAO_AMPLIACAO
        )

        &

        df[
            'PMO_ESCOPO_META'
        ]
        .eq('FÍSICA')

        &

        df[
            'PMO_CARIMBO_CENTRALIZADO'
        ]
        .dt.year
        .eq(ANO_ATUAL)
    )


# ============================================================
# 5. REGRA AMPLIAÇÃO LÓGICA
# ============================================================

def regra_ampliacao_logica(df):

    return (

        df[
            'PMO_ROLLOUT_OVBK'
        ]
        .eq('ORCAMENTO')

        &

        df[
            'PMO_TIPO_INTERV'
        ]
        .isin(
            TIPOS_INTERVENCAO_AMPLIACAO
        )

        &

        df[
            'PMO_ESCOPO_META'
        ]
        .eq('LÓGICA')

        &

        df[
            'PMO_CARIMBO_CENTRALIZADO'
        ]
        .dt.year
        .eq(ANO_ATUAL)
    )


# ============================================================
# 6. PREPARAR SNAPSHOT
# ============================================================

def preparar_snapshot(pmts):

    snapshot = tratar_pmts(
        pmts
    )

    # --------------------------------------------------------
    # CLASSIFICAÇÕES
    # --------------------------------------------------------

    snapshot['FLAG_SN'] = (
        regra_sn(snapshot)
    )

    snapshot[
        'FLAG_AMPLIACAO_FISICA'
    ] = (
        regra_ampliacao_fisica(
            snapshot
        )
    )

    snapshot[
        'FLAG_AMPLIACAO_LOGICA'
    ] = (
        regra_ampliacao_logica(
            snapshot
        )
    )

    # --------------------------------------------------------
    # ATIVAÇÃO - EAP
    # --------------------------------------------------------

    snapshot[
        'FLAG_ATIVO_EAP'
    ] = (

        snapshot[
            'EAP_AUTOMATICA'
        ]

        .isin(
            EAP_FINALIZADA
        )
    )

    # --------------------------------------------------------
    # ATIVAÇÃO - VALID_ATIVACAO
    # --------------------------------------------------------

    snapshot[
        'FLAG_ATIVO_VALID'
    ] = (

        snapshot[
            'VALID_ATIVACAO'
        ]

        .astype('string')

        .str.strip()

        .str.upper()

        .eq('[S]')
    )

    # --------------------------------------------------------
    # EAP x VALID
    # --------------------------------------------------------

    snapshot[
        'DIVERGENCIA_ATIVACAO'
    ] = (

        snapshot[
            'FLAG_ATIVO_EAP'
        ]

        !=

        snapshot[
            'FLAG_ATIVO_VALID'
        ]
    )

    # --------------------------------------------------------
    # DATA DO SNAPSHOT
    # --------------------------------------------------------

    agora = pd.Timestamp.now()

    snapshot[
        'DATA_SNAPSHOT'
    ] = (
        agora.normalize()
    )

    snapshot[
        'DATA_HORA_CARGA'
    ] = agora

    return snapshot


