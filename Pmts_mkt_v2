# 13. EXPORTAR EXCEL
# ============================================================

def exportar_excel(
    snapshot,
    resumo,
    resumo_competencia,
    duplicados,
    validacao_ativacao
):

    data = (
        datetime.now()
        .strftime('%Y%m%d')
    )

    arquivo = (

        PASTA_SAIDA

        /

        f'observabilidade_pmts_{data}.xlsx'
    )

    sn = snapshot[
        snapshot['FLAG_SN']
    ].copy()

    af = snapshot[
        snapshot[
            'FLAG_AMPLIACAO_FISICA'
        ]
    ].copy()

    al = snapshot[
        snapshot[
            'FLAG_AMPLIACAO_LOGICA'
        ]
    ].copy()

    divergencia_ativacao = snapshot[
        snapshot[
            'DIVERGENCIA_ATIVACAO'
        ]
    ].copy()

    alteracoes_monitoradas = snapshot[[

        'DATA_SNAPSHOT',
        'DATA_HORA_CARGA',

        'UID_IDPMTS',
        'UID_IDENG',
        'UID_UFSIGLA',

        'PMO_REGIONAL',
        'PMO_UF',

        'REGIONAL_BASELINE_ATIVACAO',
        'PMO_CARIMBO_BASELINE',
        'PMO_CARIMBO_CENTRALIZADO',

        'COMPETENCIA',

        'ENG_OBJ_MACRO',
        'MASTEROBRA_OBJ_ENG',
        'PMO_PROJETO',
        'PMO_REFERENCIA_REPORT',

        'MASTERSITE_COBERTURA',
        'MASTEROBRA_STATUS_ROLLOUT',

        'PMO_ROLLOUT_OVBK',
        'PMO_TIPO_INTERV',
        'PMO_ESCOPO_META',

        'EAP_AUTOMATICA',
        'VALID_ATIVACAO',

        'FLAG_SN',
        'FLAG_AMPLIACAO_FISICA',
        'FLAG_AMPLIACAO_LOGICA',

        'FLAG_FINALIZADA',
        'FLAG_ATIVO_EAP',
        'FLAG_ATIVO_VALID',
        'DIVERGENCIA_ATIVACAO'

    ]].copy()

    with pd.ExcelWriter(
        arquivo,
        engine='openpyxl',
        datetime_format='dd/mm/yyyy'
    ) as writer:

        resumo.to_excel(
            writer,
            sheet_name='Resumo',
            index=False
        )

        resumo_competencia.to_excel(
            writer,
            sheet_name='Por Competência',
            index=False
        )

        validacao_ativacao.to_excel(
            writer,
            sheet_name='EAP x Valid',
            index=False
        )

        divergencia_ativacao.to_excel(
            writer,
            sheet_name='Divergência Ativação',
            index=False
        )

        sn.to_excel(
            writer,
            sheet_name='Sites Novos',
            index=False
        )

        af.to_excel(
            writer,
            sheet_name='Ampliação Física',
            index=False
        )

        al.to_excel(
            writer,
            sheet_name='Ampliação Lógica',
            index=False
        )

        alteracoes_monitoradas.to_excel(
            writer,
            sheet_name='Snapshot',
            index=False
        )

        duplicados.to_excel(
            writer,
            sheet_name='IDs Duplicados',
            index=False
        )

    print(
        f'\nExcel criado: {arquivo}'
    )


