# ============================================================
# 1. CARREGAR MKT
# ============================================================

def carregar_mkt_excel(
    caminho,
    aba='Sheet1'
):

    print(
        '\nLendo base MKT...'
    )

    df = pd.read_excel(
        caminho,
        sheet_name=aba
    )

    print(
        f'{len(df):,} linhas carregadas.'
    )

    return df


# ============================================================
# 2. NORMALIZAR COLUNAS
# ============================================================

def normalizar_colunas_mkt(df):

    mkt = df.copy()

    novas_colunas = []

    for coluna in mkt.columns:

        coluna = (
            str(coluna)
            .strip()
        )

        # PMTS_RF.VALID_ATIVACAO
        # vira
        # VALID_ATIVACAO

        if '.' in coluna:

            coluna = (
                coluna
                .split('.')[-1]
            )

        novas_colunas.append(
            coluna.strip()
        )

    mkt.columns = (
        novas_colunas
    )

    return mkt


# ============================================================
# 3. NORMALIZAR CHAVES
# ============================================================

def normalizar_chaves(df):

    resultado = df.copy()

    for coluna in [

        'UID_IDPMTS',
        'UID_IDENG',
        'UID_UFSIGLA'

    ]:

        if coluna in resultado.columns:

            resultado[coluna] = (

                resultado[coluna]

                .astype('string')

                .str.strip()

                .str.upper()
            )

    return resultado


# ============================================================
# 4. PREPARAR MKT
# ============================================================

def preparar_mkt(df):

    mkt = (
        normalizar_colunas_mkt(
            df
        )
    )

    mkt = (
        normalizar_chaves(
            mkt
        )
    )

    if 'VALID_ATIVACAO' not in mkt.columns:

        raise KeyError(
            'VALID_ATIVACAO não encontrada no MKT.'
        )

    mkt[
        'FLAG_ATIVO_MKT'
    ] = (

        mkt[
            'VALID_ATIVACAO'
        ]

        .astype('string')

        .str.strip()

        .str.upper()

        .eq('[S]')
    )

    return mkt


# ============================================================
# 5. NOSSO SN
# ============================================================

def preparar_nosso_sn(snapshot):

    nosso = snapshot[
        snapshot['FLAG_SN']
    ].copy()

    nosso = (
        normalizar_chaves(
            nosso
        )
    )

    return nosso


# ============================================================
# 6. COMPARAÇÃO POR SITE
# ============================================================

def comparar_sites(
    nosso,
    mkt
):

    sites_nosso = set(

        nosso[
            'UID_UFSIGLA'
        ]

        .dropna()

        .unique()
    )

    sites_mkt = set(

        mkt[
            'UID_UFSIGLA'
        ]

        .dropna()

        .unique()
    )

    comuns = (
        sites_nosso
        &
        sites_mkt
    )

    somente_pmts = (
        sites_nosso
        -
        sites_mkt
    )

    somente_mkt = (
        sites_mkt
        -
        sites_nosso
    )

    return (
        sites_nosso,
        sites_mkt,
        comuns,
        somente_pmts,
        somente_mkt
    )


