# ============================================================
# 9. RECONCILIAÇÃO POR SITE
# ============================================================

def montar_reconciliacao_sites(
    nosso,
    mkt
):

    lista_sites = sorted(

        set(
            nosso[
                'UID_UFSIGLA'
            ]
            .dropna()
        )

        |

        set(
            mkt[
                'UID_UFSIGLA'
            ]
            .dropna()
        )
    )

    reconciliacao = pd.DataFrame({

        'UID_UFSIGLA':
            lista_sites

    })

    sites_nosso = set(

        nosso[
            'UID_UFSIGLA'
        ]

        .dropna()
    )

    sites_mkt = set(

        mkt[
            'UID_UFSIGLA'
        ]

        .dropna()
    )

    reconciliacao[
        'PMTS_SN'
    ] = (

        reconciliacao[
            'UID_UFSIGLA'
        ]

        .isin(
            sites_nosso
        )
    )

    reconciliacao[
        'MKT_SN'
    ] = (

        reconciliacao[
            'UID_UFSIGLA'
        ]

        .isin(
            sites_mkt
        )
    )

    reconciliacao[
        'STATUS_ESCOPO'
    ] = 'COMUM'

    reconciliacao.loc[

        (
            reconciliacao[
                'PMTS_SN'
            ]

            &

            ~reconciliacao[
                'MKT_SN'
            ]
        ),

        'STATUS_ESCOPO'

    ] = 'SOMENTE PMTS'

    reconciliacao.loc[

        (
            ~reconciliacao[
                'PMTS_SN'
            ]

            &

            reconciliacao[
                'MKT_SN'
            ]
        ),

        'STATUS_ESCOPO'

    ] = 'SOMENTE MKT'

    return reconciliacao


# ============================================================
# 10. COMPARAÇÃO DE ATIVAÇÃO
# ============================================================

def comparar_ativacao_pmts_mkt(
    nosso,
    mkt
):

    # --------------------------------------------------------
    # MKT
    # --------------------------------------------------------

    colunas_mkt_desejadas = [

        'UID_IDPMTS',
        'UID_IDENG',
        'UID_UFSIGLA',

        'VALID_ATIVACAO',
        'FLAG_ATIVO_MKT'
    ]

    colunas_mkt = [

        coluna

        for coluna in colunas_mkt_desejadas

        if coluna in mkt.columns
    ]

    base_mkt = (

        mkt[
            colunas_mkt
        ]

        .drop_duplicates(
            subset=[
                'UID_IDPMTS'
            ]
        )

        .copy()
    )


    # --------------------------------------------------------
    # PMTS
    # --------------------------------------------------------

    colunas_pmts_desejadas = [

        'UID_IDPMTS',
        'UID_IDENG',
        'UID_UFSIGLA',

        'EAP_AUTOMATICA',
        'VALID_ATIVACAO',

        'FLAG_ATIVO_EAP',
        'FLAG_ATIVO_VALID',

        'ENG_OBJ_MACRO',
        'MASTEROBRA_OBJ_ENG',
        'PMO_PROJETO',
        'PMO_REFERENCIA_REPORT',

        'PMO_REGIONAL',
        'PMO_UF',

        'REGIONAL_BASELINE_ATIVACAO',
        'PMO_CARIMBO_BASELINE',
        'PMO_CARIMBO_CENTRALIZADO',

        'COMPETENCIA'
    ]

    colunas_pmts = [

        coluna

        for coluna in colunas_pmts_desejadas

        if coluna in nosso.columns
    ]

    base_pmts = (

        nosso[
            colunas_pmts
        ]

        .drop_duplicates(
            subset=[
                'UID_IDPMTS'
            ]
        )

        .copy()
    )


    # --------------------------------------------------------
    # MERGE
    # --------------------------------------------------------

    comparacao = (
        base_pmts

        .merge(

            base_mkt,

            on='UID_IDPMTS',

            how='inner',

            suffixes=(
                '_PMTS',
                '_MKT'
            )
        )
    )


    # --------------------------------------------------------
    # EAP PMTS x VALID MKT
    # --------------------------------------------------------

    comparacao[
        'EAP_IGUAL_VALID_MKT'
    ] = (

        comparacao[
            'FLAG_ATIVO_EAP'
        ]

        ==

        comparacao[
            'FLAG_ATIVO_MKT'
        ]
    )

    comparacao[
        'STATUS_ATIVACAO'
    ] = (

        comparacao[
            'EAP_IGUAL_VALID_MKT'
        ]

        .map({

            True:
                'OK',

            False:
                'DIVERGÊNCIA'
        })
    )

    return comparacao


# ============================================================
# 11. DETALHAR SITES DIVERGENTES
# ============================================================

def detalhar_divergencias(
    nosso,
    mkt,
    somente_pmts,
    somente_mkt
):

    detalhe_pmts = nosso[

        nosso[
            'UID_UFSIGLA'
        ]

        .isin(
            somente_pmts
        )

    ].copy()

    detalhe_pmts[
        'ORIGEM_DIVERGENCIA'
    ] = 'SOMENTE PMTS'


    detalhe_mkt = mkt[

        mkt[
            'UID_UFSIGLA'
        ]

        .isin(
            somente_mkt
        )

    ].copy()

    detalhe_mkt[
        'ORIGEM_DIVERGENCIA'
    ] = 'SOMENTE MKT'

    return (
        detalhe_pmts,
        detalhe_mkt
    )


