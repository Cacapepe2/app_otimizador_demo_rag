"""
integrations/gitlab/gitlab_client.py

Cliente REST somente-leitura para GitLab Self-Managed.

Variáveis de ambiente esperadas:
    GITLAB_URL
    GITLAB_TOKEN

Exemplo PowerShell (vale apenas para o terminal atual):
    $env:GITLAB_URL="http://SEU_GITLAB:PORTA"
    $env:GITLAB_TOKEN="SEU_TOKEN"

Não coloque token neste arquivo.
"""

from __future__ import annotations

import os
from urllib.parse import quote
from typing import Any

import requests


class GitLabClient:
    def __init__(self, base_url: str | None = None, token: str | None = None):
        self.base_url = (base_url or os.getenv("GITLAB_URL", "")).rstrip("/")
        self.token = token or os.getenv("GITLAB_TOKEN", "")

        if not self.base_url:
            raise RuntimeError("Defina a variável de ambiente GITLAB_URL.")
        if not self.token:
            raise RuntimeError("Defina a variável de ambiente GITLAB_TOKEN.")

        self.api_url = f"{self.base_url}/api/v4"

        self.session = requests.Session()
        self.session.headers.update(
            {
                "PRIVATE-TOKEN": self.token,
                "Accept": "application/json",
            }
        )

    def _get(
        self,
        path: str,
        params: dict[str, Any] | None = None,
        raw: bool = False,
    ):
        response = self.session.get(
            f"{self.api_url}{path}",
            params=params,
            timeout=60,
        )

        if response.status_code == 401:
            raise RuntimeError(
                "GitLab retornou 401: token ausente, inválido ou expirado."
            )

        if response.status_code == 403:
            raise RuntimeError(
                "GitLab retornou 403: sua conta/token não tem permissão "
                "para esta operação."
            )

        if response.status_code == 404:
            raise RuntimeError(
                f"GitLab retornou 404 para: {response.url}"
            )

        response.raise_for_status()

        if raw:
            return response.text

        return response.json()

    def whoami(self) -> dict:
        """Valida a conexão e retorna o usuário autenticado."""
        return self._get("/user")

    def get_project(self, project_id: int | str) -> dict:
        """
        Obtém metadados de um projeto pelo ID numérico
        ou pelo path completo (URL encoded).
        """
        project = quote(str(project_id), safe="")
        return self._get(f"/projects/{project}")

    def list_projects(
        self,
        per_page: int = 100,
        max_pages: int | None = None,
    ) -> list[dict]:
        """
        Lista projetos visíveis ao usuário autenticado.

        Use com cuidado em instalações grandes.
        """
        results: list[dict] = []
        page = 1

        while True:
            batch = self._get(
                "/projects",
                params={
                    "simple": "true",
                    "membership": "true",
                    "per_page": per_page,
                    "page": page,
                    "order_by": "last_activity_at",
                    "sort": "desc",
                },
            )

            results.extend(batch)

            if len(batch) < per_page:
                break

            if max_pages is not None and page >= max_pages:
                break

            page += 1

        return results

    def search_projects(
        self,
        search: str,
        per_page: int = 100,
        max_pages: int | None = None,
    ) -> list[dict]:
        """
        Procura projetos aos quais o usuário autenticado tem acesso.
        """
        results: list[dict] = []
        page = 1

        while True:
            batch = self._get(
                "/projects",
                params={
                    "search": search,
                    "simple": "true",
                    "membership": "true",
                    "per_page": per_page,
                    "page": page,
                    "order_by": "last_activity_at",
                    "sort": "desc",
                },
            )

            results.extend(batch)

            if len(batch) < per_page:
                break

            if max_pages is not None and page >= max_pages:
                break

            page += 1

        return results

    def repository_tree(
        self,
        project_id: int | str,
        ref: str | None = None,
        recursive: bool = True,
        per_page: int = 100,
        max_pages: int | None = None,
    ) -> list[dict]:
        """
        Lista a árvore do repositório.

        Útil para localizar scripts pelo nome sem baixar
        o repositório inteiro.
        """
        project = quote(str(project_id), safe="")
        results: list[dict] = []
        page = 1

        while True:
            params = {
                "recursive": str(recursive).lower(),
                "per_page": per_page,
                "page": page,
            }

            if ref:
                params["ref"] = ref

            batch = self._get(
                f"/projects/{project}/repository/tree",
                params=params,
            )

            results.extend(batch)

            if len(batch) < per_page:
                break

            if max_pages is not None and page >= max_pages:
                break

            page += 1

        return results

    def find_files(
        self,
        project_id: int | str,
        text: str,
        ref: str | None = None,
    ) -> list[dict]:
        """
        Localiza arquivos/pastas cujo path contém o texto informado.
        """
        term = text.lower().strip()

        tree = self.repository_tree(
            project_id=project_id,
            ref=ref,
            recursive=True,
        )

        return [
            item
            for item in tree
            if term in str(item.get("path", "")).lower()
        ]

    def search_code(
        self,
        project_id: int | str,
        term: str,
        per_page: int = 100,
        max_pages: int | None = None,
    ) -> list[dict]:
        """
        Procura um termo dentro dos blobs de UM projeto.

        Em GitLab Self-Managed, a disponibilidade pode variar
        conforme configuração/licenciamento da instância.
        """
        project = quote(str(project_id), safe="")
        results: list[dict] = []
        page = 1

        while True:
            response = self.session.get(
                f"{self.api_url}/projects/{project}/search",
                params={
                    "scope": "blobs",
                    "search": term,
                    "per_page": per_page,
                    "page": page,
                },
                timeout=60,
            )

            if response.status_code in (400, 403, 404):
                raise RuntimeError(
                    "A busca de código não está disponível ou não foi permitida "
                    f"neste projeto. HTTP {response.status_code}: "
                    f"{response.text[:300]}"
                )

            response.raise_for_status()
            batch = response.json()

            results.extend(batch)

            if len(batch) < per_page:
                break

            if max_pages is not None and page >= max_pages:
                break

            page += 1

        return results

    def read_file(
        self,
        project_id: int | str,
        file_path: str,
        ref: str,
    ) -> str:
        """
        Lê o conteúdo RAW de um arquivo sem clonar o repositório.
        """
        project = quote(str(project_id), safe="")
        encoded_path = quote(file_path, safe="")

        return self._get(
            f"/projects/{project}/repository/files/{encoded_path}/raw",
            params={"ref": ref},
            raw=True,
        )
