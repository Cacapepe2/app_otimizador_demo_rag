"""
integrations/gitlab/gitlab_search.py

Camada de busca reutilizável do Mega Brain.

Objetivos:
- localizar scripts do lineage dentro do GitLab;
- evitar varrer todos os repositórios sempre;
- procurar termos como "gabinete" apenas nos repositórios relevantes;
- retornar metadados pequenos para o agente.

Não altera nada no GitLab.
"""

from __future__ import annotations

from collections import OrderedDict
from pathlib import PurePosixPath
from typing import Iterable

from integrations.gitlab.gitlab_client import GitLabClient


class GitLabSearch:
    def __init__(self, client: GitLabClient | None = None):
        self.client = client or GitLabClient()

    @staticmethod
    def _dedupe_projects(projects: Iterable[dict]) -> list[dict]:
        unique = OrderedDict()

        for project in projects:
            project_id = project.get("id")
            if project_id is not None:
                unique[project_id] = project

        return list(unique.values())

    def candidate_projects(
        self,
        search_terms: list[str],
        max_projects: int = 80,
    ) -> list[dict]:
        """
        Monta uma lista reduzida de projetos candidatos
        a partir de palavras relacionadas ao contexto.

        Exemplo:
            ["PMTS", "ACEITACAO", "DATAVIEW"]
        """
        projects: list[dict] = []

        for term in search_terms:
            term = str(term).strip()

            if not term:
                continue

            try:
                projects.extend(
                    self.client.search_projects(
                        term,
                        max_pages=2,
                    )
                )
            except Exception as exc:
                print(
                    f"[AVISO] Falha procurando projetos por '{term}': {exc}"
                )

        projects = self._dedupe_projects(projects)

        return projects[:max_projects]

    def find_script_in_projects(
        self,
        script_name: str,
        projects: list[dict],
    ) -> list[dict]:
        """
        Procura um script pelo nome em uma lista de projetos candidatos.

        Retorna:
            project_id
            project
            branch
            path
            name
        """
        wanted = script_name.lower().strip()
        results: list[dict] = []

        for project in projects:
            project_id = project.get("id")
            branch = project.get("default_branch")

            if not project_id or not branch:
                continue

            try:
                tree = self.client.repository_tree(
                    project_id=project_id,
                    ref=branch,
                    recursive=True,
                )
            except Exception as exc:
                print(
                    f"[AVISO] Não consegui ler árvore de "
                    f"{project.get('path_with_namespace')}: {exc}"
                )
                continue

            for item in tree:
                if item.get("type") != "blob":
                    continue

                path = str(item.get("path", ""))
                filename = PurePosixPath(path).name.lower()

                if filename == wanted:
                    results.append(
                        {
                            "script": script_name,
                            "project_id": project_id,
                            "project": project.get("path_with_namespace"),
                            "branch": branch,
                            "path": path,
                        }
                    )

        return results

    def find_scripts(
        self,
        script_names: list[str],
        project_search_terms: list[str],
        max_projects: int = 80,
    ) -> list[dict]:
        """
        Procura vários scripts em projetos candidatos.
        """
        projects = self.candidate_projects(
            project_search_terms,
            max_projects=max_projects,
        )

        results: list[dict] = []

        for script_name in script_names:
            print(f"\nProcurando script: {script_name}")

            found = self.find_script_in_projects(
                script_name=script_name,
                projects=projects,
            )

            if found:
                results.extend(found)
            else:
                print("  -> não encontrado nos projetos candidatos")

        return results

    def search_terms_in_repository(
        self,
        project_id: int,
        branch: str,
        terms: list[str],
    ) -> list[dict]:
        """
        Procura termos no conteúdo de um repositório.

        Primeiro tenta Search API de blobs.
        Se não estiver disponível, apenas registra o erro.
        """
        results: list[dict] = []
        seen = set()

        for term in terms:
            print(f"\nProcurando termo '{term}' no projeto {project_id}")

            try:
                matches = self.client.search_code(
                    project_id=project_id,
                    term=term,
                    max_pages=2,
                )
            except Exception as exc:
                print(f"  -> busca de conteúdo indisponível: {exc}")
                continue

            for match in matches:
                path = match.get("path")
                ref = match.get("ref") or branch

                key = (project_id, path, term)

                if key in seen:
                    continue

                seen.add(key)

                results.append(
                    {
                        "project_id": project_id,
                        "branch": ref,
                        "term": term,
                        "path": path,
                        "filename": match.get("filename"),
                        "data": match.get("data"),
                    }
                )

        return results

    def read_match(
        self,
        project_id: int,
        path: str,
        branch: str,
    ) -> str:
        """
        Lê o arquivo encontrado pela busca.
        """
        return self.client.read_file(
            project_id=project_id,
            file_path=path,
            ref=branch,
        )
