def criar_changelog_classificacao(
    comparacao,
    data_anterior,
    data_atual
):
    mudancas = comparacao[
        comparacao['MUDOU_CLASSIFICACAO']
    ].copy()

    registros = []

    for _, linha in mudancas.iterrows():
        registro = dados_contexto_changelog(
            linha,
            data_anterior,
            data_atual
        )

        registro.update({
            'TIPO_REGISTRO': 'ALTERADO',
            'TIPO_MUDANCA':
                'CLASSIFICACAO_INDICADOR_ALTERADA',
            'CAMPO_ALTERADO':
                'CLASSIFICACAO_INDICADOR',
            'VALOR_ANTERIOR':
                linha['CLASSIFICACAO_ANTERIOR'],
            'VALOR_ATUAL':
                linha['CLASSIFICACAO_ATUAL'],
        })

        registros.append(registro)

    return pd.DataFrame(
        registros,
        columns=COLUNAS_CHANGELOG
    )


