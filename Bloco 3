def identificar_classificacao(linha, momento):
    classificacoes = []

    if bool(linha.get(f'FLAG_SN_{momento}', False)):
        classificacoes.append('SITE NOVO')

    if bool(
        linha.get(
            f'FLAG_AMPLIACAO_FISICA_{momento}',
            False
        )
    ):
        classificacoes.append('AMPLIAÇÃO FÍSICA')

    if bool(
        linha.get(
            f'FLAG_AMPLIACAO_LOGICA_{momento}',
            False
        )
    ):
        classificacoes.append('AMPLIAÇÃO LÓGICA')

    if not classificacoes:
        return 'FORA DOS 3 INDICADORES'

    return ' + '.join(classificacoes)


def eh_transicao_sn_para_ampliacao(
    classificacao_anterior,
    classificacao_atual
):
    return (
        classificacao_anterior == 'SITE NOVO'
        and classificacao_atual in {
            'AMPLIAÇÃO FÍSICA',
            'AMPLIAÇÃO LÓGICA',
        }
    )


def adicionar_classificacoes_comparacao(comparacao):
    resultado = comparacao.copy()

    resultado['CLASSIFICACAO_ANTERIOR'] = resultado.apply(
        lambda linha: identificar_classificacao(
            linha,
            'ANTERIOR'
        ),
        axis=1
    )

    resultado['CLASSIFICACAO_ATUAL'] = resultado.apply(
        lambda linha: identificar_classificacao(
            linha,
            'ATUAL'
        ),
        axis=1
    )

    resultado['MUDOU_CLASSIFICACAO'] = (
        resultado['CLASSIFICACAO_ANTERIOR']
        .ne(resultado['CLASSIFICACAO_ATUAL'])
    )

    resultado['TRANSICAO_CLASSIFICACAO'] = (
        resultado['CLASSIFICACAO_ANTERIOR']
        + ' → '
        + resultado['CLASSIFICACAO_ATUAL']
    )

    resultado['SAIU_SN_PARA_AMPLIACAO'] = resultado.apply(
        lambda linha: eh_transicao_sn_para_ampliacao(
            linha['CLASSIFICACAO_ANTERIOR'],
            linha['CLASSIFICACAO_ATUAL']
        ),
        axis=1
    )

    return resultado


# ============================================================
# COMPARAÇÃO DOS CAMPOS
# ============================================================

def valores_diferentes(
    serie_anterior,
    serie_atual
):
    ambos_nulos = (
        serie_anterior.isna()
        &
        serie_atual.isna()
    )

    iguais = (
        serie_anterior.eq(serie_atual)
        .fillna(False)
    )

    return ~(ambos_nulos | iguais)


def comparar_campo_monitorado(
    serie_anterior,
    serie_atual,
    campo
):
    if campo in COLUNAS_PROJETO_MONITORADAS:
        anterior_normalizado = (
            serie_anterior.apply(normalizar_valor_projeto)
        )
        atual_normalizado = (
            serie_atual.apply(normalizar_valor_projeto)
        )

        return valores_diferentes(
            anterior_normalizado,
            atual_normalizado
        )

    if campo in COLUNAS_CLASSIFICACAO_MONITORADAS:
        anterior_normalizado = (
            serie_anterior.apply(normalizar_texto)
        )
        atual_normalizado = (
            serie_atual.apply(normalizar_texto)
        )

        return valores_diferentes(
            anterior_normalizado,
            atual_normalizado
        )

    if campo in COLUNAS_DATA_MONITORADAS:
        anterior_normalizado = (
            serie_anterior.apply(normalizar_data)
        )
        atual_normalizado = (
            serie_atual.apply(normalizar_data)
        )

        return valores_diferentes(
            anterior_normalizado,
            atual_normalizado
        )

    return valores_diferentes(
        serie_anterior,
        serie_atual
    )


def formatar_valor_saida(valor):
    if pd.isna(valor):
        return None

    if isinstance(valor, (pd.Timestamp, datetime)):
        return valor.strftime('%Y-%m-%d')

    return str(valor)


