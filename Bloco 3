# ============================================================
# CHANGELOG DE CAMPOS ALTERADOS
# ============================================================

def criar_changelog_campos(
    comparacao,
    data_anterior,
    data_atual
):
    alteracoes = []

    for campo in COLUNAS_MONITORADAS:
        coluna_anterior = f'{campo}_ANTERIOR'
        coluna_atual = f'{campo}_ATUAL'

        if (
            coluna_anterior not in comparacao.columns
            or coluna_atual not in comparacao.columns
        ):
            print(
                f'ATENÇÃO: {campo} não foi encontrado '
                f'nos dois snapshots.'
            )
            continue

        mascara = comparar_campo_monitorado(
            comparacao[coluna_anterior],
            comparacao[coluna_atual],
            campo
        )

        for _, linha in comparacao[mascara].iterrows():
            registro = dados_contexto_changelog(
                linha,
                data_anterior,
                data_atual
            )

            registro.update({
                'TIPO_REGISTRO': 'ALTERADO',
                'TIPO_MUDANCA':
                    classificar_tipo_mudanca(campo),
                'CAMPO_ALTERADO': campo,
                'VALOR_ANTERIOR':
                    formatar_valor_saida(
                        linha[coluna_anterior]
                    ),
                'VALOR_ATUAL':
                    formatar_valor_saida(
                        linha[coluna_atual]
                    ),
            })

            alteracoes.append(registro)

    return pd.DataFrame(
        alteracoes,
        columns=COLUNAS_CHANGELOG
    )


