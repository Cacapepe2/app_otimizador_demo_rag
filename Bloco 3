def comparacao_ja_processada(data_atual):
    try:
        existente = c.read_sql(
            DATABASE_HISTORICO,
            TABELA_CHANGELOG,
            BANCO_HISTORICO,
            colunas='DATA_SNAPSHOT_ATUAL'
        )

        if existente.empty:
            return False

        datas = pd.to_datetime(
            existente['DATA_SNAPSHOT_ATUAL'],
            errors='coerce'
        ).dt.normalize()

        return datas.eq(
            pd.Timestamp(data_atual).normalize()
        ).any()

    except Exception:
        return False


def salvar_no_banco(
    changelog,
    impacto,
    data_atual,
    force=False
):
    if (
        comparacao_ja_processada(data_atual)
        and not force
    ):
        print(
            '\nEssa comparação já foi salva. '
            'Nada foi inserido novamente.'
        )
        return False

    if not changelog.empty:
        c.to_sql(
            changelog,
            DATABASE_HISTORICO,
            TABELA_CHANGELOG,
            BANCO_HISTORICO,
            normalize=True,
            existente='append'
        )
        print(
            f'Gravado em '
            f'{DATABASE_HISTORICO}.{TABELA_CHANGELOG}'
        )

    if not impacto.empty:
        c.to_sql(
            impacto,
            DATABASE_HISTORICO,
            TABELA_IMPACTO,
            BANCO_HISTORICO,
            normalize=True,
            existente='append'
        )
        print(
            f'Gravado em '
            f'{DATABASE_HISTORICO}.{TABELA_IMPACTO}'
        )

    return True


