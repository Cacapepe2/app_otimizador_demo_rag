def interpretar_rollout(anterior, atual):
    anterior = normalizar_texto(anterior)
    atual = normalizar_texto(atual)

    if anterior == 'ORCAMENTO' and atual != 'ORCAMENTO':
        return 'SAIU_DO_ESCOPO_ORCAMENTO'

    if anterior != 'ORCAMENTO' and atual == 'ORCAMENTO':
        return 'ENTROU_NO_ESCOPO_ORCAMENTO'

    return None


def interpretar_escopo_meta(anterior, atual):
    anterior = normalizar_texto(anterior)
    atual = normalizar_texto(atual)

    if anterior == 'FÍSICA' and atual != 'FÍSICA':
        return 'SAIU_DO_ESCOPO_FISICA'

    if anterior != 'FÍSICA' and atual == 'FÍSICA':
        return 'ENTROU_NO_ESCOPO_FISICA'

    if anterior == 'LÓGICA' and atual != 'LÓGICA':
        return 'SAIU_DO_ESCOPO_LOGICA'

    if anterior != 'LÓGICA' and atual == 'LÓGICA':
        return 'ENTROU_NO_ESCOPO_LOGICA'

    return None


def criar_tabela_impacto(
    comparacao,
    changelog_campos,
    changelog_classificacao,
    data_anterior,
    data_atual
):
    ids = set()

    if not changelog_campos.empty:
        ids.update(
            changelog_campos['UID_IDPMTS']
            .dropna()
            .unique()
        )

    if not changelog_classificacao.empty:
        ids.update(
            changelog_classificacao['UID_IDPMTS']
            .dropna()
            .unique()
        )

    if not ids:
        return pd.DataFrame()

    base = comparacao[
        comparacao['UID_IDPMTS'].isin(ids)
    ].copy()

    resultados = []

    for _, linha in base.iterrows():
        idpmts = linha['UID_IDPMTS']

        campos_obra = (
            changelog_campos.loc[
                changelog_campos['UID_IDPMTS'].eq(idpmts),
                'CAMPO_ALTERADO'
            ]
            .dropna()
            .tolist()
            if not changelog_campos.empty
            else []
        )

        projetos_alterados = [
            campo
            for campo in campos_obra
            if campo in COLUNAS_PROJETO_MONITORADAS
        ]

        datas_alteradas = [
            campo
            for campo in campos_obra
            if campo in COLUNAS_DATA_MONITORADAS
        ]

        competencia_anterior = linha.get(
            'COMPETENCIA_ANTERIOR'
        )
        competencia_atual = linha.get(
            'COMPETENCIA_ATUAL'
        )

        mudou_competencia = (
            normalizar_texto(competencia_anterior)
            != normalizar_texto(competencia_atual)
        )

        classificacao_anterior = linha[
            'CLASSIFICACAO_ANTERIOR'
        ]
        classificacao_atual = linha[
            'CLASSIFICACAO_ATUAL'
        ]

        resultados.append({
            'DATA_SNAPSHOT_ANTERIOR': data_anterior,
            'DATA_SNAPSHOT_ATUAL': data_atual,
            'DATA_DETECCAO': pd.Timestamp.now(),

            'UID_IDPMTS': idpmts,
            'UID_IDENG': linha.get('UID_IDENG_ATUAL'),
            'UID_UFSIGLA':
                linha.get('UID_UFSIGLA_ATUAL'),
            'PMO_REGIONAL':
                linha.get('PMO_REGIONAL_ATUAL'),
            'PMO_UF': linha.get('PMO_UF_ATUAL'),

            'QUANTIDADE_CAMPOS_ALTERADOS':
                len(campos_obra),

            'CAMPOS_ALTERADOS':
                ' | '.join(campos_obra),

            'MUDOU_PROJETO':
                len(projetos_alterados) > 0,

            'PROJETOS_ALTERADOS':
                ' | '.join(projetos_alterados),

            'MUDOU_DATA':
                len(datas_alteradas) > 0,

            'DATAS_ALTERADAS':
                ' | '.join(datas_alteradas),

            'COMPETENCIA_ANTERIOR':
                competencia_anterior,

            'COMPETENCIA_ATUAL':
                competencia_atual,

            'MUDOU_COMPETENCIA':
                mudou_competencia,

            'PMO_TIPO_INTERV_ANTERIOR':
                linha.get('PMO_TIPO_INTERV_ANTERIOR'),

            'PMO_TIPO_INTERV_ATUAL':
                linha.get('PMO_TIPO_INTERV_ATUAL'),

            'ESCOPO_META_ANTERIOR':
                linha.get('PMO_ESCOPO_META_ANTERIOR'),

            'ESCOPO_META_ATUAL':
                linha.get('PMO_ESCOPO_META_ATUAL'),

            'IMPACTO_ESCOPO_META':
                interpretar_escopo_meta(
                    linha.get('PMO_ESCOPO_META_ANTERIOR'),
                    linha.get('PMO_ESCOPO_META_ATUAL')
                ),

            'ROLLOUT_OVBK_ANTERIOR':
                linha.get('PMO_ROLLOUT_OVBK_ANTERIOR'),

            'ROLLOUT_OVBK_ATUAL':
                linha.get('PMO_ROLLOUT_OVBK_ATUAL'),

            'IMPACTO_ROLLOUT_OVBK':
                interpretar_rollout(
                    linha.get('PMO_ROLLOUT_OVBK_ANTERIOR'),
                    linha.get('PMO_ROLLOUT_OVBK_ATUAL')
                ),

            'CLASSIFICACAO_ANTERIOR':
                classificacao_anterior,

            'CLASSIFICACAO_ATUAL':
                classificacao_atual,

            'MUDOU_CLASSIFICACAO':
                classificacao_anterior
                != classificacao_atual,

            'TRANSICAO_CLASSIFICACAO':
                linha['TRANSICAO_CLASSIFICACAO'],

            'SAIU_SN_PARA_AMPLIACAO':
                linha['SAIU_SN_PARA_AMPLIACAO'],

            'FLAG_SN_ANTERIOR':
                linha.get('FLAG_SN_ANTERIOR'),

            'FLAG_SN_ATUAL':
                linha.get('FLAG_SN_ATUAL'),

            'FLAG_AMPLIACAO_FISICA_ANTERIOR':
                linha.get(
                    'FLAG_AMPLIACAO_FISICA_ANTERIOR'
                ),

            'FLAG_AMPLIACAO_FISICA_ATUAL':
                linha.get(
                    'FLAG_AMPLIACAO_FISICA_ATUAL'
                ),

            'FLAG_AMPLIACAO_LOGICA_ANTERIOR':
                linha.get(
                    'FLAG_AMPLIACAO_LOGICA_ANTERIOR'
                ),

            'FLAG_AMPLIACAO_LOGICA_ATUAL':
                linha.get(
                    'FLAG_AMPLIACAO_LOGICA_ATUAL'
                ),
        })

    return pd.DataFrame(resultados)


