# ============================================================
# NORMALIZAÇÕES
# ============================================================

def normalizar_booleano(serie):
    texto = (
        serie.astype('string')
        .str.strip()
        .str.upper()
    )

    mapa = {
        'TRUE': True,
        'FALSE': False,
        '1': True,
        '0': False,
        'T': True,
        'F': False,
        'SIM': True,
        'NÃO': False,
        'NAO': False,
        'S': True,
        'N': False,
    }

    return texto.map(mapa).fillna(False).astype(bool)


def normalizar_texto(valor):
    if pd.isna(valor):
        return None

    texto = str(valor).strip().upper()

    if texto == '':
        return None

    return texto


def normalizar_valor_projeto(valor):
    """
    Ignora apenas:
    - ordem dos itens separados por /
    - espaços
    - maiúsculas/minúsculas
    - itens repetidos

    Exemplo:
    MARKETING/PROJETO 5G
    PROJETO 5G/MARKETING
    são considerados iguais.
    """

    if pd.isna(valor):
        return None

    partes = [
        parte.strip().upper()
        for parte in str(valor).split('/')
        if parte.strip()
    ]

    if not partes:
        return None

    return '/'.join(sorted(set(partes)))


def normalizar_data(valor):
    if pd.isna(valor):
        return pd.NaT

    return pd.to_datetime(valor, errors='coerce').normalize()


