            'VALOR':
                contar_transicao(
                    transicoes,
                    'AMPLIAÇÃO FÍSICA',
                    'SITE NOVO'
                ),
        },
        {
            'METRICA': 'Ampliação Lógica → Site Novo',
            'VALOR':
                contar_transicao(
                    transicoes,
                    'AMPLIAÇÃO LÓGICA',
                    'SITE NOVO'
                ),
        },
    ])


