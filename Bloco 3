def ler_historico_snapshot():
    print('Lendo histórico de snapshots...')

    historico = c.read_sql(
        DATABASE_HISTORICO,
        TABELA_SNAPSHOT,
        BANCO_HISTORICO,
        colunas=', '.join(COLUNAS_LEITURA)
    )

    if historico.empty:
        raise ValueError('A tabela histórica está vazia.')

    print(f'{len(historico):,} linhas carregadas.')

    return historico


def tratar_historico(historico):
    df = historico.copy()

    for coluna in [
        'DATA_SNAPSHOT',
        'DATA_HORA_CARGA',
        *COLUNAS_DATA_MONITORADAS,
    ]:
        if coluna in df.columns:
            df[coluna] = pd.to_datetime(
                df[coluna],
                errors='coerce'
            )

    df['DATA_SNAPSHOT'] = (
        df['DATA_SNAPSHOT']
        .dt.normalize()
    )

    for coluna in [
        'UID_IDPMTS',
        'UID_IDENG',
        'UID_UFSIGLA',
    ]:
        if coluna in df.columns:
            df[coluna] = (
                df[coluna]
                .astype('string')
                .str.strip()
                .str.upper()
            )

    for coluna in COLUNAS_FLAG_MONITORADAS:
        if coluna in df.columns:
            df[coluna] = normalizar_booleano(df[coluna])

    return df


def validar_chave_snapshot(df, nome_snapshot):
    nulos = df['UID_IDPMTS'].isna().sum()

    if nulos > 0:
        raise ValueError(
            f'O snapshot {nome_snapshot} possui '
            f'{nulos} linhas sem UID_IDPMTS.'
        )

    duplicados = df[
        df['UID_IDPMTS'].duplicated(keep=False)
    ]

    if not duplicados.empty:
        exemplos = (
            duplicados['UID_IDPMTS']
            .drop_duplicates()
            .head(10)
            .tolist()
        )

        raise ValueError(
            f'Existem UID_IDPMTS duplicados no snapshot '
            f'{nome_snapshot}. Exemplos: {exemplos}'
        )


def selecionar_dois_ultimos_snapshots(historico):
    datas = (
        historico['DATA_SNAPSHOT']
        .dropna()
        .drop_duplicates()
        .sort_values()
        .tolist()
    )

    if len(datas) < 2:
        raise ValueError(
            'São necessários pelo menos dois dias de snapshot.'
        )

    data_anterior = datas[-2]
    data_atual = datas[-1]

    anterior = historico[
        historico['DATA_SNAPSHOT'].eq(data_anterior)
    ].copy()

    atual = historico[
        historico['DATA_SNAPSHOT'].eq(data_atual)
    ].copy()

    validar_chave_snapshot(anterior, 'ANTERIOR')
    validar_chave_snapshot(atual, 'ATUAL')

    print(
        '\nSnapshot anterior:',
        pd.Timestamp(data_anterior).strftime('%d/%m/%Y')
    )
    print(
        'Snapshot atual:',
        pd.Timestamp(data_atual).strftime('%d/%m/%Y')
    )
    print('Obras no anterior:', anterior['UID_IDPMTS'].nunique())
    print('Obras no atual:', atual['UID_IDPMTS'].nunique())

    return anterior, atual, data_anterior, data_atual


# ============================================================
# NOVAS, REMOVIDAS E MERGE
# ============================================================

def identificar_novas_e_removidas(anterior, atual):
    ids_anteriores = set(
        anterior['UID_IDPMTS'].dropna().unique()
    )
    ids_atuais = set(
        atual['UID_IDPMTS'].dropna().unique()
    )

    ids_novos = ids_atuais - ids_anteriores
    ids_removidos = ids_anteriores - ids_atuais

    obras_novas = atual[
        atual['UID_IDPMTS'].isin(ids_novos)
    ].copy()

    obras_removidas = anterior[
        anterior['UID_IDPMTS'].isin(ids_removidos)
    ].copy()

    obras_novas['TIPO_REGISTRO'] = 'NOVA_OBRA'
    obras_removidas['TIPO_REGISTRO'] = 'OBRA_REMOVIDA'

    return obras_novas, obras_removidas


def juntar_snapshots(anterior, atual):
    colunas_anterior = [
        coluna
        for coluna in COLUNAS_CONTEXTO
        if coluna in anterior.columns
    ]
    colunas_atual = [
        coluna
        for coluna in COLUNAS_CONTEXTO
        if coluna in atual.columns
    ]

    return anterior[colunas_anterior].merge(
        atual[colunas_atual],
        on='UID_IDPMTS',
        how='inner',
        suffixes=('_ANTERIOR', '_ATUAL'),
        validate='one_to_one'
    )


