def contar_transicao(
    transicoes,
    anterior,
    atual
):
    if transicoes.empty:
        return 0

    return transicoes.loc[
        transicoes['CLASSIFICACAO_ANTERIOR'].eq(anterior)
        &
        transicoes['CLASSIFICACAO_ATUAL'].eq(atual),
        'UID_IDPMTS'
    ].nunique()


def criar_resumo(
    snapshot_anterior,
    snapshot_atual,
    obras_novas,
    obras_removidas,
    changelog_campos,
    transicoes
):
    return pd.DataFrame([
        {
            'METRICA': 'Snapshot anterior',
            'VALOR':
                snapshot_anterior['DATA_SNAPSHOT'].iloc[0],
        },
        {
