# =============================================================================

def executive_status(row: pd.Series) -> str:
    p = row.get("PROB_CUMPRIR_CARIMBO")
    conf = row.get("MODEL_CONFIDENCE", 0)

    if pd.isna(p):
        return "SEM PREVISAO"

    if p >= 0.90:
        if conf >= 75:
            return "PROVAVEL CUMPRIMENTO >=90%"
        return "PROVAVEL, MAS EVIDENCIA FRACA"

    if p >= 0.70:
        return "ATENCAO"

    if p >= 0.40:
        return "ALTO RISCO"

    return "CRITICO"


