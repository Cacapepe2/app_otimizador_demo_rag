def build_gold_risk_table(
    scope: pd.DataFrame,
    reference: pd.DataFrame,
    compare: pd.DataFrame,
    cfg: Config = CFG,
    as_of: Optional[pd.Timestamp] = None,
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    as_of = pd.Timestamp(as_of or date.today())

    logger.info("Reconstruindo permanências de EAP...")
    intervals = reconstruct_eap_intervals(compare)
    intervals = attach_current_attributes(intervals, reference)

    logger.info(
        "Intervalos reconstruídos: %s | válidos para treino: %s",
        len(intervals),
        int(intervals["VALID_FOR_TRAINING"].sum()),
    )

    pools = build_transition_pools(intervals)

    scope_current = current_eap_entry_info(
        scope=scope,
        compare=compare,
        as_of=as_of,
    )

    rng = np.random.default_rng(cfg.random_seed)

    logger.info(
        "Rodando Monte Carlo em %s obras (%s simulações por obra)...",
        len(scope_current),
        cfg.n_simulations,
    )

    predictions = []
    for i, (_, row) in enumerate(scope_current.iterrows(), start=1):
        pred = simulate_one_work(
            row=row,
            pools=pools,
            as_of=as_of,
            cfg=cfg,
            rng=rng,
        )
        predictions.append(pred)

        if i % 100 == 0:
            logger.info("Processadas %s/%s obras", i, len(scope_current))

    pred_df = pd.DataFrame(predictions, index=scope_current.index)

    gold = pd.concat(
        [scope_current.reset_index(drop=True), pred_df.reset_index(drop=True)],
        axis=1,
    )

    gold["CRITERIO_EXECUTIVO"] = gold.apply(executive_status, axis=1)
    gold["DATA_REFERENCIA_MODELO"] = as_of.normalize()

    # Percentuais amigáveis para BI/Excel
    gold["PROB_CUMPRIR_CARIMBO_PCT"] = (
        gold["PROB_CUMPRIR_CARIMBO"] * 100
    ).round(1)
    gold["PROB_ATRASAR_PCT"] = (
        gold["PROB_ATRASAR"] * 100
    ).round(1)

    return gold, intervals


def save_outputs(
    gold: pd.DataFrame,
    intervals: pd.DataFrame,
    cfg: Config = CFG,
):
    out = Path(cfg.output_dir)
    out.mkdir(parents=True, exist_ok=True)

    stamp = pd.Timestamp.today().strftime("%Y%m%d")

    gold_csv = out / f"gold_pmts_risk_{stamp}.csv"
    intervals_csv = out / f"eap_intervals_{stamp}.csv"

    gold.to_csv(gold_csv, index=False, encoding="utf-8-sig")
    intervals.to_csv(intervals_csv, index=False, encoding="utf-8-sig")

    logger.info("Gold table: %s", gold_csv)
    logger.info("Intervalos EAP: %s", intervals_csv)

    return gold_csv, intervals_csv


def run_pipeline(
    read_sql: ReadSQL,
    cfg: Config = CFG,
    as_of: Optional[pd.Timestamp] = None,
):
    """
    read_sql deve ser uma função que recebe SQL (str) e retorna DataFrame.

    Exemplo conceitual:
        run_pipeline(C.read_sql)

    Se o seu objeto C usa outro método:
        run_pipeline(lambda sql: C.metodo_que_le_sql(sql))
    """
    scope, reference, compare = load_data(read_sql, cfg)

    gold, intervals = build_gold_risk_table(
        scope=scope,
        reference=reference,
        compare=compare,
        cfg=cfg,
        as_of=as_of,
    )

    save_outputs(gold, intervals, cfg)
    return gold, intervals


