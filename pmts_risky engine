ReadSQL = Callable[[str], pd.DataFrame]


def _split_table_name(full_name: str) -> Tuple[str, str]:
    parts = full_name.split(".", 1)
    if len(parts) != 2:
        raise ValueError(
            f"Use tabela no formato schema.tabela. Recebido: {full_name!r}"
        )
    return parts[0], parts[1]


def discover_columns(read_sql: ReadSQL, full_table: str) -> List[str]:
    """
    Descobre colunas físicas via INFORMATION_SCHEMA.
    """
    schema, table = _split_table_name(full_table)
    sql = f"""
        SELECT COLUMN_NAME
        FROM INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = '{schema}'
          AND TABLE_NAME = '{table}'
        ORDER BY ORDINAL_POSITION
    """
    df = read_sql(sql)
    if df.empty:
        raise RuntimeError(
            f"Não foi possível descobrir colunas de {full_table}. "
            "Confirme schema/tabela e acesso ao INFORMATION_SCHEMA."
        )

    col = next(
        (c for c in df.columns if c.upper() == "COLUMN_NAME"),
        df.columns[0]
    )
    return df[col].astype(str).tolist()


def choose_pmts_columns(
    available_columns: Sequence[str],
    include_plan_real_dates: bool = True,
) -> List[str]:
    """
    Seleciona colunas conhecidas + todas as datas *_P e *_R disponíveis.

    Campos opcionais ausentes são avisados, não derrubam o pipeline.
    Campos obrigatórios para escopo/modelo são validados separadamente.
    """
    available = set(available_columns)

    selected = [c for c in BASE_COLUMNS if c in available]

    missing_optional = [c for c in BASE_COLUMNS if c not in available]
    if missing_optional:
        warnings.warn(
            "Colunas opcionais não encontradas e serão ignoradas: "
            + ", ".join(missing_optional)
        )

    if include_plan_real_dates:
        suffix_cols = [
            c for c in available_columns
            if c.endswith("_P") or c.endswith("_R")
        ]
        selected.extend(suffix_cols)

    # Preserva ordem sem duplicar
    return list(dict.fromkeys(selected))


def validate_required_pmts_columns(columns: Sequence[str]) -> None:
    required = {
        "UID_IDPMTS",
        "UID_UFSIGLA",
        "PMO_ROLLOUT_OVBK",
        "MASTEROBRA_STATUS_ROLLOUT",
        "PMO_CARIMBO_CENTRALIZADO",
        "VALID_ATIVACAO",
        "EAP_AUTOMATICA",
    }
    missing = sorted(required - set(columns))
    if missing:
        raise ValueError(
            "Colunas obrigatórias não encontradas na PMTS: "
            + ", ".join(missing)
        )


def build_scope_sql(columns: Sequence[str], cfg: Config = CFG) -> str:
    selected = ",\n        ".join(f"`{c}`" for c in columns)
    return f"""
    SELECT
        {selected}
    FROM {cfg.pmts_table}
    WHERE PMO_ROLLOUT_OVBK = '{cfg.budget_value}'
      AND MASTEROBRA_STATUS_ROLLOUT = '{cfg.rollout_status}'
      AND YEAR(PMO_CARIMBO_CENTRALIZADO) = {cfg.target_carimbo_year}
      AND VALID_ATIVACAO = '{cfg.valid_ativacao_open_value}'
    """


def build_reference_sql(columns: Sequence[str], cfg: Config = CFG) -> str:
    """
    Base atual completa apenas com campos de identificação/segmentação.

    É usada para anexar atributos às transições históricas.
    Não aplica o filtro alvo de 2027.
    """
    keep = [
        c for c in columns
        if c in {
            "UID_IDPMTS",
            "UID_UFSIGLA",
            "ENG_OBJ_MACRO",
            "MASTEROBRA_OBJ_ENG",
            "PMO_PROJETO",
            "PMO_REFERENCIA_REPORT",
            "PMO_REGIONAL",
            "PMO_TECN_EQUIP",
            "PMO_FREQ_EQUIP",
            "RSO_RSA_DETENTORA",
            "VENDOR_EQUIPAMENTO",
            "VENDOR_PROJETO",
            "VENDOR_INSTALADOR",
            "EAP_AUTOMATICA",
            "VALID_ATIVACAO",
        }
    ]
    selected = ",\n        ".join(f"`{c}`" for c in keep)

    return f"""
    SELECT
        {selected}
    FROM {cfg.pmts_table}
    """


def build_compare_sql(cfg: Config = CFG) -> str:
    """
    Traz apenas mudanças de EAP e somente IDs que ainda existem na PMTS atual,
    conforme regra de negócio confirmada.

    DATA_NEW é usada como timestamp real da transição.
    """
    return f"""
    SELECT
        c.UID_IDPMTS,
        c.COLUNA,
        c.DE,
        c.PARA,
        c.DATA_NEW
    FROM {cfg.compare_table} c
    INNER JOIN {cfg.pmts_table} p
        ON p.UID_IDPMTS = c.UID_IDPMTS
    WHERE c.COLUNA = 'EAP_AUTOMATICA'
      AND c.DATA_NEW IS NOT NULL
    """


def load_data(read_sql: ReadSQL, cfg: Config = CFG):
    logger.info("Descobrindo colunas da PMTS...")
    available = discover_columns(read_sql, cfg.pmts_table)
    validate_required_pmts_columns(available)

    selected = choose_pmts_columns(available, include_plan_real_dates=True)

    logger.info("Lendo população alvo...")
    scope = read_sql(build_scope_sql(selected, cfg))

    logger.info("Lendo referência atual de obras...")
    reference = read_sql(build_reference_sql(selected, cfg))

    logger.info("Lendo histórico de mudanças de EAP...")
    compare = read_sql(build_compare_sql(cfg))

    logger.info(
        "Carregado | alvo=%s obras | referência=%s linhas | compare=%s mudanças",
        scope["UID_IDPMTS"].nunique() if not scope.empty else 0,
        len(reference),
        len(compare),
    )

    return scope, reference, compare


# =============================================================================
# PREPARAÇÃO DO HISTÓRICO
# =============================================================================

def normalize_eap(value):
    if pd.isna(value):
        return np.nan
    return str(value).strip()


def prepare_compare(compare: pd.DataFrame) -> pd.DataFrame:
    required = {"UID_IDPMTS", "COLUNA", "DE", "PARA", "DATA_NEW"}
    missing = required - set(compare.columns)
    if missing:
        raise ValueError(
            "base_compare_pmts_rf sem colunas obrigatórias: "
            + ", ".join(sorted(missing))
        )

    df = compare.copy()

    df["DATA_NEW"] = pd.to_datetime(df["DATA_NEW"], errors="coerce")
    df["DE"] = df["DE"].map(normalize_eap)
    df["PARA"] = df["PARA"].map(normalize_eap)

    df = df[
        df["DATA_NEW"].notna()
        & df["UID_IDPMTS"].notna()
        & df["PARA"].notna()
    ].copy()

    # Duplicatas exatas de auditoria não devem criar permanências artificiais
    df = df.drop_duplicates(
        subset=["UID_IDPMTS", "COLUNA", "DE", "PARA", "DATA_NEW"]
    )

    return df.sort_values(["UID_IDPMTS", "DATA_NEW"]).reset_index(drop=True)


def reconstruct_eap_intervals(compare: pd.DataFrame) -> pd.DataFrame:
    """
    Cada mudança DE -> PARA em DATA_NEW significa entrada em PARA.

    A permanência em PARA termina na DATA_NEW da próxima mudança da mesma obra.
    A última permanência fica censurada e não entra na distribuição de duração.
    """
    df = prepare_compare(compare)

    df["NEXT_DATA_NEW"] = df.groupby("UID_IDPMTS")["DATA_NEW"].shift(-1)
    df["NEXT_EAP"] = df.groupby("UID_IDPMTS")["PARA"].shift(-1)

    intervals = df.rename(
        columns={
            "PARA": "EAP",
            "DATA_NEW": "ENTRADA_EM",
        }
    ).copy()

    intervals["SAIDA_EM"] = intervals["NEXT_DATA_NEW"]
    intervals["DURACAO_DIAS"] = (
        intervals["SAIDA_EM"] - intervals["ENTRADA_EM"]
    ).dt.total_seconds() / 86400.0

    intervals["IS_CENSORED"] = intervals["SAIDA_EM"].isna()

    # Só permanências completas e temporalmente válidas entram no treinamento
    intervals["VALID_FOR_TRAINING"] = (
        ~intervals["IS_CENSORED"]
        & intervals["DURACAO_DIAS"].notna()
        & (intervals["DURACAO_DIAS"] >= 0)
        & intervals["NEXT_EAP"].notna()
    )

    intervals["ORDEM_VISITA"] = (
        intervals.groupby(["UID_IDPMTS", "EAP"]).cumcount() + 1
    )

    return intervals[
        [
            "UID_IDPMTS",
            "DE",
            "EAP",
            "NEXT_EAP",
            "ENTRADA_EM",
            "SAIDA_EM",
            "DURACAO_DIAS",
            "ORDEM_VISITA",
            "IS_CENSORED",
            "VALID_FOR_TRAINING",
        ]
    ].copy()


def attach_current_attributes(
    intervals: pd.DataFrame,
    reference: pd.DataFrame,
) -> pd.DataFrame:
    attrs = [
        c for c in [
            "UID_IDPMTS",
            "UID_UFSIGLA",
            "PMO_PROJETO",
            "PMO_REGIONAL",
            "MASTEROBRA_OBJ_ENG",
            "VENDOR_INSTALADOR",
            "VENDOR_PROJETO",
            "VENDOR_EQUIPAMENTO",
            "RSO_RSA_DETENTORA",
            "PMO_TECN_EQUIP",
            "PMO_FREQ_EQUIP",
        ]
        if c in reference.columns
    ]

    ref = reference[attrs].drop_duplicates("UID_IDPMTS")

    return intervals.merge(
        ref,
        on="UID_IDPMTS",
        how="left",
        validate="many_to_one",
    )


# =============================================================================
# POOLS EMPÍRICOS DE TRANSIÇÃO
# =============================================================================

@dataclass
class TransitionPool:
    durations: np.ndarray
    next_eaps: np.ndarray
    work_ids: np.ndarray
    level: str

    @property
    def n(self) -> int:
        return len(self.durations)

    @property
    def n_works(self) -> int:
        return pd.Series(self.work_ids).nunique()


def _clean_key(value) -> str:
    if pd.isna(value):
        return "__NA__"
    return str(value).strip()


def build_transition_pools(intervals: pd.DataFrame):
    """
    Fallback hierárquico:

    1. EAP + projeto + regional
    2. EAP + projeto
    3. EAP global

    Vendors são mantidos na tabela ouro e podem entrar como nível adicional
    depois que houver diagnóstico de amostra suficiente.
    """
    train = intervals[intervals["VALID_FOR_TRAINING"]].copy()

    for c in ["PMO_PROJETO", "PMO_REGIONAL"]:
        if c not in train.columns:
            train[c] = "__NA__"
        train[c] = train[c].map(_clean_key)

    train["EAP"] = train["EAP"].map(normalize_eap)
    train["NEXT_EAP"] = train["NEXT_EAP"].map(normalize_eap)

    pools: Dict[Tuple, TransitionPool] = {}

    levels = [
        ("project_regional", ["EAP", "PMO_PROJETO", "PMO_REGIONAL"]),
        ("project", ["EAP", "PMO_PROJETO"]),
        ("global_eap", ["EAP"]),
    ]

    for level_name, group_cols in levels:
        grouper = group_cols[0] if len(group_cols) == 1 else group_cols
        for key, g in train.groupby(grouper, dropna=False):
            if not isinstance(key, tuple):
                key = (key,)

            full_key = (level_name,) + tuple(_clean_key(x) for x in key)

            pools[full_key] = TransitionPool(
                durations=g["DURACAO_DIAS"].to_numpy(dtype=float),
                next_eaps=g["NEXT_EAP"].astype(str).to_numpy(),
                work_ids=g["UID_IDPMTS"].to_numpy(),
                level=level_name,
            )

    return pools


def select_transition_pool(
    pools: Dict[Tuple, TransitionPool],
    eap: str,
    project,
    regional,
    cfg: Config = CFG,
) -> Optional[TransitionPool]:
    eap = _clean_key(eap)
    project = _clean_key(project)
    regional = _clean_key(regional)

    candidate_keys = [
        ("project_regional", eap, project, regional),
        ("project", eap, project),
        ("global_eap", eap),
    ]

    # Primeiro tenta respeitar amostra mínima
    for key in candidate_keys:
        pool = pools.get(key)
        if pool is not None and pool.n >= cfg.min_transition_samples:
            return pool

    # Se não houver amostra mínima, aceita o pool global da EAP se existir
    return pools.get(("global_eap", eap))


# =============================================================================
# ESTADO ATUAL / AGING DA EAP
# =============================================================================

def current_eap_entry_info(
    scope: pd.DataFrame,
    compare: pd.DataFrame,
    as_of: pd.Timestamp,
) -> pd.DataFrame:
    """
    Procura a última transição registrada de cada obra.

    Se a última PARA da compare coincide com a EAP atual da PMTS, usa DATA_NEW
    como última entrada na EAP.
    """
    comp = prepare_compare(compare)

    last = (
        comp.sort_values(["UID_IDPMTS", "DATA_NEW"])
        .groupby("UID_IDPMTS", as_index=False)
        .tail(1)
        [["UID_IDPMTS", "PARA", "DATA_NEW"]]
        .rename(
            columns={
                "PARA": "COMPARE_LAST_EAP",
                "DATA_NEW": "EAP_ATUAL_ENTRADA_EM",
            }
        )
    )

    out = scope.merge(last, on="UID_IDPMTS", how="left")

    out["EAP_AUTOMATICA"] = out["EAP_AUTOMATICA"].map(normalize_eap)
    out["COMPARE_LAST_EAP"] = out["COMPARE_LAST_EAP"].map(normalize_eap)

    out["EAP_COMPARE_CONSISTENTE"] = (
        out["EAP_AUTOMATICA"] == out["COMPARE_LAST_EAP"]
    )

    out["DIAS_STREAK_EAP_ATUAL"] = np.where(
        out["EAP_COMPARE_CONSISTENTE"]
        & out["EAP_ATUAL_ENTRADA_EM"].notna(),
        (
            as_of.normalize() - out["EAP_ATUAL_ENTRADA_EM"].dt.normalize()
        ).dt.days,
        np.nan,
    )

    return out


