def build_training_v2(
    history: pd.DataFrame,
    compare: pd.DataFrame,
    history_time_col: str,
    as_of: pd.Timestamp,
    cfg: ConfigV2 = CFG,
):
    hist_events, hist_intervals = build_history_events_and_intervals(
        history, history_time_col, cfg
    )

    compare_events = prepare_compare_events(compare, cfg)
    compare_events_out, compare_intervals = enrich_compare_intervals_point_in_time(
        compare_events, history, history_time_col, cfg
    )

    intervals = pd.concat(
        [hist_intervals, compare_intervals],
        ignore_index=True,
        sort=False,
    )
    intervals = annotate_training_quality(intervals, as_of, cfg)

    return (
        hist_events,
        compare_events_out,
        intervals,
        build_outlier_audit(intervals),
        build_eap_year_trend(intervals),
    )


def build_gold_risk_v2(
    scope: pd.DataFrame,
    history: pd.DataFrame,
    compare: pd.DataFrame,
    history_time_col: str,
    cfg: ConfigV2 = CFG,
    as_of: Optional[pd.Timestamp] = None,
):
    as_of = pd.Timestamp(as_of or date.today())

    (
        hist_events,
        compare_events,
        train,
        outlier_audit,
        eap_year_trend,
    ) = build_training_v2(
        history=history,
        compare=compare,
        history_time_col=history_time_col,
        as_of=as_of,
        cfg=cfg,
    )

    logger.info(
        "Treino V2 | intervalos=%s | válidos=%s | histórica=%s | compare=%s",
        len(train),
        int(train["VALID_FOR_TRAINING"].sum()),
        int((train["SOURCE"] == "PMTS_HISTORICO").sum()),
        int((train["SOURCE"] == "BASE_COMPARE").sum()),
    )

    scope_current = current_eap_entry_info_v2(
        scope,
        hist_events,
        compare_events,
        as_of,
    )

    eap_samples = build_eap_base_samples(train)
    rng = np.random.default_rng(cfg.random_seed)
    pool_cache = {}

    predictions = []
    for i, (_, row) in enumerate(scope_current.iterrows(), start=1):
        predictions.append(
            simulate_one_work_v2(
                row=row,
                eap_samples=eap_samples,
                as_of=as_of,
                cfg=cfg,
                rng=rng,
                pool_cache=pool_cache,
            )
        )
        if i % 100 == 0:
            logger.info("V2 processadas %s/%s obras", i, len(scope_current))

    pred_df = pd.DataFrame(predictions)
    gold = pd.concat(
        [scope_current.reset_index(drop=True), pred_df],
        axis=1,
    )

    gold["PROB_CUMPRIR_CARIMBO_PCT"] = (
        gold["PROB_CUMPRIR_CARIMBO"] * 100
    ).round(1)
    gold["PROB_ATRASAR_PCT"] = (
        gold["PROB_ATRASAR"] * 100
    ).round(1)
    gold["DATA_REFERENCIA_MODELO"] = as_of.normalize()
    gold["P80_ESTOURA_CARIMBO"] = (
        pd.to_datetime(gold["DATA_P80"], errors="coerce")
        > pd.to_datetime(gold["PMO_CARIMBO_CENTRALIZADO"], errors="coerce")
    )

    return gold, train, outlier_audit, eap_year_trend


def save_outputs_v2(
    gold: pd.DataFrame,
    train: pd.DataFrame,
    outlier_audit: pd.DataFrame,
    eap_year_trend: pd.DataFrame,
    cfg: ConfigV2 = CFG,
):
    out = Path(cfg.output_dir)
    out.mkdir(parents=True, exist_ok=True)

    stamp = pd.Timestamp.today().strftime("%Y%m%d")
    path = out / f"pmts_risk_v2_{stamp}.xlsx"

    with pd.ExcelWriter(path) as writer:
        gold.to_excel(writer, sheet_name="gold_pmts_risk_v2", index=False)
        train.to_excel(writer, sheet_name="training_intervals_v2", index=False)
        outlier_audit.to_excel(writer, sheet_name="outlier_audit", index=False)
        eap_year_trend.to_excel(writer, sheet_name="eap_year_trend", index=False)

    logger.info("Arquivo V2 salvo em %s", path)
    return path


def run_pipeline_v2_with_c(
    C,
    cfg: ConfigV2 = CFG,
    as_of: Optional[pd.Timestamp] = None,
    banco: str = "prod",
):
    scope, current, history, compare, history_time_col = load_data_v2_with_c(
        C=C,
        cfg=cfg,
        banco=banco,
    )

    gold, train, outlier_audit, trend = build_gold_risk_v2(
        scope=scope,
        history=history,
        compare=compare,
        history_time_col=history_time_col,
        cfg=cfg,
        as_of=as_of,
    )

    save_outputs_v2(
        gold=gold,
        train=train,
        outlier_audit=outlier_audit,
        eap_year_trend=trend,
        cfg=cfg,
    )

    return gold, train, outlier_audit, trend


