def split_schema_table(full_name: str) -> Tuple[str, str]:
    parts = full_name.split(".", 1)
    if len(parts) != 2:
        raise ValueError(f"Use schema.tabela. Recebido: {full_name!r}")
    return parts[0], parts[1]


def normalize_text(v):
    if pd.isna(v):
        return pd.NA
    s = str(v).strip()
    if not s or s.upper() in {"NAN", "NONE", "NULL", "<NA>"}:
        return pd.NA
    return s


def normalize_eap(v):
    return normalize_text(v)


def eap_order(v) -> Optional[int]:
    s = normalize_text(v)
    if pd.isna(s):
        return None
    m = re.match(r"^\s*(\d+)", str(s))
    return int(m.group(1)) if m else None


def same_nonempty(a, b) -> bool:
    a = normalize_text(a)
    b = normalize_text(b)
    return pd.notna(a) and pd.notna(b) and str(a).upper() == str(b).upper()


def normalize_valid_flag(series: pd.Series) -> pd.Series:
    return (
        series.astype("string")
        .str.strip()
        .str.upper()
        .str.replace("[", "", regex=False)
        .str.replace("]", "", regex=False)
    )


def effective_sample_size(weights: np.ndarray) -> float:
    w = np.asarray(weights, dtype=float)
    s1 = w.sum()
    s2 = np.square(w).sum()
    if s1 <= 0 or s2 <= 0:
        return 0.0
    return float((s1 * s1) / s2)


