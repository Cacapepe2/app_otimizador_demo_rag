# Monte Carlo
# =============================================================================

def percentile_date(as_of, completion_days, q):
    if len(completion_days) == 0:
        return pd.NaT
    return as_of.normalize() + pd.to_timedelta(
        float(np.quantile(completion_days, q)), unit="D"
    )


def risk_class(p):
    if pd.isna(p):
        return "SEM_MODELO"
    if p >= 0.90:
        return "BAIXO"
    if p >= 0.70:
        return "ATENCAO"
    if p >= 0.40:
        return "ALTO"
    return "CRITICO"


def confidence_class(score):
    if score >= 80:
        return "ALTA"
    if score >= 60:
        return "MEDIA"
    return "BAIXA"


def confidence_score_v2(
    effective_n: float,
    resolution_rate: float,
    mc_margin_95_pp: float,
    eap_consistent: bool,
):
    support = min(
        1.0,
        math.log1p(max(0.0, effective_n)) / math.log1p(120.0)
    )
    resolution = float(np.clip(resolution_rate, 0, 1))
    precision = float(
        np.clip(1.0 - (mc_margin_95_pp - 0.8) / 3.2, 0, 1)
    )
    consistency = 1.0 if eap_consistent else 0.35

    return round(
        100
        * (
            0.45 * support
            + 0.30 * resolution
            + 0.15 * precision
            + 0.10 * consistency
        ),
        1,
    )


def simulate_one_work_v2(
    row: pd.Series,
    eap_samples: Dict[str, pd.DataFrame],
    as_of: pd.Timestamp,
    cfg: ConfigV2,
    rng: np.random.Generator,
    pool_cache: dict,
):
    start_eap = normalize_eap(row.get("EAP_AUTOMATICA"))
    deadline = pd.to_datetime(
        row.get("PMO_CARIMBO_CENTRALIZADO"), errors="coerce"
    )

    result = {
        "PROB_CUMPRIR_CARIMBO": np.nan,
        "PROB_ATRASAR": np.nan,
        "DATA_P50": pd.NaT,
        "DATA_P70": pd.NaT,
        "DATA_P80": pd.NaT,
        "DATA_P90": pd.NaT,
        "RISCO": "SEM_MODELO",
        "MODEL_CONFIDENCE": 0.0,
        "CONFIDENCE_CLASS": "BAIXA",
        "MC_MARGIN_95_PP": np.nan,
        "N_HISTORICO_EAP": 0,
        "N_EFETIVO_PONDERADO": 0.0,
        "DETENTORA_APLICADA": False,
        "RESOLUTION_RATE": 0.0,
        "MODEL_STATUS": "OK",
    }

    if pd.isna(deadline):
        result["MODEL_STATUS"] = "CARIMBO_INVALIDO"
        return result

    if pd.isna(start_eap):
        result["MODEL_STATUS"] = "EAP_ATUAL_INVALIDA"
        return result

    if start_eap in cfg.final_eaps:
        result["MODEL_STATUS"] = "REVISAR_EAP_FINAL_COM_VALID_N"
        return result

    if deadline.normalize() < as_of.normalize():
        result.update(
            {
                "PROB_CUMPRIR_CARIMBO": 0.0,
                "PROB_ATRASAR": 1.0,
                "RISCO": "CRITICO",
                "MODEL_STATUS": "CARIMBO_JA_VENCIDO",
            }
        )
        return result

    context_key_base = tuple(
        normalize_text(row.get(c)) for c in CONTEXT_COLUMNS
    )

    def get_pool(eap):
        key = (str(eap),) + context_key_base
        if key not in pool_cache:
            pool_cache[key] = build_context_pool(
                eap_samples.get(str(eap)),
                row,
                str(eap),
                cfg,
            )
        return pool_cache[key]

    start_pool = get_pool(start_eap)
    if start_pool is None:
        result["MODEL_STATUS"] = "SEM_HISTORICO_PARA_EAP_ATUAL"
        return result

    elapsed = row.get("DIAS_STREAK_EAP_ATUAL")
    elapsed = float(elapsed) if pd.notna(elapsed) and elapsed >= 0 else 0.0

    completion_days = []

    for _ in range(cfg.n_simulations):
        current = start_eap
        total_days = 0.0

        for step in range(cfg.max_steps):
            if current in cfg.final_eaps:
                break

            pool = get_pool(current)
            if pool is None:
                break

            durations = pool.durations
            probs = pool.probs
            next_eaps = pool.next_eaps

            if step == 0 and elapsed > 0:
                eligible = np.flatnonzero(durations > elapsed)

                if len(eligible) >= cfg.min_residual_samples:
                    p = probs[eligible]
                    p = p / p.sum()
                    idx = int(rng.choice(eligible, p=p))
                    duration = max(0.0, durations[idx] - elapsed)
                else:
                    idx = int(rng.choice(len(durations), p=probs))
                    duration = max(0.0, durations[idx] - elapsed)
            else:
                idx = int(rng.choice(len(durations), p=probs))
                duration = max(0.0, durations[idx])

            total_days += duration
            current = normalize_eap(next_eaps[idx])

        if current in cfg.final_eaps:
            completion_days.append(total_days)

    completion_days = np.asarray(completion_days, dtype=float)
    resolution_rate = len(completion_days) / cfg.n_simulations

    deadline_days = max(
        0.0,
        (deadline.normalize() - as_of.normalize()).days,
    )

    on_time = int(np.sum(completion_days <= deadline_days))
    p_on_time = on_time / cfg.n_simulations
    p_late = 1 - p_on_time

    mc_se = math.sqrt(
        max(p_on_time * (1 - p_on_time), 0.0)
        / cfg.n_simulations
    )
    margin = 1.96 * mc_se * 100

    conf = confidence_score_v2(
        effective_n=start_pool.effective_n,
        resolution_rate=resolution_rate,
        mc_margin_95_pp=margin,
        eap_consistent=bool(row.get("EAP_HISTORY_CONSISTENTE", False)),
    )

    result.update(
        {
            "PROB_CUMPRIR_CARIMBO": round(p_on_time, 4),
            "PROB_ATRASAR": round(p_late, 4),
            "DATA_P50": percentile_date(as_of, completion_days, 0.50),
            "DATA_P70": percentile_date(as_of, completion_days, 0.70),
            "DATA_P80": percentile_date(as_of, completion_days, 0.80),
            "DATA_P90": percentile_date(as_of, completion_days, 0.90),
            "RISCO": risk_class(p_on_time),
            "MODEL_CONFIDENCE": conf,
            "CONFIDENCE_CLASS": confidence_class(conf),
            "MC_MARGIN_95_PP": round(margin, 2),
            "N_HISTORICO_EAP": int(start_pool.raw_n),
            "N_EFETIVO_PONDERADO": round(start_pool.effective_n, 1),
            "DETENTORA_APLICADA": start_pool.detentora_aplicada,
            "RESOLUTION_RATE": round(resolution_rate, 4),
        }
    )

    return result


