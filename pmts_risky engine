def prepare_compare_events(compare: pd.DataFrame, cfg: ConfigV2 = CFG):
    c = compare.copy()
    c["DE"] = c["DE"].map(normalize_eap)
    c["PARA"] = c["PARA"].map(normalize_eap)
    c["DATA_NEW"] = pd.to_datetime(c["DATA_NEW"], errors="coerce")

    c = c[
        c["UID_IDPMTS"].notna()
        & c["PARA"].notna()
        & c["DATA_NEW"].notna()
        & c["DATA_NEW"].ge(pd.Timestamp(cfg.compare_start_date))
    ].copy()

    c = (
        c.drop_duplicates(
            subset=["UID_IDPMTS", "DE", "PARA", "DATA_NEW"]
        )
        .sort_values(["UID_IDPMTS", "DATA_NEW"])
    )

    events = c.rename(
        columns={"PARA": "EAP", "DATA_NEW": "ENTRADA_EM"}
    ).copy()

    events["NEXT_DATA"] = events.groupby("UID_IDPMTS")["ENTRADA_EM"].shift(-1)
    events["NEXT_EAP"] = events.groupby("UID_IDPMTS")["EAP"].shift(-1)
    return events


def enrich_compare_intervals_point_in_time(
    compare_events: pd.DataFrame,
    history: pd.DataFrame,
    history_time_col: str,
    cfg: ConfigV2 = CFG,
):
    intervals = compare_events.copy()
    intervals["SAIDA_EM"] = intervals["NEXT_DATA"]
    intervals["DURACAO_DIAS"] = (
        intervals["SAIDA_EM"] - intervals["ENTRADA_EM"]
    ).dt.total_seconds() / 86400.0

    intervals = intervals[
        intervals["SAIDA_EM"].notna()
        & intervals["NEXT_EAP"].notna()
    ].copy()

    attr_cols = [c for c in CONTEXT_COLUMNS if c in history.columns]
    hist_ctx = history[
        ["UID_IDPMTS", history_time_col] + attr_cols
    ].copy()

    hist_ctx = hist_ctx[
        hist_ctx["UID_IDPMTS"].notna()
        & hist_ctx[history_time_col].notna()
    ]

    left = intervals.sort_values(["ENTRADA_EM", "UID_IDPMTS"]).copy()
    right = hist_ctx.sort_values([history_time_col, "UID_IDPMTS"]).copy()

    merged = pd.merge_asof(
        left,
        right,
        left_on="ENTRADA_EM",
        right_on=history_time_col,
        by="UID_IDPMTS",
        direction="backward",
        allow_exact_matches=True,
    )

    merged["CONTEXT_AGE_DAYS"] = (
        merged["ENTRADA_EM"] - merged[history_time_col]
    ).dt.total_seconds() / 86400.0

    stale = (
        merged["CONTEXT_AGE_DAYS"].isna()
        | merged["CONTEXT_AGE_DAYS"].gt(cfg.max_context_age_days)
        | merged["CONTEXT_AGE_DAYS"].lt(0)
    )

    for col in attr_cols:
        merged.loc[stale, col] = pd.NA

    merged["SOURCE"] = "BASE_COMPARE"
    merged["CONTEXT_SOURCE"] = np.where(
        stale,
        "SEM_CONTEXTO_POINT_IN_TIME",
        "PMTS_HISTORICO_ASOF",
    )

    keep = [
        "UID_IDPMTS", "DE", "EAP", "NEXT_EAP",
        "ENTRADA_EM", "SAIDA_EM", "DURACAO_DIAS",
        "SOURCE", "CONTEXT_SOURCE", "CONTEXT_AGE_DAYS",
    ] + attr_cols

    compare_events_out = compare_events[
        ["UID_IDPMTS", "DE", "EAP", "ENTRADA_EM"]
    ].copy()
    compare_events_out["SOURCE"] = "BASE_COMPARE"

    return compare_events_out, merged[keep].copy()


# =============================================================================
# Outliers + recência
# =============================================================================

def annotate_training_quality(
    intervals: pd.DataFrame,
    as_of: pd.Timestamp,
    cfg: ConfigV2 = CFG,
):
    df = intervals.copy()
    df["DURACAO_DIAS"] = pd.to_numeric(df["DURACAO_DIAS"], errors="coerce")

    df["QUALITY_STATUS"] = "OK"
    df["QUALITY_WEIGHT"] = 1.0
    df["VALID_FOR_TRAINING"] = True

    invalid = (
        df["DURACAO_DIAS"].isna()
        | df["NEXT_EAP"].isna()
        | df["EAP"].isna()
    )
    df.loc[invalid, "VALID_FOR_TRAINING"] = False
    df.loc[invalid, "QUALITY_STATUS"] = "INVALID_MISSING"

    negative = df["DURACAO_DIAS"].lt(0)
    df.loc[negative, "VALID_FOR_TRAINING"] = False
    df.loc[negative, "QUALITY_STATUS"] = "INVALID_NEGATIVE"

    # 0 dia pode ser uma transição automática. Mantemos, mas com peso baixo.
    zero = df["DURACAO_DIAS"].eq(0) & df["VALID_FOR_TRAINING"]
    df.loc[zero, "QUALITY_WEIGHT"] *= cfg.zero_duration_weight
    df.loc[zero, "QUALITY_STATUS"] = "ZERO_DOWNWEIGHTED"

    # >3 anos é tratado como provável problema/fluxo incompatível.
    hard = (
        df["DURACAO_DIAS"].gt(cfg.hard_max_duration_days)
        & df["VALID_FOR_TRAINING"]
    )
    df.loc[hard, "VALID_FOR_TRAINING"] = False
    df.loc[hard, "QUALITY_STATUS"] = "HARD_OUTLIER_GT_3Y"

    df["ROBUST_UPPER_BOUND"] = np.nan

    # Regra robusta por EAP: Q3 + 3*IQR. Não apaga, apenas reduz peso.
    for _, idx in df[df["VALID_FOR_TRAINING"]].groupby("EAP").groups.items():
        vals = df.loc[idx, "DURACAO_DIAS"]
        positive = vals[vals > 0]
        if len(positive) < cfg.min_group_for_outlier_rule:
            continue

        q1 = positive.quantile(0.25)
        q3 = positive.quantile(0.75)
        iqr = q3 - q1
        upper = q3 + cfg.outlier_iqr_multiplier * iqr
        df.loc[idx, "ROBUST_UPPER_BOUND"] = upper

        robust_mask = (
            df.loc[idx, "DURACAO_DIAS"].gt(upper)
            & df.loc[idx, "VALID_FOR_TRAINING"]
        )
        robust_idx = robust_mask[robust_mask].index
        df.loc[robust_idx, "QUALITY_WEIGHT"] *= cfg.robust_outlier_weight
        df.loc[robust_idx, "QUALITY_STATUS"] = "ROBUST_OUTLIER_DOWNWEIGHTED"

    age_days = (
        as_of.normalize()
        - pd.to_datetime(df["ENTRADA_EM"]).dt.normalize()
    ).dt.days.clip(lower=0)

    # Processo mais recente recebe peso maior.
    df["RECENCY_WEIGHT"] = np.maximum(
        cfg.min_recency_weight,
        np.power(0.5, age_days / cfg.recency_half_life_days),
    )

    df["BASE_WEIGHT"] = df["QUALITY_WEIGHT"] * df["RECENCY_WEIGHT"]
    df["TRAIN_YEAR"] = pd.to_datetime(df["ENTRADA_EM"]).dt.year

    return df


def build_outlier_audit(train: pd.DataFrame) -> pd.DataFrame:
    return (
        train.groupby(["EAP", "QUALITY_STATUS"], dropna=False)
        .agg(
            N=("UID_IDPMTS", "size"),
            N_OBRAS=("UID_IDPMTS", "nunique"),
            MEDIANA_DIAS=("DURACAO_DIAS", "median"),
            MAX_DIAS=("DURACAO_DIAS", "max"),
        )
        .reset_index()
        .sort_values(["EAP", "QUALITY_STATUS"])
    )


def build_eap_year_trend(train: pd.DataFrame) -> pd.DataFrame:
    valid = train[
        train["VALID_FOR_TRAINING"]
        & train["DURACAO_DIAS"].gt(0)
    ].copy()

    return (
        valid.groupby(["EAP", "TRAIN_YEAR"], dropna=False)
        .agg(
            N=("UID_IDPMTS", "size"),
            N_OBRAS=("UID_IDPMTS", "nunique"),
            P50_DIAS=("DURACAO_DIAS", "median"),
            MEDIA_DIAS=("DURACAO_DIAS", "mean"),
            P80_DIAS=("DURACAO_DIAS", lambda x: x.quantile(0.80)),
            P90_DIAS=("DURACAO_DIAS", lambda x: x.quantile(0.90)),
        )
        .reset_index()
        .sort_values(["EAP", "TRAIN_YEAR"])
    )


