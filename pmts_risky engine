def discover_table_columns_with_c(C, full_table: str, banco: str = "prod") -> List[str]:
    schema, table = split_schema_table(full_table)
    try:
        info = C.read_sql(
            "information_schema",
            "columns",
            banco,
            colunas="TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME",
        )
        mask = (
            info["TABLE_SCHEMA"].astype("string").str.lower().eq(schema.lower())
            & info["TABLE_NAME"].astype("string").str.lower().eq(table.lower())
        )
        cols = info.loc[mask, "COLUMN_NAME"].astype(str).tolist()
        if cols:
            return cols
    except Exception as exc:
        warnings.warn(
            f"Não foi possível consultar INFORMATION_SCHEMA para {full_table}: {exc}"
        )
    raise RuntimeError(
        f"Não consegui descobrir as colunas de {full_table}. "
        "Defina a coluna temporal manualmente e ajuste as colunas consultadas."
    )


def detect_history_time_col(
    available_columns: Sequence[str],
    cfg: ConfigV2,
) -> str:
    if cfg.history_time_col:
        if cfg.history_time_col not in available_columns:
            raise ValueError(
                f"history_time_col={cfg.history_time_col!r} não existe na histórica."
            )
        return cfg.history_time_col

    available_upper = {c.upper(): c for c in available_columns}
    for candidate in cfg.history_time_candidates:
        if candidate.upper() in available_upper:
            return available_upper[candidate.upper()]

    raise ValueError(
        "Não consegui identificar a coluna temporal da pmts_rf_historico. "
        f"Defina ConfigV2(history_time_col='NOME_REAL'). "
        f"Candidatas: {cfg.history_time_candidates}"
    )


def c_read_with_optional_where(
    C,
    schema: str,
    table: str,
    banco: str,
    columns: Sequence[str],
    where_clause: Optional[str] = None,
) -> pd.DataFrame:
    """
    Só usa filtro no servidor se C.read_sql expuser explicitamente um argumento
    conhecido. Caso contrário, lê as colunas e filtra em pandas.
    """
    kwargs = {"colunas": ", ".join(columns)}
    where_param = None

    if where_clause:
        try:
            params = inspect.signature(C.read_sql).parameters
        except Exception:
            params = {}

        for name in ("where", "filtro", "where_clause", "condicao"):
            if name in params:
                where_param = name
                break

        if where_param:
            kwargs[where_param] = where_clause
        else:
            logger.warning(
                "C.read_sql não expôs parâmetro WHERE conhecido. "
                "Filtro será aplicado em pandas."
            )

    try:
        return C.read_sql(schema, table, banco, **kwargs)
    except Exception:
        if where_param:
            logger.warning("WHERE server-side falhou; retry sem WHERE.")
            kwargs.pop(where_param, None)
            return C.read_sql(schema, table, banco, **kwargs)
        raise


def load_data_v2_with_c(
    C,
    cfg: ConfigV2 = CFG,
    banco: str = "prod",
):
    pmts_cols = discover_table_columns_with_c(C, cfg.pmts_table, banco)
    hist_cols = discover_table_columns_with_c(C, cfg.history_table, banco)
    cmp_cols = discover_table_columns_with_c(C, cfg.compare_table, banco)

    required_current = {
        "UID_IDPMTS",
        "UID_UFSIGLA",
        "PMO_ROLLOUT_OVBK",
        "MASTEROBRA_STATUS_ROLLOUT",
        "PMO_CARIMBO_CENTRALIZADO",
        "VALID_ATIVACAO",
        "EAP_AUTOMATICA",
    }
    missing = required_current - set(pmts_cols)
    if missing:
        raise ValueError(f"PMTS atual sem colunas obrigatórias: {sorted(missing)}")

    history_time_col = detect_history_time_col(hist_cols, cfg)
    logger.info("Coluna temporal histórica: %s", history_time_col)

    current_select = [c for c in BASE_COLUMNS if c in pmts_cols]
    history_select = list(dict.fromkeys(
        ["UID_IDPMTS", history_time_col, "EAP_AUTOMATICA"]
        + [c for c in CONTEXT_COLUMNS if c in hist_cols]
    ))

    compare_required = ["UID_IDPMTS", "COLUNA", "DE", "PARA", "DATA_NEW"]
    missing_cmp = [c for c in compare_required if c not in cmp_cols]
    if missing_cmp:
        raise ValueError(
            f"base_compare_pmts_rf sem colunas obrigatórias: {missing_cmp}"
        )

    ps, pt = split_schema_table(cfg.pmts_table)
    pmts = C.read_sql(ps, pt, banco, colunas=", ".join(current_select))
    pmts["PMO_CARIMBO_CENTRALIZADO"] = pd.to_datetime(
        pmts["PMO_CARIMBO_CENTRALIZADO"], errors="coerce"
    )

    valid_target = normalize_valid_flag(
        pd.Series([cfg.valid_ativacao_open_value])
    ).iloc[0]
    valid_series = normalize_valid_flag(pmts["VALID_ATIVACAO"])

    scope = pmts[
        pmts["PMO_ROLLOUT_OVBK"].astype("string").str.strip().eq(cfg.budget_value)
        & pmts["MASTEROBRA_STATUS_ROLLOUT"].astype("string").str.strip().eq(cfg.rollout_status)
        & pmts["PMO_CARIMBO_CENTRALIZADO"].dt.year.eq(cfg.target_carimbo_year)
        & valid_series.eq(valid_target)
    ].copy()

    cs, ct = split_schema_table(cfg.compare_table)
    compare = c_read_with_optional_where(
        C,
        cs,
        ct,
        banco,
        compare_required,
        where_clause=(
            f"COLUNA = 'EAP_AUTOMATICA' "
            f"AND DATA_NEW >= '{cfg.compare_start_date}'"
        ),
    )
    compare["DATA_NEW"] = pd.to_datetime(compare["DATA_NEW"], errors="coerce")
    compare = compare[
        compare["COLUNA"].astype("string").eq("EAP_AUTOMATICA")
        & compare["DATA_NEW"].ge(pd.Timestamp(cfg.compare_start_date))
        & compare["DATA_NEW"].notna()
    ].copy()

    hs, ht = split_schema_table(cfg.history_table)
    history = c_read_with_optional_where(
        C,
        hs,
        ht,
        banco,
        history_select,
        where_clause=f"{history_time_col} >= '{cfg.history_start_date}'",
    )
    history[history_time_col] = pd.to_datetime(
        history[history_time_col], errors="coerce"
    )
    history = history[
        history[history_time_col].ge(pd.Timestamp(cfg.history_start_date))
        & history[history_time_col].notna()
    ].copy()

    logger.info(
        "Dados | alvo=%s | PMTS=%s | histórica=%s | compare=%s",
        scope["UID_IDPMTS"].nunique(),
        len(pmts),
        len(history),
        len(compare),
    )

    return scope, pmts, history, compare, history_time_col


