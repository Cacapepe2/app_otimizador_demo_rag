# Pool ponderado por similaridade
# =============================================================================

@dataclass
class WeightedTransitionPool:
    durations: np.ndarray
    next_eaps: np.ndarray
    probs: np.ndarray
    work_ids: np.ndarray
    raw_n: int
    effective_n: float
    detentora_aplicada: bool


def build_eap_base_samples(train: pd.DataFrame) -> Dict[str, pd.DataFrame]:
    valid = train[
        train["VALID_FOR_TRAINING"]
        & train["BASE_WEIGHT"].gt(0)
    ].copy()

    return {
        str(eap): g.reset_index(drop=True)
        for eap, g in valid.groupby("EAP", dropna=False)
        if pd.notna(eap)
    }


def build_context_pool(
    samples: pd.DataFrame,
    current_row: pd.Series,
    current_eap: str,
    cfg: ConfigV2 = CFG,
) -> Optional[WeightedTransitionPool]:
    if samples is None or samples.empty:
        return None

    weights = samples["BASE_WEIGHT"].to_numpy(dtype=float).copy()
    order = eap_order(current_eap)

    def apply_bonus(col: str, factor: float):
        nonlocal weights
        if col not in samples.columns or col not in current_row.index:
            return
        current = current_row.get(col)
        if pd.isna(normalize_text(current)):
            return
        match = samples[col].map(lambda x: same_nonempty(x, current)).to_numpy()
        weights[match] *= factor

    apply_bonus("PMO_PROJETO", cfg.bonus_project)
    apply_bonus("PMO_REGIONAL", cfg.bonus_regional)
    apply_bonus("PMO_UF", cfg.bonus_uf)

    detentora_aplicada = False
    if order is not None and order <= cfg.detentora_max_eap_order:
        det = current_row.get("RSO_RSA_DETENTORA")
        if pd.notna(normalize_text(det)):
            apply_bonus("RSO_RSA_DETENTORA", cfg.bonus_detentora_early)
            detentora_aplicada = True

    if order is not None and cfg.vendor_project_eap_min <= order <= cfg.vendor_project_eap_max:
        apply_bonus("VENDOR_PROJETO", cfg.bonus_vendor_project)

    if order is not None and cfg.vendor_install_eap_min <= order <= cfg.vendor_install_eap_max:
        apply_bonus("VENDOR_INSTALADOR", cfg.bonus_vendor_install)

    if order is not None and cfg.vendor_equipment_eap_min <= order <= cfg.vendor_equipment_eap_max:
        apply_bonus("VENDOR_EQUIPAMENTO", cfg.bonus_vendor_equipment)

    if order is not None and cfg.vendor_vistoria_eap_min <= order <= cfg.vendor_vistoria_eap_max:
        apply_bonus("VENDOR_VISTORIA", cfg.bonus_vendor_vistoria)

    if not np.isfinite(weights).all() or weights.sum() <= 0:
        return None

    probs = weights / weights.sum()

    return WeightedTransitionPool(
        durations=samples["DURACAO_DIAS"].to_numpy(dtype=float),
        next_eaps=samples["NEXT_EAP"].astype(str).to_numpy(),
        probs=probs,
        work_ids=samples["UID_IDPMTS"].to_numpy(),
        raw_n=len(samples),
        effective_n=effective_sample_size(weights),
        detentora_aplicada=detentora_aplicada,
    )


