def percentile_date(
    as_of: pd.Timestamp,
    completion_days: np.ndarray,
    q: float,
):
    if completion_days.size == 0:
        return pd.NaT

    days = float(np.quantile(completion_days, q))
    return as_of.normalize() + pd.to_timedelta(days, unit="D")


def risk_class(prob_on_time: float) -> str:
    if pd.isna(prob_on_time):
        return "SEM_MODELO"
    if prob_on_time >= 0.90:
        return "BAIXO"
    if prob_on_time >= 0.70:
        return "ATENCAO"
    if prob_on_time >= 0.40:
        return "ALTO"
    return "CRITICO"


def confidence_class(score: float) -> str:
    if score >= 80:
        return "ALTA"
    if score >= 60:
        return "MEDIA"
    return "BAIXA"


def model_confidence_score(
    support_n_works: int,
    resolution_rate: float,
    mc_margin_95_pp: float,
    eap_consistent: bool,
) -> float:
    """
    Score heurístico de qualidade da evidência.

    NÃO é acurácia.
    A acurácia/calibração real deve vir de backtest temporal.
    """
    # ~150 obras comparáveis ou mais ~= suporte máximo
    support = min(
        1.0,
        math.log1p(max(0, support_n_works)) / math.log1p(150)
    )

    resolution = float(np.clip(resolution_rate, 0, 1))

    # Margem MC <= 1pp = excelente; >= 5pp = muito fraca
    precision = float(np.clip(1.0 - (mc_margin_95_pp - 1.0) / 4.0, 0, 1))

    consistency = 1.0 if eap_consistent else 0.35

    score = 100 * (
        0.40 * support
        + 0.35 * resolution
        + 0.15 * precision
        + 0.10 * consistency
    )
    return round(float(np.clip(score, 0, 100)), 1)


def explain_risk(
    prob_on_time: float,
    confidence: float,
    elapsed_current_eap,
    start_pool: Optional[TransitionPool],
) -> Tuple[str, str]:
    reasons = []

    if pd.notna(prob_on_time):
        if prob_on_time < 0.40:
            reasons.append("prazo historico simulado insuficiente para o carimbo")
        elif prob_on_time < 0.70:
            reasons.append("historico indica risco relevante de ultrapassar o carimbo")
        elif prob_on_time < 0.90:
            reasons.append("margem para o carimbo ainda nao e confortavel")
        else:
            reasons.append("historico indica boa margem para cumprir o carimbo")

    if (
        start_pool is not None
        and pd.notna(elapsed_current_eap)
        and start_pool.n > 0
    ):
        p80_state = float(np.quantile(start_pool.durations, 0.80))
        if float(elapsed_current_eap) > p80_state:
            reasons.append("aging atual acima do P80 historico da EAP")

    if confidence < 60:
        reasons.append("baixa confiabilidade estatistica da estimativa")

    while len(reasons) < 2:
        reasons.append("sem segundo fator dominante identificado no MVP")

    return reasons[0], reasons[1]


def simulate_one_work(
    row: pd.Series,
    pools: Dict[Tuple, TransitionPool],
    as_of: pd.Timestamp,
    cfg: Config,
    rng: np.random.Generator,
) -> dict:
    start_eap = normalize_eap(row.get("EAP_AUTOMATICA"))
    deadline = pd.to_datetime(
        row.get("PMO_CARIMBO_CENTRALIZADO"),
        errors="coerce",
    )

    result = {
        "PROB_CUMPRIR_CARIMBO": np.nan,
        "PROB_ATRASAR": np.nan,
        "DATA_P50": pd.NaT,
        "DATA_P70": pd.NaT,
        "DATA_P80": pd.NaT,
        "DATA_P90": pd.NaT,
        "RISCO": "SEM_MODELO",
        "MODEL_CONFIDENCE": 0.0,
        "CONFIDENCE_CLASS": "BAIXA",
        "MC_MARGIN_95_PP": np.nan,
        "N_HISTORICO_COMPARAVEL": 0,
        "POOL_NIVEL": None,
        "RESOLUTION_RATE": 0.0,
        "PRINCIPAL_MOTIVO_RISCO": None,
        "SEGUNDO_MOTIVO_RISCO": None,
        "MODEL_STATUS": "OK",
    }

    if pd.isna(deadline):
        result["MODEL_STATUS"] = "CARIMBO_INVALIDO"
        return result

    if not start_eap or pd.isna(start_eap):
        result["MODEL_STATUS"] = "EAP_ATUAL_INVALIDA"
        return result

    if start_eap in cfg.final_eaps:
        # Pela regra atual, target está VALID_ATIVACAO='N'.
        # EAP final + N é uma divergência operacional e não deve ser "prevista".
        result["MODEL_STATUS"] = "REVISAR_EAP_FINAL_COM_VALID_N"
        return result

    if deadline.normalize() < as_of.normalize():
        result.update(
            {
                "PROB_CUMPRIR_CARIMBO": 0.0,
                "PROB_ATRASAR": 1.0,
                "RISCO": "CRITICO",
                "MODEL_STATUS": "CARIMBO_JA_VENCIDO",
                "PRINCIPAL_MOTIVO_RISCO": "carimbo centralizado ja vencido",
                "SEGUNDO_MOTIVO_RISCO": "obra ainda nao esta ativada",
            }
        )
        return result

    project = row.get("PMO_PROJETO")
    regional = row.get("PMO_REGIONAL")
    elapsed = row.get("DIAS_STREAK_EAP_ATUAL")
    elapsed = float(elapsed) if pd.notna(elapsed) else 0.0

    start_pool = select_transition_pool(
        pools, start_eap, project, regional, cfg
    )

    if start_pool is None or start_pool.n == 0:
        result["MODEL_STATUS"] = "SEM_HISTORICO_PARA_EAP_ATUAL"
        return result

    completion_days = []
    unresolved = 0

    for _ in range(cfg.n_simulations):
        current = start_eap
        total_days = 0.0
        finished = False

        for step in range(cfg.max_steps):
            if current in cfg.final_eaps:
                finished = True
                break

            pool = select_transition_pool(
                pools, current, project, regional, cfg
            )
            if pool is None or pool.n == 0:
                break

            durations = pool.durations
            next_eaps = pool.next_eaps

            # Na EAP atual, respeita o tempo já transcorrido.
            if step == 0 and elapsed > 0:
                eligible = np.flatnonzero(durations > elapsed)

                if len(eligible) >= cfg.min_residual_samples:
                    idx = int(rng.choice(eligible))
                    duration = max(0.0, durations[idx] - elapsed)
                else:
                    # Fallback: amostra total e desconta aging já observado.
                    idx = int(rng.integers(0, len(durations)))
                    duration = max(0.0, durations[idx] - elapsed)
            else:
                idx = int(rng.integers(0, len(durations)))
                duration = max(0.0, durations[idx])

            total_days += duration
            current = normalize_eap(next_eaps[idx])

        if current in cfg.final_eaps:
            finished = True

        if finished:
            completion_days.append(total_days)
        else:
            unresolved += 1

    completion_days = np.asarray(completion_days, dtype=float)
    resolved = len(completion_days)
    resolution_rate = resolved / cfg.n_simulations

    deadline_days = max(
        0.0,
        (deadline.normalize() - as_of.normalize()).days
    )

    # Conservador: simulações não resolvidas contam como "não cumpriu".
    on_time_count = int(np.sum(completion_days <= deadline_days))
    prob_on_time = on_time_count / cfg.n_simulations
    prob_late = 1.0 - prob_on_time

    # Erro de Monte Carlo (não é erro do modelo)
    mc_se = math.sqrt(
        max(prob_on_time * (1 - prob_on_time), 0.0)
        / cfg.n_simulations
    )
    mc_margin_95_pp = 1.96 * mc_se * 100

    evidence_conf = model_confidence_score(
        support_n_works=start_pool.n_works,
        resolution_rate=resolution_rate,
        mc_margin_95_pp=mc_margin_95_pp,
        eap_consistent=bool(row.get("EAP_COMPARE_CONSISTENTE", False)),
    )

    reason1, reason2 = explain_risk(
        prob_on_time,
        evidence_conf,
        row.get("DIAS_STREAK_EAP_ATUAL"),
        start_pool,
    )

    result.update(
        {
            "PROB_CUMPRIR_CARIMBO": round(prob_on_time, 4),
            "PROB_ATRASAR": round(prob_late, 4),
            "DATA_P50": percentile_date(as_of, completion_days, 0.50),
            "DATA_P70": percentile_date(as_of, completion_days, 0.70),
            "DATA_P80": percentile_date(as_of, completion_days, 0.80),
            "DATA_P90": percentile_date(as_of, completion_days, 0.90),
            "RISCO": risk_class(prob_on_time),
            "MODEL_CONFIDENCE": evidence_conf,
            "CONFIDENCE_CLASS": confidence_class(evidence_conf),
            "MC_MARGIN_95_PP": round(mc_margin_95_pp, 2),
            "N_HISTORICO_COMPARAVEL": int(start_pool.n_works),
            "POOL_NIVEL": start_pool.level,
            "RESOLUTION_RATE": round(resolution_rate, 4),
            "PRINCIPAL_MOTIVO_RISCO": reason1,
            "SEGUNDO_MOTIVO_RISCO": reason2,
        }
    )

    return result


