def build_history_events_and_intervals(
    history: pd.DataFrame,
    history_time_col: str,
    cfg: ConfigV2 = CFG,
):
    h = history.copy()
    h["EAP_AUTOMATICA"] = h["EAP_AUTOMATICA"].map(normalize_eap)

    h = h[
        h["UID_IDPMTS"].notna()
        & h["EAP_AUTOMATICA"].notna()
        & h[history_time_col].notna()
    ].copy()

    h = (
        h.sort_values(["UID_IDPMTS", history_time_col])
        .drop_duplicates(
            subset=["UID_IDPMTS", history_time_col, "EAP_AUTOMATICA"],
            keep="last",
        )
    )

    h["PREV_EAP"] = h.groupby("UID_IDPMTS")["EAP_AUTOMATICA"].shift(1)

    events = h[
        h["PREV_EAP"].notna()
        & h["EAP_AUTOMATICA"].ne(h["PREV_EAP"])
    ].copy()

    events = events.rename(
        columns={
            "PREV_EAP": "DE",
            "EAP_AUTOMATICA": "EAP",
            history_time_col: "ENTRADA_EM",
        }
    )

    events["NEXT_DATA"] = events.groupby("UID_IDPMTS")["ENTRADA_EM"].shift(-1)
    events["NEXT_EAP"] = events.groupby("UID_IDPMTS")["EAP"].shift(-1)

    intervals = events.copy()
    intervals["SAIDA_EM"] = intervals["NEXT_DATA"]
    intervals["DURACAO_DIAS"] = (
        intervals["SAIDA_EM"] - intervals["ENTRADA_EM"]
    ).dt.total_seconds() / 86400.0

    cutoff = pd.Timestamp(cfg.compare_start_date)
    intervals = intervals[
        intervals["ENTRADA_EM"].lt(cutoff)
        & intervals["SAIDA_EM"].notna()
        & intervals["SAIDA_EM"].le(cutoff)
    ].copy()

    intervals["SOURCE"] = "PMTS_HISTORICO"
    intervals["CONTEXT_SOURCE"] = "SNAPSHOT_POINT_IN_TIME"
    intervals["CONTEXT_AGE_DAYS"] = 0.0

    keep = [
        "UID_IDPMTS", "DE", "EAP", "NEXT_EAP",
        "ENTRADA_EM", "SAIDA_EM", "DURACAO_DIAS",
        "SOURCE", "CONTEXT_SOURCE", "CONTEXT_AGE_DAYS",
    ] + [c for c in CONTEXT_COLUMNS if c in intervals.columns]

    history_events = events[
        ["UID_IDPMTS", "DE", "EAP", "ENTRADA_EM"]
    ].copy()
    history_events["SOURCE"] = "PMTS_HISTORICO"

    return history_events, intervals[keep].copy()


