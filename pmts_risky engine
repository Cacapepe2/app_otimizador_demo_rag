# Aging atual
# =============================================================================

def current_eap_entry_info_v2(
    scope: pd.DataFrame,
    history_events: pd.DataFrame,
    compare_events: pd.DataFrame,
    as_of: pd.Timestamp,
):
    events = pd.concat(
        [
            history_events[["UID_IDPMTS", "EAP", "ENTRADA_EM", "SOURCE"]],
            compare_events[["UID_IDPMTS", "EAP", "ENTRADA_EM", "SOURCE"]],
        ],
        ignore_index=True,
    )

    events["ENTRADA_EM"] = pd.to_datetime(events["ENTRADA_EM"], errors="coerce")
    events = events[events["ENTRADA_EM"].notna()].sort_values(
        ["UID_IDPMTS", "ENTRADA_EM"]
    )

    last = (
        events.groupby("UID_IDPMTS", as_index=False)
        .tail(1)
        .rename(
            columns={
                "EAP": "LAST_EVENT_EAP",
                "ENTRADA_EM": "EAP_ATUAL_ENTRADA_EM",
                "SOURCE": "EAP_ENTRY_SOURCE",
            }
        )
        [["UID_IDPMTS", "LAST_EVENT_EAP", "EAP_ATUAL_ENTRADA_EM", "EAP_ENTRY_SOURCE"]]
    )

    out = scope.merge(last, on="UID_IDPMTS", how="left")
    out["EAP_AUTOMATICA"] = out["EAP_AUTOMATICA"].map(normalize_eap)
    out["LAST_EVENT_EAP"] = out["LAST_EVENT_EAP"].map(normalize_eap)

    out["EAP_HISTORY_CONSISTENTE"] = (
        out["EAP_AUTOMATICA"] == out["LAST_EVENT_EAP"]
    )

    out["DIAS_STREAK_EAP_ATUAL"] = np.where(
        out["EAP_HISTORY_CONSISTENTE"]
        & out["EAP_ATUAL_ENTRADA_EM"].notna(),
        (
            as_of.normalize()
            - pd.to_datetime(out["EAP_ATUAL_ENTRADA_EM"]).dt.normalize()
        ).dt.days,
        np.nan,
    )

    return out


