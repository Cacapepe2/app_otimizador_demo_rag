# BACKTEST / CALIBRAÇÃO
# =============================================================================

def evaluate_probability_accuracy(
    backtest: pd.DataFrame,
    probability_col: str = "PROB_CUMPRIR_CARIMBO",
    actual_col: str = "CUMPRIU_CARIMBO_REAL",
) -> Tuple[pd.DataFrame, dict]:
    """
    Mede a acurácia probabilística DE VERDADE quando existir um backtest.

    Esperado:
    - probability_col: probabilidade prevista (0..1)
    - actual_col: 1 se cumpriu a tempo, 0 se atrasou

    Retorna:
    - tabela de calibração por faixa;
    - Brier Score.

    Exemplo de boa calibração:
    obras previstas em ~90% cumprem, na prática, ~90% das vezes.
    """
    df = backtest[[probability_col, actual_col]].dropna().copy()

    if df.empty:
        raise ValueError("Backtest vazio.")

    df[probability_col] = df[probability_col].astype(float)
    df[actual_col] = df[actual_col].astype(int)

    brier = float(
        np.mean((df[probability_col] - df[actual_col]) ** 2)
    )

    bins = np.linspace(0, 1, 11)
    labels = [
        f"{int(bins[i]*100):02d}-{int(bins[i+1]*100):02d}%"
        for i in range(len(bins) - 1)
    ]

    df["FAIXA_PROB"] = pd.cut(
        df[probability_col],
        bins=bins,
        labels=labels,
        include_lowest=True,
    )

    calibration = (
        df.groupby("FAIXA_PROB", observed=True)
        .agg(
            N=(actual_col, "size"),
            PROB_MEDIA=(probability_col, "mean"),
            TAXA_REAL=(actual_col, "mean"),
        )
        .reset_index()
    )

    calibration["ERRO_CALIBRACAO_PP"] = (
        (calibration["PROB_MEDIA"] - calibration["TAXA_REAL"]).abs() * 100
    )

    metrics = {
        "N_BACKTEST": int(len(df)),
        "BRIER_SCORE": round(brier, 4),
        "NOTA": (
            "Brier menor e melhor. Calibracao e mais importante que "
            "accuracy simples para uma previsao probabilistica."
        ),
    }

    return calibration, metrics


